import Mathlib
import AJHandoff.TorusInput.RJSpectral

/-!
# The spectral idempotents (node RA2.5)

`∑_N P_N = f_b^{⊗ r}`; `c^r P_N = μ_N P_N`; `c` commutes with `P_N`; `P_N` is idempotent; `P_N`
intertwines the weights.

Route. Generic Lagrange algebra in the commutative subalgebra generated by `c^r` and
`f_b^{⊗ r}` (they commute, `rjCycleMat_mul_colsProj`), as in `AJConjecture.SkeinChannelIdem`:
`Lagrange.sum_basis` (`∑ L_N = 1`), `(X - μ_N) L_N = w_N · nodal`, `L_N² ≡ L_N` modulo the nodal
polynomial, with `rj_colsProj_mul_aeval_nodal` and `rj_twistEigen_injOn`. `c` commutes with
`aeval (c^r) p` and with `f_b^{⊗ r}`. Weights: `skWeight_mul_braidMatrix`, `rjNat_colsProj`.
Estimate 120–170 lines.
-/

noncomputable section

namespace AJConjecture

/-- The top colour `b r` lies in the spectrum. -/
private theorem rj_mem_spec_top_isoProjProps (b r : ℕ) : b * r ∈ rjSpec b r :=
  Finset.mem_image.mpr ⟨0, Finset.mem_range.mpr (Nat.succ_pos _), Nat.sub_zero _⟩

open Polynomial in
/-- The Lagrange idempotents of an element `D` annihilated by the nodal polynomial are
eigenvectors of `D`. -/
private theorem rj_mul_aeval_basis_isoProjProps {A : Type*} [Ring A] [Algebra (RatFunc ℚ) A]
    (P D : A) (hPD : Commute P D) (s : Finset ℕ) (v : ℕ → RatFunc ℚ)
    (hrel : P * aeval D (Lagrange.nodal s v) = 0) (i : ℕ) (hi : i ∈ s) :
    D * (P * aeval D (Lagrange.basis s v i)) = v i • (P * aeval D (Lagrange.basis s v i)) := by
  have hpoly : X * Lagrange.basis s v i =
      C (v i) * Lagrange.basis s v i + C (Lagrange.nodalWeight s v i) * Lagrange.nodal s v := by
    rw [Lagrange.basis_eq_prod_sub_inv_mul_nodal_div hi, ← Lagrange.nodal_erase_eq_nodal_div hi,
      Lagrange.nodal_eq_mul_nodal_erase hi]
    ring
  have h1 : D * aeval D (Lagrange.basis s v i) = aeval D (X * Lagrange.basis s v i) := by
    rw [map_mul, aeval_X]
  rw [← mul_assoc, ← hPD.eq, mul_assoc, h1, hpoly, map_add, map_mul, map_mul, aeval_C, aeval_C,
    Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, smul_mul_assoc,
    smul_mul_assoc, one_mul, one_mul, mul_add, mul_smul_comm, mul_smul_comm, hrel, smul_zero,
    add_zero]

/-- The spectral idempotents sum to the column projectors. -/
theorem rj_sum_isoProj (b r : ℕ) : ∑ N ∈ rjSpec b r, rjIsoProj b r N = rjColsProj b r := by
  simp only [rjIsoProj]
  rw [← Finset.mul_sum, ← map_sum, Lagrange.sum_basis (rj_twistEigen_injOn b r)
    ⟨b * r, rj_mem_spec_top_isoProjProps b r⟩, map_one, mul_one]

/-- `c^r` acts on the isotypic part of colour `N` by `μ_N = θ_N/θ_b^r`. -/
theorem rj_cycleMat_pow_mul_isoProj (b r N : ℕ) (hr : 1 ≤ r) (hN : N ∈ rjSpec b r) :
    rjCycleMat b r ^ r * rjIsoProj b r N = rjTwistEigen b r N • rjIsoProj b r N :=
  rj_mul_aeval_basis_isoProjProps _ _ (Commute.pow_right (rjCycleMat_mul_colsProj b r).symm r)
    _ _ (rj_colsProj_mul_aeval_nodal b r hr) N hN

/-- The cyclic braid commutes with the spectral idempotents. -/
theorem rj_cycleMat_mul_isoProj (b r N : ℕ) :
    rjCycleMat b r * rjIsoProj b r N = rjIsoProj b r N * rjCycleMat b r := by
  rw [rjIsoProj, ← mul_assoc, rjCycleMat_mul_colsProj, mul_assoc,
    (rj_commute_aeval _ _ (Commute.self_pow (rjCycleMat b r) r) _).eq, mul_assoc]

/-- The spectral idempotents are idempotent. -/
theorem rj_isoProj_mul_self (b r N : ℕ) (hr : 1 ≤ r) (hN : N ∈ rjSpec b r) :
    rjIsoProj b r N * rjIsoProj b r N = rjIsoProj b r N := by
  conv_lhs => arg 1; rw [rjIsoProj]
  rw [mul_assoc, rj_aeval_mul_of_eigen _ _ _ (rj_cycleMat_pow_mul_isoProj b r N hr hN),
    Lagrange.eval_basis_self (rj_twistEigen_injOn b r) hN, one_smul, rj_colsProj_mul_isoProj]

/-- The spectral idempotents intertwine the weights. -/
theorem rj_skWeight_mul_isoProj (b r N : ℕ) :
    skWeight (b * r) * rjIsoProj b r N = rjIsoProj b r N * skWeight (b * r) := by
  have hc : Commute (skWeight (b * r)) (rjCycleMat b r ^ r) :=
    Commute.pow_right (skWeight_mul_braidMatrix _ _) r
  rw [rjIsoProj, ← mul_assoc, (rjNat_colsProj b r).1, mul_assoc,
    (rj_commute_aeval _ _ hc _).eq, mul_assoc]

end AJConjecture
