import Mathlib
import AJHandoff.PairDefs
import AJConjecture.KnotGroup
import AJConjecture.BraidRun
import AJHandoff.TorusKnot.PairKTorusGroup
import AJHandoff.TorusKnot.PairKCoprodNormalForm

/-!
# T-DIST (b), algebraic core: the torus knot group modulo its centre

`TorusKnotGroup r s = ⟨x, y | x^r = y^s⟩`. For an admissible pair its centre is generated by
`x^r` (`center_torusKnotGroup`) and the quotient is the free product `C_r * C_s`
(`torusKnotGroup_quot_center`). A finite-order element of `C_r * C_s` has order dividing `r` or
`s` (finite subgroups of a free product fix a vertex of its Bass–Serre tree; formally: a
cyclically reduced word of length `≥ 2` has infinite order, via the normal form
`Monoid.CoprodI.Word`), and elements of order `r` and `s` exist. Hence an isomorphism
`C_r * C_s ≃* C_r' * C_s'` between admissible pairs forces `(r, s) = (r', s')`
(`eq_of_mulEquiv_cycCoprod`). The Artin presentation of `T(r, s)` is identified with
`TorusKnotGroup r s` by `x ↦ (x_0 ⋯ x_(s-1))` (indices mod `r`), `y ↦ x_0 ⋯ x_(r-1)`
(`knotGroup_torusPairKnot_equiv`).
-/

namespace AJConjecture

/-- The free product `C_r * C_s` of two cyclic groups. -/
abbrev CycCoprod (r s : ℕ) : Type :=
  Monoid.Coprod (Multiplicative (ZMod r)) (Multiplicative (ZMod s))

/-- The relator `x^r y^(-s)` of the torus knot group. -/
def torusKnotRel (r s : ℕ) : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ r * (FreeGroup.of 1 ^ s)⁻¹}

/-- The torus knot group `⟨x, y | x^r = y^s⟩`. -/
abbrev TorusKnotGroup (r s : ℕ) : Type := PresentedGroup (torusKnotRel r s)

/-- A finite-order element of `C_r * C_s` has order dividing `r` or `s`. -/
theorem orderOf_dvd_of_isOfFinOrder_cycCoprod {r s : ℕ} (hr : 0 < r) (hs : 0 < s)
    {g : CycCoprod r s} (hg : IsOfFinOrder g) : orderOf g ∣ r ∨ orderOf g ∣ s :=
  orderOf_dvd_of_isOfFinOrder_coprodCyclic hr hs hg

/-- The generator of the first factor of `C_r * C_s` has order `r`. -/
private theorem orderOf_cycCoprod_inl {r : ℕ} (s : ℕ) :
    orderOf (Monoid.Coprod.inl (Multiplicative.ofAdd (1 : ZMod r)) : CycCoprod r s) = r := by
  rw [orderOf_injective _ Monoid.Coprod.inl_injective, orderOf_ofAdd_eq_addOrderOf,
    ZMod.addOrderOf_one]

/-- The generator of the second factor of `C_r * C_s` has order `s`. -/
private theorem orderOf_cycCoprod_inr (r : ℕ) {s : ℕ} :
    orderOf (Monoid.Coprod.inr (Multiplicative.ofAdd (1 : ZMod s)) : CycCoprod r s) = s := by
  rw [orderOf_injective _ Monoid.Coprod.inr_injective, orderOf_ofAdd_eq_addOrderOf,
    ZMod.addOrderOf_one]

/-- The free products of cyclic groups of two admissible pairs are isomorphic only for equal
pairs. -/
theorem eq_of_mulEquiv_cycCoprod {r s r' s' : ℕ} (h : IsTorusPair r s) (h' : IsTorusPair r' s')
    (e : CycCoprod r s ≃* CycCoprod r' s') : r = r' ∧ s = s' := by
  obtain ⟨hr, hrs, hcop⟩ := h
  obtain ⟨hr', hrs', hcop'⟩ := h'
  have hl := orderOf_cycCoprod_inl (r := r) s
  have hrr := orderOf_cycCoprod_inr r (s := s)
  have hl' := orderOf_cycCoprod_inl (r := r') s'
  have hrr' := orderOf_cycCoprod_inr r' (s := s')
  have key : ∀ {a b c d : ℕ} (f : CycCoprod a b ≃* CycCoprod c d) (g : CycCoprod a b),
      0 < c → 0 < d → 0 < orderOf g → orderOf g ∣ c ∨ orderOf g ∣ d := by
    intro a b c d f g hc hd hg
    rw [← MulEquiv.orderOf_eq f g]
    exact orderOf_dvd_of_isOfFinOrder_cycCoprod hc hd
      (orderOf_pos_iff.mp (by rwa [MulEquiv.orderOf_eq f g]))
  have h1 := key e _ (by omega) (by omega) (by rw [hrr]; omega)
  have h2 := key e.symm _ (by omega) (by omega) (by rw [hrr']; omega)
  have h3 := key e _ (by omega) (by omega) (by rw [hl]; omega)
  have h4 := key e.symm _ (by omega) (by omega) (by rw [hl']; omega)
  rw [hrr] at h1
  rw [hrr'] at h2
  rw [hl] at h3
  rw [hl'] at h4
  have hss : s = s' := by
    have e1 : s ≤ s' := by
      rcases h1 with h1 | h1
      · exact (Nat.le_of_dvd (by omega) h1).trans hrs'.le
      · exact Nat.le_of_dvd (by omega) h1
    have e2 : s' ≤ s := by
      rcases h2 with h2 | h2
      · exact (Nat.le_of_dvd (by omega) h2).trans hrs.le
      · exact Nat.le_of_dvd (by omega) h2
    omega
  subst hss
  have hndvd : ∀ {a b : ℕ}, 2 ≤ a → Nat.Coprime a b → ¬ a ∣ b := by
    intro a b ha hab hdvd
    have := Nat.Coprime.eq_one_of_dvd hab hdvd
    omega
  have e3 : r ∣ r' := h3.resolve_right (hndvd hr hcop)
  have e4 : r' ∣ r := h4.resolve_right (hndvd hr' hcop')
  exact ⟨Nat.dvd_antisymm e3 e4, rfl⟩

/-- The generator `x` of the torus knot group. -/
private abbrev torusGenX (r s : ℕ) : TorusKnotGroup r s := PresentedGroup.of 0

/-- The generator `y` of the torus knot group. -/
private abbrev torusGenY (r s : ℕ) : TorusKnotGroup r s := PresentedGroup.of 1

/-- The defining relation `x^r = y^s`. -/
private theorem torusGenX_pow_eq (r s : ℕ) : torusGenX r s ^ r = torusGenY r s ^ s := by
  have hmem : FreeGroup.of (0 : Fin 2) ^ r * (FreeGroup.of 1 ^ s)⁻¹ ∈ torusKnotRel r s := rfl
  have h := PresentedGroup.one_of_mem hmem
  rw [map_mul, map_inv, map_pow, map_pow, mul_inv_eq_one] at h
  exact h

/-- `x^r` is central. -/
private theorem torusGenX_pow_mem_center (r s : ℕ) :
    torusGenX r s ^ r ∈ Subgroup.center (TorusKnotGroup r s) := by
  rw [Subgroup.mem_center_iff]
  intro g
  have hmem : g ∈ Subgroup.centralizer {torusGenX r s ^ r} := by
    refine PresentedGroup.generated_by _ _ (fun j ↦ ?_) g
    rw [Subgroup.mem_centralizer_iff]
    rintro _ rfl
    fin_cases j
    · exact (Commute.self_pow _ r).symm.eq
    · change torusGenX r s ^ r * torusGenY r s = torusGenY r s * torusGenX r s ^ r
      rw [torusGenX_pow_eq]
      exact (Commute.self_pow _ s).symm.eq
  rw [Subgroup.mem_centralizer_iff] at hmem
  exact (hmem _ rfl).symm

/-- The subgroup generated by `x^r`. -/
private abbrev torusPowSubgroup (r s : ℕ) : Subgroup (TorusKnotGroup r s) :=
  Subgroup.zpowers (torusGenX r s ^ r)

private theorem torusPowSubgroup_le_center (r s : ℕ) :
    torusPowSubgroup r s ≤ Subgroup.center (TorusKnotGroup r s) :=
  (Subgroup.zpowers_le).mpr (torusGenX_pow_mem_center r s)

private instance torusPowSubgroup_normal (r s : ℕ) : (torusPowSubgroup r s).Normal :=
  ⟨fun n hn g ↦ by
    have := Subgroup.mem_center_iff.mp (torusPowSubgroup_le_center r s hn) g
    rw [this, mul_inv_cancel_right]
    exact hn⟩

/-- The homomorphism `Multiplicative (ZMod n) → H` sending the generator to `g`, `g^n = 1`. -/
private def cycLift {H : Type*} [Group H] (n : ℕ) (g : H) (hg : g ^ n = 1) :
    Multiplicative (ZMod n) →* H :=
  AddMonoidHom.toMultiplicativeLeft (ZMod.lift n ⟨zmultiplesHom (Additive H) (Additive.ofMul g),
    by simp only [zmultiplesHom_apply, natCast_zsmul, ← ofMul_pow, hg, ofMul_one]⟩)

private theorem cycLift_ofAdd_one {H : Type*} [Group H] (n : ℕ) (g : H) (hg : g ^ n = 1) :
    cycLift n g hg (Multiplicative.ofAdd 1) = g := by
  have h1 : (1 : ZMod n) = ((1 : ℤ) : ZMod n) := Int.cast_one.symm
  simp only [cycLift, AddMonoidHom.coe_toMultiplicativeLeft, Function.comp_apply, toAdd_ofAdd]
  rw [h1, ZMod.lift_coe]
  simp

/-- Homomorphisms from `Multiplicative (ZMod n)` agreeing on the generator are equal. -/
private theorem cycHom_ext {H : Type*} [Group H] {n : ℕ} [NeZero n]
    {f g : Multiplicative (ZMod n) →* H}
    (h : f (Multiplicative.ofAdd 1) = g (Multiplicative.ofAdd 1)) : f = g := by
  refine MonoidHom.ext fun z ↦ ?_
  have hz : z = Multiplicative.ofAdd 1 ^ ZMod.val (Multiplicative.toAdd z) := by
    rw [← ofAdd_nsmul, nsmul_one, ZMod.natCast_zmod_val, ofAdd_toAdd]
  rw [hz, map_pow, map_pow, h]

/-- The generator of `C_n`. -/
private abbrev cycGen (n : ℕ) : Multiplicative (ZMod n) := Multiplicative.ofAdd 1

private theorem cycGen_pow_self (n : ℕ) : cycGen n ^ n = 1 := by
  rw [cycGen, ← ofAdd_nsmul, nsmul_one, ZMod.natCast_self, ofAdd_zero]

/-- The projection of the torus knot group onto `C_r * C_s`. -/
private def torusToCoprod (r s : ℕ) : TorusKnotGroup r s →* CycCoprod r s :=
  PresentedGroup.toGroup (f := ![Monoid.Coprod.inl (cycGen r), Monoid.Coprod.inr (cycGen s)])
    (by
      rintro _ rfl
      rw [map_mul, map_inv, map_pow, map_pow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, ← map_pow,
        cycGen_pow_self, map_one, inv_one, mul_one])

private theorem torusToCoprod_x (r s : ℕ) :
    torusToCoprod r s (torusGenX r s) = Monoid.Coprod.inl (cycGen r) :=
  PresentedGroup.toGroup.of _

private theorem torusToCoprod_y (r s : ℕ) :
    torusToCoprod r s (torusGenY r s) = Monoid.Coprod.inr (cycGen s) :=
  PresentedGroup.toGroup.of _

private theorem torusPowSubgroup_le_ker (r s : ℕ) :
    torusPowSubgroup r s ≤ (torusToCoprod r s).ker := by
  rw [Subgroup.zpowers_le, MonoidHom.mem_ker, map_pow, torusToCoprod_x, ← map_pow,
    cycGen_pow_self, map_one]

/-- The induced map on the quotient by `⟨x^r⟩`. -/
private def torusQuotToCoprod (r s : ℕ) :
    TorusKnotGroup r s ⧸ torusPowSubgroup r s →* CycCoprod r s :=
  QuotientGroup.lift _ (torusToCoprod r s) (torusPowSubgroup_le_ker r s)

/-- The inverse map `C_r * C_s → G ⧸ ⟨x^r⟩`. -/
private def coprodToTorusQuot (r s : ℕ) :
    CycCoprod r s →* TorusKnotGroup r s ⧸ torusPowSubgroup r s :=
  Monoid.Coprod.lift
    (cycLift r (QuotientGroup.mk (torusGenX r s)) (by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
      exact Subgroup.mem_zpowers _))
    (cycLift s (QuotientGroup.mk (torusGenY r s)) (by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, ← torusGenX_pow_eq]
      exact Subgroup.mem_zpowers _))

/-- `G ⧸ ⟨x^r⟩ ≃* C_r * C_s`. -/
private def torusQuotEquiv {r s : ℕ} (hr : 0 < r) (hs : 0 < s) :
    TorusKnotGroup r s ⧸ torusPowSubgroup r s ≃* CycCoprod r s := by
  haveI : NeZero r := ⟨by omega⟩
  haveI : NeZero s := ⟨by omega⟩
  refine MonoidHom.toMulEquiv (torusQuotToCoprod r s) (coprodToTorusQuot r s) ?_ ?_
  · refine QuotientGroup.monoidHom_ext _ (PresentedGroup.ext fun j ↦ ?_)
    fin_cases j
    · change coprodToTorusQuot r s (torusQuotToCoprod r s (QuotientGroup.mk (torusGenX r s))) =
        QuotientGroup.mk (torusGenX r s)
      rw [torusQuotToCoprod, QuotientGroup.lift_mk, torusToCoprod_x, coprodToTorusQuot,
        Monoid.Coprod.lift_apply_inl, cycLift_ofAdd_one]
    · change coprodToTorusQuot r s (torusQuotToCoprod r s (QuotientGroup.mk (torusGenY r s))) =
        QuotientGroup.mk (torusGenY r s)
      rw [torusQuotToCoprod, QuotientGroup.lift_mk, torusToCoprod_y, coprodToTorusQuot,
        Monoid.Coprod.lift_apply_inr, cycLift_ofAdd_one]
  · refine Monoid.Coprod.hom_ext (cycHom_ext ?_) (cycHom_ext ?_)
    · simp only [MonoidHom.comp_apply, coprodToTorusQuot, Monoid.Coprod.lift_apply_inl,
        cycLift_ofAdd_one, torusQuotToCoprod, QuotientGroup.lift_mk, torusToCoprod_x,
        MonoidHom.id_apply]
    · simp only [MonoidHom.comp_apply, coprodToTorusQuot, Monoid.Coprod.lift_apply_inr,
        cycLift_ofAdd_one, torusQuotToCoprod, QuotientGroup.lift_mk, torusToCoprod_y,
        MonoidHom.id_apply]

/-- The kernel of the projection onto `C_r * C_s` is `⟨x^r⟩`. -/
private theorem ker_torusToCoprod_le {r s : ℕ} (hr : 0 < r) (hs : 0 < s) :
    (torusToCoprod r s).ker ≤ torusPowSubgroup r s := by
  intro g hg
  rw [MonoidHom.mem_ker] at hg
  rw [← QuotientGroup.eq_one_iff]
  have h1 : torusQuotEquiv hr hs (QuotientGroup.mk g) = 1 := hg
  rwa [MulEquiv.map_eq_one_iff] at h1

/-- The free product of two nontrivial cyclic groups has trivial centre. -/
private theorem center_cycCoprod_eq_bot {r s : ℕ} (hr : 2 ≤ r) (hs : 2 ≤ s) :
    Subgroup.center (CycCoprod r s) = ⊥ :=
  center_coprodCyclic_eq_bot hr hs

/-- The centre of the torus knot group is generated by `x^r`. -/
theorem center_torusKnotGroup {r s : ℕ} (h : IsTorusPair r s) :
    Subgroup.center (TorusKnotGroup r s) =
      Subgroup.zpowers ((PresentedGroup.of 0 : TorusKnotGroup r s) ^ r) := by
  obtain ⟨hr, hrs, -⟩ := h
  refine le_antisymm (fun g hg ↦ ?_) (torusPowSubgroup_le_center r s)
  apply ker_torusToCoprod_le (by omega) (by omega)
  have hsurj : Function.Surjective (torusToCoprod r s) := by
    intro c
    obtain ⟨q, rfl⟩ := (torusQuotEquiv (r := r) (s := s) (by omega) (by omega)).surjective c
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    exact ⟨g, rfl⟩
  have hc : torusToCoprod r s g ∈ Subgroup.center (CycCoprod r s) :=
    Subgroup.map_center_le_center hsurj ⟨g, hg, rfl⟩
  rw [center_cycCoprod_eq_bot (by omega) (by omega), Subgroup.mem_bot] at hc
  exact hc

/-- The torus knot group modulo its centre is `C_r * C_s`. -/
theorem torusKnotGroup_quot_center {r s : ℕ} (h : IsTorusPair r s) :
    Nonempty (TorusKnotGroup r s ⧸ Subgroup.center (TorusKnotGroup r s) ≃* CycCoprod r s) := by
  have hr : 0 < r := by have := h.1; omega
  have hs : 0 < s := by have := h.1; have := h.2.1; omega
  exact ⟨(QuotientGroup.quotientMulEquivOfEq (center_torusKnotGroup h)).trans
    (torusQuotEquiv hr hs)⟩

/-! ### Artin's presentation of `T(r, s)` -/

section ArtinTorus

variable {G : Type*} [Group G]

/-- The cyclic product `f_0 f_1 ⋯ f_(n-1)`, indices modulo `r`. -/
private def cycProd {r : ℕ} (hr : 0 < r) (f : Fin r → G) (n : ℕ) : G :=
  ((List.range n).map fun t ↦ f ⟨t % r, Nat.mod_lt _ hr⟩).prod

private theorem cycProd_add {r : ℕ} (hr : 0 < r) (f : Fin r → G) (a b : ℕ) :
    cycProd hr f (a + b) =
      cycProd hr f a * ((List.range b).map fun t ↦ f ⟨(a + t) % r, Nat.mod_lt _ hr⟩).prod := by
  simp only [cycProd, List.range_add, List.map_append, List.prod_append, List.map_map,
    Function.comp_def]

private theorem cycProd_succ {r : ℕ} (hr : 0 < r) (f : Fin r → G) (n : ℕ) :
    cycProd hr f (n + 1) = cycProd hr f n * f ⟨n % r, Nat.mod_lt _ hr⟩ := by
  simp only [cycProd, List.range_succ, List.map_append, List.map_singleton, List.prod_append,
    List.prod_singleton]

private theorem cycProd_map {r : ℕ} (hr : 0 < r) {H : Type*} [Group H] (φ : G →* H)
    (f : Fin r → G) (n : ℕ) : φ (cycProd hr f n) = cycProd hr (fun k ↦ φ (f k)) n := by
  simp only [cycProd, map_list_prod, List.map_map, Function.comp_def]

/-- The product of `n` conjugates of the entries by a fixed element. -/
private theorem prod_map_conj {α : Type*} (g : G) (F : α → G) (l : List α) :
    (l.map fun x ↦ g⁻¹ * F x * g).prod = g⁻¹ * (l.map F).prod * g := by
  induction l with
  | nil => simp
  | cons x l ih =>
    rw [List.map_cons, List.prod_cons, ih, List.map_cons, List.prod_cons]
    group

/-- Conjugating by `a * z` with `z` central is conjugating by `a`. -/
private theorem conj_mul_central {a b z : G} (hz : z ∈ Subgroup.center G) :
    (a * z)⁻¹ * b * (a * z) = a⁻¹ * b * a := by
  have := Subgroup.mem_center_iff.mp hz
  calc (a * z)⁻¹ * b * (a * z) = z⁻¹ * (a⁻¹ * b * a * z) := by group
    _ = z⁻¹ * (z * (a⁻¹ * b * a)) := by rw [this]
    _ = a⁻¹ * b * a := by group

end ArtinTorus

section ArtinTorusKnot

/-- The generators of Artin's presentation of `T(r, s)`. -/
private abbrev artinX {r s : ℕ} (h : IsTorusPair r s) (k : Fin r) :
    KnotGroup (torusPairKnot r s h) :=
  PresentedGroup.of k

private theorem torusPair_pos {r s : ℕ} (h : IsTorusPair r s) : 0 < r := by have := h.1; omega

/-- The tuple of the generators is fixed by the braid. -/
private theorem artinX_fixed {r s : ℕ} (h : IsTorusPair r s) (k : Fin r) :
    cycProd (torusPair_pos h) (artinX h) s * artinX h ⟨((k : ℕ) + s) % r, Nat.mod_lt _
      (torusPair_pos h)⟩ * (cycProd (torusPair_pos h) (artinX h) s)⁻¹ = artinX h k := by
  have hfix : (braidRun r (torusPairWord r s) (artinX h)).1 = artinX h :=
    braidRun_fst_of_hom (torusPairKnot r s h) (MonoidHom.id _)
  have := congrFun hfix k
  rwa [braidRun_torusPairWord_fst (torusPair_pos h)] at this

/-- `τ = x_0 ⋯ x_(s-1)` shifts the generators: `τ⁻ʲ x_i τʲ = x_(i + js)`. -/
private theorem artinX_conj_pow {r s : ℕ} (h : IsTorusPair r s) (j i : ℕ) :
    (cycProd (torusPair_pos h) (artinX h) s ^ j)⁻¹ *
        artinX h ⟨i % r, Nat.mod_lt _ (torusPair_pos h)⟩ *
        cycProd (torusPair_pos h) (artinX h) s ^ j =
      artinX h ⟨(i + j * s) % r, Nat.mod_lt _ (torusPair_pos h)⟩ := by
  induction j with
  | zero => simp
  | succ j ih =>
    have h1 := artinX_fixed h ⟨(i + j * s) % r, Nat.mod_lt _ (torusPair_pos h)⟩
    simp only [Nat.mod_add_mod] at h1
    have h2 : artinX h ⟨(i + j * s + s) % r, Nat.mod_lt _ (torusPair_pos h)⟩ =
        (cycProd (torusPair_pos h) (artinX h) s)⁻¹ *
          artinX h ⟨(i + j * s) % r, Nat.mod_lt _ (torusPair_pos h)⟩ *
          cycProd (torusPair_pos h) (artinX h) s := by
      rw [← h1]
      group
    simp only [show i + (j + 1) * s = i + j * s + s by ring]
    rw [h2, ← ih, pow_succ]
    group

private theorem cycProd_artinX_mul_s {r s : ℕ} (h : IsTorusPair r s) (j : ℕ) :
    cycProd (torusPair_pos h) (artinX h) (j * s) = cycProd (torusPair_pos h) (artinX h) s ^ j := by
  induction j with
  | zero => simp [cycProd]
  | succ j ih =>
    rw [Nat.succ_mul, cycProd_add, ih]
    have e : ((List.range s).map fun t ↦ artinX h ⟨(j * s + t) % r, Nat.mod_lt _
        (torusPair_pos h)⟩) = (List.range s).map fun t ↦
        (cycProd (torusPair_pos h) (artinX h) s ^ j)⁻¹ *
          artinX h ⟨t % r, Nat.mod_lt _ (torusPair_pos h)⟩ *
          cycProd (torusPair_pos h) (artinX h) s ^ j := by
      refine List.map_congr_left fun t _ ↦ ?_
      rw [artinX_conj_pow, Nat.add_comm]
    rw [e, prod_map_conj]
    change _ * (_ * cycProd (torusPair_pos h) (artinX h) s * _) = _
    rw [pow_succ]
    group

private theorem cycProd_eq_finRange {G : Type*} [Group G] {r : ℕ} (hr : 0 < r)
    (F : Fin r → G) : cycProd hr F r = ((List.finRange r).map F).prod := by
  unfold cycProd
  congr 1
  refine List.ext_get (by simp) fun i h1 h2 ↦ ?_
  simp only [List.get_eq_getElem, List.getElem_map, List.getElem_range, List.getElem_finRange]
  congr 1
  simp only [List.length_map, List.length_range] at h1
  exact Fin.ext (by simp [Nat.mod_eq_of_lt h1])

private theorem cycProd_artinX_self {r s : ℕ} (h : IsTorusPair r s) :
    cycProd (torusPair_pos h) (artinX h) r = torusFullProd h :=
  cycProd_eq_finRange (torusPair_pos h) (artinX h)

private theorem cycProd_artinX_mul_r {r s : ℕ} (h : IsTorusPair r s) (j : ℕ) :
    cycProd (torusPair_pos h) (artinX h) (j * r) = torusFullProd h ^ j := by
  induction j with
  | zero => simp [cycProd]
  | succ j ih =>
    rw [Nat.succ_mul, cycProd_add, ih, pow_succ, ← cycProd_artinX_self h]
    congr 1
    unfold cycProd
    congr 1
    refine List.map_congr_left fun t _ ↦ ?_
    have e : (j * r + t) % r = t % r := by rw [Nat.add_comm, Nat.add_mul_mod_self_right]
    simp only [e]

end ArtinTorusKnot

/-- The braid relations hold for a tuple fixed by the braid. -/
private theorem lift_artinRels_of_fixed {G : Type*} [Group G] (K : BraidKnot)
    (f : Fin K.strands → G) (hf : (braidRun K.strands K.word f).1 = f) :
    ∀ x ∈ artinRels K, FreeGroup.lift f x = 1 := by
  rintro _ ⟨k, rfl⟩
  rw [map_mul, map_inv, FreeGroup.lift_apply_of, map_mul, map_mul, map_inv,
    FreeGroup.lift_apply_of, inv_mul_eq_one, lift_artinWord_snd, ← braidRun_fst_apply, hf]

section TorusSide

variable {r s : ℕ}

/-- The image `m = y^(-d) x^c` of the meridian. -/
private abbrev torusMer (r s c d : ℕ) : TorusKnotGroup r s :=
  torusGenY r s ^ (-(d : ℤ)) * torusGenX r s ^ (c : ℤ)

/-- The images `x^(-kc) m x^(kc)` of the Artin generators. -/
private abbrev torusArtinTuple (r s c d : ℕ) (k : Fin r) : TorusKnotGroup r s :=
  torusGenX r s ^ (-((k : ℤ) * c)) * torusMer r s c d * torusGenX r s ^ ((k : ℤ) * c)

private theorem torusArtinTuple_mod (hr : 0 < r) (c d t : ℕ) :
    torusArtinTuple r s c d ⟨t % r, Nat.mod_lt _ hr⟩ =
      torusGenX r s ^ (-((t : ℤ) * c)) * torusMer r s c d * torusGenX r s ^ ((t : ℤ) * c) := by
  have hz : (torusGenX r s ^ r) ^ (((t / r : ℕ) : ℤ) * c) ∈ Subgroup.center _ :=
    Subgroup.zpow_mem _ (torusGenX_pow_mem_center r s) _
  have e : torusGenX r s ^ ((t : ℤ) * c) =
      torusGenX r s ^ (((t % r : ℕ) : ℤ) * c) * (torusGenX r s ^ r) ^ (((t / r : ℕ) : ℤ) * c) := by
    rw [← zpow_natCast (torusGenX r s) r, ← zpow_mul, ← zpow_add]
    congr 1
    have h1 : ((t % r : ℕ) : ℤ) + (r : ℤ) * ((t / r : ℕ) : ℤ) = (t : ℤ) := by
      exact_mod_cast Nat.mod_add_div t r
    linear_combination (-(c : ℤ)) * h1
  rw [zpow_neg, e, conj_mul_central hz, ← zpow_neg]

private theorem cycProd_torusArtinTuple (hr : 0 < r) (c d n : ℕ) :
    cycProd hr (torusArtinTuple r s c d) n =
      torusGenY r s ^ (-((d : ℤ) * n)) * torusGenX r s ^ ((n : ℤ) * c) := by
  induction n with
  | zero => simp [cycProd]
  | succ n ih =>
    rw [cycProd_succ, ih, torusArtinTuple_mod hr]
    push_cast
    group

private theorem cycProd_torusArtinTuple_s (hr : 0 < r) {c d : ℕ} (hcd : c * s = d * r + 1) :
    cycProd hr (torusArtinTuple r s c d) s = torusGenX r s := by
  rw [cycProd_torusArtinTuple, show -((d : ℤ) * s) = (s : ℤ) * (-(d : ℤ)) by ring, zpow_mul,
    zpow_natCast, ← torusGenX_pow_eq, ← zpow_natCast (torusGenX r s) r, ← zpow_mul, ← zpow_add]
  conv_rhs => rw [← zpow_one (torusGenX r s)]
  congr 1
  have h1 : (c : ℤ) * s = d * r + 1 := by exact_mod_cast hcd
  linear_combination h1

private theorem cycProd_torusArtinTuple_r (hr : 0 < r) {c d : ℕ} (hcd : c * s = d * r + 1) :
    cycProd hr (torusArtinTuple r s c d) r = torusGenY r s := by
  rw [cycProd_torusArtinTuple, zpow_mul, zpow_natCast (torusGenX r s) r, torusGenX_pow_eq,
    ← zpow_natCast (torusGenY r s) s, ← zpow_mul, ← zpow_add]
  conv_rhs => rw [← zpow_one (torusGenY r s)]
  congr 1
  have h1 : (c : ℤ) * s = d * r + 1 := by exact_mod_cast hcd
  linear_combination h1

private theorem torusArtinTuple_fixed (hr : 0 < r) {c d : ℕ} (hcd : c * s = d * r + 1)
    (k : Fin r) :
    cycProd hr (torusArtinTuple r s c d) s *
        torusArtinTuple r s c d ⟨((k : ℕ) + s) % r, Nat.mod_lt _ hr⟩ *
        (cycProd hr (torusArtinTuple r s c d) s)⁻¹ = torusArtinTuple r s c d k := by
  rw [cycProd_torusArtinTuple_s hr hcd, torusArtinTuple_mod hr]
  have hz : (torusGenX r s ^ r) ^ (d : ℤ) ∈ Subgroup.center _ :=
    Subgroup.zpow_mem _ (torusGenX_pow_mem_center r s) _
  have e : torusGenX r s ^ ((((k : ℕ) + s : ℕ) : ℤ) * c) * (torusGenX r s)⁻¹ =
      torusGenX r s ^ ((k : ℤ) * c) * (torusGenX r s ^ r) ^ (d : ℤ) := by
    rw [← zpow_natCast (torusGenX r s) r, ← zpow_mul, ← zpow_neg_one, ← zpow_add, ← zpow_add]
    congr 1
    have h1 : (c : ℤ) * s = d * r + 1 := by exact_mod_cast hcd
    push_cast
    linear_combination h1
  have e2 : torusGenX r s * (torusGenX r s ^ (-((((k : ℕ) + s : ℕ) : ℤ) * c)) *
      torusMer r s c d * torusGenX r s ^ ((((k : ℕ) + s : ℕ) : ℤ) * c)) * (torusGenX r s)⁻¹ =
      (torusGenX r s ^ ((((k : ℕ) + s : ℕ) : ℤ) * c) * (torusGenX r s)⁻¹)⁻¹ *
        torusMer r s c d * (torusGenX r s ^ ((((k : ℕ) + s : ℕ) : ℤ) * c) *
          (torusGenX r s)⁻¹) := by
    group
  rw [e2, e, conj_mul_central hz, ← zpow_neg]

end TorusSide

/-- The isomorphism between Artin's presentation of `T(r, s)` and `⟨x, y | x^r = y^s⟩`, for
`cs = dr + 1`. -/
private noncomputable def torusArtinEquiv {r s : ℕ} (h : IsTorusPair r s) {c d : ℕ}
    (hcd : c * s = d * r + 1) : KnotGroup (torusPairKnot r s h) ≃* TorusKnotGroup r s := by
  have hr := torusPair_pos h
  let τ := cycProd hr (artinX h) s
  let ψ : KnotGroup (torusPairKnot r s h) →* TorusKnotGroup r s :=
    PresentedGroup.toGroup (f := torusArtinTuple r s c d)
      (lift_artinRels_of_fixed (torusPairKnot r s h) (torusArtinTuple r s c d) (funext fun k ↦
        (braidRun_torusPairWord_fst hr s (torusArtinTuple r s c d) k).trans
          (torusArtinTuple_fixed hr hcd k)))
  have hrel : τ ^ r = torusFullProd h ^ s := by
    rw [← cycProd_artinX_mul_s h r, ← cycProd_artinX_mul_r h s, Nat.mul_comm]
  let φ : TorusKnotGroup r s →* KnotGroup (torusPairKnot r s h) :=
    PresentedGroup.toGroup (f := ![τ, torusFullProd h]) (by
      rintro _ rfl
      rw [map_mul, map_inv, map_pow, map_pow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [hrel, mul_inv_cancel])
  have hψ : ∀ k, ψ (PresentedGroup.of k) = torusArtinTuple r s c d k := fun k ↦
    PresentedGroup.toGroup.of _
  have hφx : φ (torusGenX r s) = τ := PresentedGroup.toGroup.of _
  have hφy : φ (torusGenY r s) = torusFullProd h := PresentedGroup.toGroup.of _
  have hmer : torusFullProd h ^ (-(d : ℤ)) * τ ^ (c : ℤ) =
      artinX h ⟨0 % r, Nat.mod_lt _ hr⟩ := by
    have e1 : τ ^ c = torusFullProd h ^ d * artinX h ⟨0 % r, Nat.mod_lt _ hr⟩ := by
      rw [← cycProd_artinX_mul_s h c, hcd, cycProd_succ, cycProd_artinX_mul_r h d]
      simp only [Nat.mul_mod_left, Nat.zero_mod]
    rw [zpow_natCast, e1, zpow_neg, zpow_natCast, inv_mul_cancel_left]
  refine MonoidHom.toMulEquiv ψ φ (PresentedGroup.ext fun k ↦ ?_)
    (PresentedGroup.ext fun j ↦ ?_)
  · rw [MonoidHom.comp_apply, hψ, MonoidHom.id_apply]
    simp only [torusArtinTuple, torusMer, map_mul, map_zpow, hφx, hφy]
    rw [hmer, show (k : ℤ) * c = ((k * c : ℕ) : ℤ) by push_cast; ring, zpow_neg, zpow_natCast,
      artinX_conj_pow h]
    congr 1
    apply Fin.ext
    simp only [Nat.zero_add]
    rw [Nat.mul_assoc, hcd, Nat.mul_add, Nat.mul_one, ← Nat.mul_assoc, Nat.mul_add_mod_self_right]
    exact Nat.mod_eq_of_lt k.isLt
  · have hψ' : (fun k ↦ ψ (artinX h k)) = torusArtinTuple r s c d := funext hψ
    rw [MonoidHom.comp_apply, MonoidHom.id_apply]
    fin_cases j
    · change ψ (φ (torusGenX r s)) = torusGenX r s
      rw [hφx, cycProd_map hr ψ, hψ', cycProd_torusArtinTuple_s hr hcd]
    · change ψ (φ (torusGenY r s)) = torusGenY r s
      rw [hφy, ← cycProd_artinX_self h, cycProd_map hr ψ, hψ']
      exact cycProd_torusArtinTuple_r hr hcd

/-- Artin's presentation of `T(r, s)` is the torus knot group. -/
theorem knotGroup_torusPairKnot_equiv {r s : ℕ} (h : IsTorusPair r s) :
    Nonempty (KnotGroup (torusPairKnot r s h) ≃* TorusKnotGroup r s) := by
  obtain ⟨c, -, hc⟩ := Nat.exists_mul_mod_eq_one_of_coprime h.2.2.symm
    (by have := h.1; omega)
  have hcd : c * s = (s * c / r) * r + 1 := by
    have := Nat.div_add_mod (s * c) r
    rw [hc] at this
    linarith [Nat.mul_comm s c, Nat.mul_comm r (s * c / r)]
  exact ⟨torusArtinEquiv h hcd⟩

end AJConjecture
