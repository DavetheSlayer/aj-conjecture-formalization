import Mathlib
import AJConjecture.SkeinPtrTailCyclic
import AJConjecture.SkeinPtrTailPlace
import AJConjecture.SkeinThickCupAdd
import AJConjecture.SkeinThickCup
import AJConjecture.SkeinZigzag
import AJConjecture.SkeinTlGenPlace
import AJConjecture.SkeinJwBasic
import AJConjecture.SkeinLongKnotJw
import AJConjecture.SkeinBraidMatrixBasic

/-!
# The long knot acts on the Jones–Wenzl projector by a scalar

The Temperley–Lieb subalgebra `TL_n` of the operators on `n` strands is generated by the
`tlGenF n j`. Braid matrices lie in it (a crossing is `a + b e_i`), and the partial trace over
the last strand maps `TL_{p+1}` into `TL_p`: by the basic construction, `TL_{p+1}` lies in the
span of the `ι(a)` and `ι(a) e_p ι(b)` with `a, b ∈ TL_p` (here `ι` adds a strand on the right),
because `e_p ι(b) e_p = ι(ι(ptr b)) e_p`; and `ptr(ι a) = δ a`, `ptr(ι(a) e_p ι(b)) = a b`. Hence
the long knot lies in `TL_k`. Since `f_k e_j = 0`, `f_k x` is a multiple of `f_k` for `x ∈ TL_k`;
as the long knot commutes with `f_k`, it acts on `f_k` by a scalar, which is read off at the
highest-weight state `(false, …, false)`, where `f_k` is the identity column.
-/

noncomputable section

namespace AJConjecture

/-- The Temperley–Lieb subalgebra of the operators on `n` strands. -/
def tlSubalgebra (n : ℕ) : Subalgebra (RatFunc ℚ) (SkMat n n) :=
  Algebra.adjoin (RatFunc ℚ) (Set.range (tlGenF n))

/-- The generators lie in the Temperley–Lieb subalgebra. -/
theorem tlGenF_mem_tlSubalgebra (n j : ℕ) : tlGenF n j ∈ tlSubalgebra n :=
  Algebra.subset_adjoin ⟨j, rfl⟩

/-- Every operator on no strands is a scalar, hence in the Temperley–Lieb subalgebra. -/
theorem mem_tlSubalgebra_zero (x : SkMat 0 0) : x ∈ tlSubalgebra 0 := by
  have hx : x = x default default • (1 : SkMat 0 0) := by
    ext a b
    rw [Subsingleton.elim a default, Subsingleton.elim b default]
    simp
  rw [hx]
  exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) _

/-- The placement of the zero matrix is zero. -/
theorem skPlace_zero_matrix_tl (n n' i : ℕ) {k l : ℕ} :
    skPlace n n' i (0 : SkMat k l) = 0 := by
  ext a b
  simp [skPlace]

/-- A generator on the first `m` of `n` strands is a generator on `n` strands (or zero). -/
theorem skPlace_tlGenF_tl (n m j : ℕ) (hmn : m ≤ n) (hj : j + 1 < m) :
    skPlace n n 0 (tlGenF m j) = tlGenF n j := by
  rw [tlGenF_eq_skPlace m j, skPlace_skPlace n n 0 j (tlGenF 2 0) (by omega) (by omega)
    (by omega) (by omega), Nat.zero_add, ← tlGenF_eq_skPlace]

/-- Placing a Temperley–Lieb element on the first strands gives a Temperley–Lieb element. -/
theorem skPlace_mem_tlSubalgebra (m n : ℕ) (hmn : m ≤ n) {x : SkMat m m}
    (hx : x ∈ tlSubalgebra m) : skPlace n n 0 x ∈ tlSubalgebra n := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    by_cases hj : j + 1 < m
    · rw [skPlace_tlGenF_tl n m j hmn hj]
      exact tlGenF_mem_tlSubalgebra n j
    · rw [tlGenF_eq_zero m j (by omega), skPlace_zero_matrix_tl]
      exact Subalgebra.zero_mem _
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, skPlace_smul, skPlace_one n 0 m (by omega)]
    exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) r
  | add x y _ _ hx hy =>
    rw [skPlace_add]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    rw [skPlace_mul n n n 0 x y (by omega) rfl rfl]
    exact mul_mem hx hy

/-- A crossing lies in the Temperley–Lieb subalgebra. -/
theorem crossingF_mem_tlSubalgebra (n : ℕ) (g : ℕ × Bool) : crossingF n g ∈ tlSubalgebra n := by
  obtain ⟨i, s⟩ := g
  cases s
  · rw [crossingF_neg]
    exact add_mem (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)
      (Subalgebra.smul_mem _ (tlGenF_mem_tlSubalgebra n i) _)
  · rw [crossingF_pos]
    exact add_mem (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)
      (Subalgebra.smul_mem _ (tlGenF_mem_tlSubalgebra n i) _)

/-- A braid matrix lies in the Temperley–Lieb subalgebra. -/
theorem braidMatrix_mem_tlSubalgebra (n : ℕ) (w : BraidWord) :
    braidMatrix n w ∈ tlSubalgebra n := by
  refine Subalgebra.list_prod_mem _ fun x hx ↦ ?_
  obtain ⟨g, -, rfl⟩ := List.mem_map.mp hx
  exact crossingF_mem_tlSubalgebra n g

/-- The partial trace over the last strand is the closure by a cup and a cap on the right. -/
theorem ptrTail_succ_eq_cupAt_capAt (p : ℕ) (b : SkMat (p + 1) (p + 1)) :
    ptrTail p (p + 1) b = cupAt p p * skPlace (p + 2) (p + 2) 0 b * capAt p p := by
  have hcup : cupThick 1 = skCup := (cupThick_succ 0).trans <| by
    rw [cupThick_zero, skPlace_one 2 1 0 (by omega), Matrix.mul_one]
  have h := ptrTail_eq_cupThick_capThick p 1 b
  rw [hcup, capThick_one] at h
  exact h

/-- The partial trace of the identity over the last strand is the loop value. -/
theorem ptrTail_succ_one_tl (p : ℕ) :
    ptrTail p (p + 1) (1 : SkMat (p + 1) (p + 1)) =
      (-(RatFunc.X : RatFunc ℚ) ^ (2 : ℤ) - RatFunc.X ^ (-2 : ℤ)) • (1 : SkMat p p) := by
  rw [ptrTail_succ_eq_cupAt_capAt, skPlace_one (p + 2) 0 (p + 1) (by omega), Matrix.mul_one,
    cupAt_mul_capAt p p le_rfl]

/-- The entries of the generator on two strands. -/
theorem tlGenF_two_zero_apply_tl (c d : Fin 2 → Bool) :
    tlGenF 2 0 c d = laurentToField (cupCapEntry (c 0) (c 1) (d 0) (d 1)) := by
  simp [tlGenF, tlGen, Fin.forall_fin_two]

/-- Every state of one factor is constant. -/
theorem exists_eq_const_state_one_tl (a : Fin 1 → Bool) : ∃ p : Bool, a = fun _ ↦ p :=
  ⟨a 0, funext fun x ↦ by rw [Subsingleton.elim x 0]⟩

/-- On two strands, the partial trace of the generator over the second strand is the identity
(the Markov property). -/
theorem ptrTail_one_two_tlGenF_tl : ptrTail 1 2 (tlGenF 2 0) = 1 := by
  have hsum : ∀ f : (Fin 1 → Bool) → RatFunc ℚ,
      ∑ s, f s = f (fun _ ↦ true) + f (fun _ ↦ false) := by
    intro f
    rw [← Fintype.sum_bool (fun t ↦ f (fun _ ↦ t))]
    refine Fintype.sum_equiv (Equiv.funUnique (Fin 1) Bool) _ _ fun s ↦ ?_
    congr 1
    funext x
    rw [Subsingleton.elim x default]
    rfl
  have e : ∀ u t : Bool, (fun j : Fin 2 ↦ if (j : ℕ) < 1 then u else t) = ![u, t] := by
    intro u t
    funext j
    fin_cases j <;> rfl
  ext a b
  obtain ⟨p, rfl⟩ := exists_eq_const_state_one_tl a
  obtain ⟨q, rfl⟩ := exists_eq_const_state_one_tl b
  rw [ptrTail_apply_of_eq 1 2 1 rfl, hsum]
  simp only [dite_eq_ite, e, Finset.univ_unique, Finset.prod_singleton,
    tlGenF_two_zero_apply_tl, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.one_apply]
  cases p <;> cases q <;>
    simp [cupCapEntry, skWeightEntry, laurentToField_T, RatFunc.X_ne_zero, funext_iff]

/-- The partial trace over the last strand of the generator on the last two strands is the
identity. -/
theorem ptrTail_tlGenF_last_tl (q : ℕ) :
    ptrTail (q + 1) (q + 2) (tlGenF (q + 2) q) = 1 := by
  rw [tlGenF_eq_skPlace (q + 2) q, ptrTail_skPlace_shift q 1 2 (by omega),
    ptrTail_one_two_tlGenF_tl, skPlace_one _ _ _ (by omega)]

/-- The conditional expectation: `e_q ι(b) e_q = ι(ptr b) e_q`, where `e_q` acts on the last two of
`q + 2` strands and `b` on the first `q + 1`. -/
theorem tlGenF_mul_skPlace_mul_tlGenF_tl (q : ℕ) (b : SkMat (q + 1) (q + 1)) :
    tlGenF (q + 2) q * skPlace (q + 2) (q + 2) 0 b * tlGenF (q + 2) q =
      skPlace (q + 2) (q + 2) 0 (ptrTail q (q + 1) b) * tlGenF (q + 2) q := by
  rw [← capAt_mul_cupAt q q le_rfl]
  have hc : capAt q q * ptrTail q (q + 1) b =
      skPlace (q + 2) (q + 2) 0 (ptrTail q (q + 1) b) * capAt q q := by
    have h := skPlace_mul_skPlace_comm (q + 2) (q + 2) q q 0 q (ptrTail q (q + 1) b) skCap
      (by omega) (by omega) (by omega) (by omega) (by omega)
    rw [Nat.add_sub_cancel, skPlace_self] at h
    exact h.symm
  calc capAt q q * cupAt q q * skPlace (q + 2) (q + 2) 0 b * (capAt q q * cupAt q q)
      = capAt q q * (cupAt q q * skPlace (q + 2) (q + 2) 0 b * capAt q q) * cupAt q q := by
        simp only [Matrix.mul_assoc]
    _ = _ := by rw [← ptrTail_succ_eq_cupAt_capAt, hc, Matrix.mul_assoc]

/-- The span of the `ι(a)` and `ι(a) e_q ι(b)`, `a, b ∈ TL_{q+1}`, inside the operators on
`q + 2` strands (the basic construction). -/
def tlBasicSpan (q : ℕ) : Submodule (RatFunc ℚ) (SkMat (q + 2) (q + 2)) :=
  Submodule.span (RatFunc ℚ)
    ({y | ∃ a ∈ tlSubalgebra (q + 1), y = skPlace (q + 2) (q + 2) 0 a} ∪
      {y | ∃ a ∈ tlSubalgebra (q + 1), ∃ b ∈ tlSubalgebra (q + 1),
        y = skPlace (q + 2) (q + 2) 0 a * tlGenF (q + 2) q * skPlace (q + 2) (q + 2) 0 b})

/-- The partial trace over the last strand maps the basic-construction span into `TL_{q+1}`. -/
theorem ptrTail_mem_of_mem_tlBasicSpan (q : ℕ) {y : SkMat (q + 2) (q + 2)}
    (hy : y ∈ tlBasicSpan q) : ptrTail (q + 1) (q + 2) y ∈ tlSubalgebra (q + 1) := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    rcases hy with ⟨a, ha, rfl⟩ | ⟨a, ha, b, hb, rfl⟩
    · rw [← Matrix.mul_one (skPlace (q + 2) (q + 2) 0 a),
        ptrTail_skPlace_mul (q + 1) (q + 2) (by omega), ptrTail_succ_one_tl (q + 1),
        Matrix.mul_smul, Matrix.mul_one]
      exact Subalgebra.smul_mem _ ha _
    · rw [ptrTail_mul_skPlace (q + 1) (q + 2) (by omega),
        ptrTail_skPlace_mul (q + 1) (q + 2) (by omega), ptrTail_tlGenF_last_tl q,
        Matrix.mul_one]
      exact mul_mem ha hb
  | zero =>
    have h := ptrTail_smul (q + 1) (q + 2) 0 (0 : SkMat (q + 2) (q + 2))
    rw [zero_smul, zero_smul] at h
    rw [h]
    exact Subalgebra.zero_mem _
  | add x y _ _ hx hy =>
    rw [ptrTail_add]
    exact add_mem hx hy
  | smul r x _ hx =>
    rw [ptrTail_smul]
    exact Subalgebra.smul_mem _ hx r

/-- The basic-construction span is stable under right multiplication by the generators. -/
theorem mul_tlGenF_mem_tlBasicSpan (q : ℕ)
    (hIH : ∀ x ∈ tlSubalgebra (q + 1), ptrTail q (q + 1) x ∈ tlSubalgebra q)
    {y : SkMat (q + 2) (q + 2)} (hy : y ∈ tlBasicSpan q) (j : ℕ) :
    y * tlGenF (q + 2) j ∈ tlBasicSpan q := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    rcases lt_trichotomy j q with hj | hj | hj
    · rw [← skPlace_tlGenF_tl (q + 2) (q + 1) j (by omega) (by omega)]
      rcases hy with ⟨a, ha, rfl⟩ | ⟨a, ha, b, hb, rfl⟩
      · refine Submodule.subset_span (Or.inl ⟨a * tlGenF (q + 1) j,
          mul_mem ha (tlGenF_mem_tlSubalgebra _ _), ?_⟩)
        rw [skPlace_mul (q + 2) (q + 2) (q + 2) 0 a _ (by omega) rfl rfl]
      · refine Submodule.subset_span (Or.inr ⟨a, ha, b * tlGenF (q + 1) j,
          mul_mem hb (tlGenF_mem_tlSubalgebra _ _), ?_⟩)
        rw [skPlace_mul (q + 2) (q + 2) (q + 2) 0 b _ (by omega) rfl rfl, Matrix.mul_assoc]
    · rw [hj]
      rcases hy with ⟨a, ha, rfl⟩ | ⟨a, ha, b, hb, rfl⟩
      · refine Submodule.subset_span (Or.inr ⟨a, ha, 1, Subalgebra.one_mem _, ?_⟩)
        rw [skPlace_one (q + 2) 0 (q + 1) (by omega), Matrix.mul_one]
      · refine Submodule.subset_span (Or.inr ⟨a * skPlace (q + 1) (q + 1) 0 (ptrTail q (q + 1) b),
          mul_mem ha (skPlace_mem_tlSubalgebra q (q + 1) (by omega) (hIH b hb)), 1,
          Subalgebra.one_mem _, ?_⟩)
        have hD := tlGenF_mul_skPlace_mul_tlGenF_tl q b
        rw [skPlace_one (q + 2) 0 (q + 1) (by omega), Matrix.mul_one,
          skPlace_mul (q + 2) (q + 2) (q + 2) 0 a _ (by omega) rfl rfl,
          skPlace_skPlace (q + 2) (q + 2) 0 0 _ (by omega) (by omega) (by omega) (by omega),
          Nat.add_zero]
        simp only [Matrix.mul_assoc] at hD ⊢
        rw [hD]
    · rw [tlGenF_eq_zero (q + 2) j (by omega), Matrix.mul_zero]
      exact Submodule.zero_mem _
  | zero =>
    rw [Matrix.zero_mul]
    exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
    rw [Matrix.add_mul]
    exact Submodule.add_mem _ hx hy
  | smul r x _ hx =>
    rw [Matrix.smul_mul]
    exact Submodule.smul_mem _ r hx

/-- `TL_{q+2}` lies in the basic-construction span. -/
theorem mem_tlBasicSpan_of_mem (q : ℕ)
    (hIH : ∀ x ∈ tlSubalgebra (q + 1), ptrTail q (q + 1) x ∈ tlSubalgebra q)
    {y : SkMat (q + 2) (q + 2)} (hy : y ∈ tlSubalgebra (q + 2)) : y ∈ tlBasicSpan q := by
  have hy' : y ∈ Subalgebra.toSubmodule (tlSubalgebra (q + 2)) := hy
  rw [tlSubalgebra, Algebra.adjoin_eq_span] at hy'
  refine (Submodule.span_le.mpr ?_) hy'
  intro z hz
  induction hz using Submonoid.closure_induction_right with
  | one =>
    exact Submodule.subset_span (Or.inl ⟨1, Subalgebra.one_mem _,
      (skPlace_one (q + 2) 0 (q + 1) (by omega)).symm⟩)
  | mul_right x _ g hg hx =>
    obtain ⟨j, rfl⟩ := hg
    exact mul_tlGenF_mem_tlBasicSpan q hIH hx j

/-- The partial trace over the last strand maps `TL_{p+1}` into `TL_p`. -/
theorem ptrTail_succ_mem_tlSubalgebra :
    ∀ (p : ℕ) (x : SkMat (p + 1) (p + 1)), x ∈ tlSubalgebra (p + 1) →
      ptrTail p (p + 1) x ∈ tlSubalgebra p
  | 0, _, _ => mem_tlSubalgebra_zero _
  | q + 1, _, hx => ptrTail_mem_of_mem_tlBasicSpan q
      (mem_tlBasicSpan_of_mem q (ptrTail_succ_mem_tlSubalgebra q) hx)

/-- Partial traces map Temperley–Lieb elements to Temperley–Lieb elements. -/
theorem ptrTail_mem_tlSubalgebra (k n : ℕ) (hkn : k ≤ n) {x : SkMat n n}
    (hx : x ∈ tlSubalgebra n) : ptrTail k n x ∈ tlSubalgebra k := by
  induction n, hkn using Nat.le_induction with
  | base => rwa [ptrTail_self]
  | succ n hkn ih =>
    rw [← ptrTail_ptrTail k n (n + 1) hkn (by omega)]
    exact ih (ptrTail_succ_mem_tlSubalgebra n x hx)

/-- The long knot lies in the Temperley–Lieb subalgebra. -/
theorem longKnotOp_mem_tlSubalgebra (K : BraidKnot) (k : ℕ) :
    longKnotOp K k ∈ tlSubalgebra k :=
  ptrTail_mem_tlSubalgebra k _ (Nat.le_mul_of_pos_right k K.strands_pos)
    (braidMatrix_mem_tlSubalgebra _ _)

/-- `f_k x` is a multiple of `f_k` for every Temperley–Lieb element `x`. -/
theorem jwAt_mul_mem_tlSubalgebra (k : ℕ) {x : SkMat k k} (hx : x ∈ tlSubalgebra k) :
    ∃ c : RatFunc ℚ, jwAt k 0 k * x = c • jwAt k 0 k := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    refine ⟨0, ?_⟩
    rw [zero_smul]
    by_cases hj : j + 1 < k
    · exact jwAt_mul_tlGenF k 0 k j (Nat.zero_le j) (by omega)
    · rw [tlGenF_eq_zero k j (by omega), Matrix.mul_zero]
  | algebraMap r =>
    exact ⟨r, by rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.mul_one]⟩
  | add x y _ _ hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨d, hd⟩ := hy
    exact ⟨c + d, by rw [Matrix.mul_add, hc, hd, add_smul]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨d, hd⟩ := hy
    exact ⟨c * d, by rw [← Matrix.mul_assoc, hc, Matrix.smul_mul, hd, smul_smul]⟩

/-- The generators vanish on the highest-weight state `(false, …, false)`. -/
theorem tlGenF_apply_allFalse (n j : ℕ) (w : Fin n → Bool) :
    tlGenF n j w (fun _ ↦ false) = 0 := by
  have key : ∀ x y : Bool, cupCapEntry x y false false = 0 := by
    intro x y
    cases x <;> cases y <;> rfl
  simp only [tlGenF, tlGen, Matrix.map_apply, Matrix.of_apply]
  split_ifs <;> simp [key]

/-- If the column of `B` at the highest-weight state is the identity column, so is the
column of `A * B` equal to that of `A`. -/
theorem mul_apply_allFalse_of_col {n : ℕ} (A B : SkMat n n)
    (hB : ∀ u, B u (fun _ ↦ false) = (1 : SkMat n n) u (fun _ ↦ false)) (w : Fin n → Bool) :
    (A * B) w (fun _ ↦ false) = A w (fun _ ↦ false) := by
  rw [Matrix.mul_apply]
  simp only [hB, Matrix.one_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, ite_true]

/-- The Jones–Wenzl projector fixes the highest-weight state. -/
theorem jwAt_apply_allFalse (n i j : ℕ) (w : Fin n → Bool) :
    jwAt n i j w (fun _ ↦ false) = (1 : SkMat n n) w (fun _ ↦ false) := by
  induction j using Nat.twoStepInduction generalizing w with
  | zero => rw [jwAt]
  | one => rw [jwAt]
  | more j _ ih =>
    have he : (jwAt n i (j + 1) * tlGenF n (i + j)) w (fun _ ↦ false) = 0 := by
      rw [Matrix.mul_apply]
      simp [tlGenF_apply_allFalse]
    rw [jwAt, Matrix.add_apply, Matrix.smul_apply, mul_apply_allFalse_of_col _ _ ih, he,
      smul_zero, add_zero, ih]

/-- The long knot acts on the Jones–Wenzl projector by its diagonal entry at the
highest-weight state. -/
theorem longKnotOp_mul_jwAt_eq_smul (K : BraidKnot) (k : ℕ) :
    longKnotOp K k * jwAt k 0 k =
      longKnotOp K k (fun _ ↦ false) (fun _ ↦ false) • jwAt k 0 k := by
  obtain ⟨c, hc⟩ := jwAt_mul_mem_tlSubalgebra k (longKnotOp_mem_tlSubalgebra K k)
  have h1 : longKnotOp K k * jwAt k 0 k = c • jwAt k 0 k := by
    rw [(longKnotOp_commute_jwAt K k 0 k).eq, hc]
  have h2 := congrFun (congrFun h1 (fun _ ↦ false)) (fun _ ↦ false)
  rw [mul_apply_allFalse_of_col _ _ (jwAt_apply_allFalse k 0 k), Matrix.smul_apply,
    jwAt_apply_allFalse, Matrix.one_apply_eq, smul_eq_mul, mul_one] at h2
  rw [h1, h2]

end AJConjecture
