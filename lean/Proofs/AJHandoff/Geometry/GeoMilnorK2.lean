import Mathlib

/-!
# Milnor `K₂` of a field

Mathlib has no Milnor `K`-theory. For a field `F`, `K₂ᴹ(F)` is the quotient of
`Fˣ ⊗_ℤ Fˣ` (written additively) by the subgroup generated by the Steinberg elements
`a ⊗ (1 - a)`, `a ≠ 0, 1`; the class of `a ⊗ b` is the symbol `{a, b}` (`geoSymbol`). The symbol
is bilinear, satisfies `{a, 1 - a} = 0`, and the standard consequences hold: `{a, -a} = 0`,
`{a, b} = -{b, a}`, `{a, a} = {a, -1}`, and `2 {-1, a} = 0`.

Route. Bilinearity is `TensorProduct.add_tmul`/`tmul_add` through `Additive.ofMul_mul`.
`{a, -a} = 0`: for `a ≠ 1`, `-a = (1 - a)/(1 - a⁻¹)`, so
`{a, -a} = {a, 1 - a} - {a, 1 - a⁻¹} = 0 + {a⁻¹, 1 - a⁻¹} = 0`; for `a = 1`, `{1, ·} = 0`.
Antisymmetry: expand `0 = {ab, -ab}`. `2{-1, a} = {1, a} = 0`.
-/

open TensorProduct

noncomputable section

namespace AJConjecture

/-- The Steinberg elements `a ⊗ (1 - a)`, `a ≠ 0, 1`, of `Fˣ ⊗ Fˣ`. -/
def geoSteinbergSet (F : Type*) [Field F] : Set (Additive Fˣ ⊗[ℤ] Additive Fˣ) :=
  {x | ∃ (a : F) (ha : a ≠ 0) (ha1 : 1 - a ≠ 0),
    x = Additive.ofMul (Units.mk0 a ha) ⊗ₜ[ℤ] Additive.ofMul (Units.mk0 (1 - a) ha1)}

/-- Milnor `K₂` of the field `F`: `Fˣ ⊗_ℤ Fˣ` modulo the Steinberg relations. -/
abbrev GeoMilnorK2 (F : Type*) [Field F] : Type _ :=
  (Additive Fˣ ⊗[ℤ] Additive Fˣ) ⧸ Submodule.span ℤ (geoSteinbergSet F)

/-- The symbol `{a, b} ∈ K₂ᴹ(F)`. -/
def geoSymbol {F : Type*} [Field F] (a b : Fˣ) : GeoMilnorK2 F :=
  Submodule.Quotient.mk (Additive.ofMul a ⊗ₜ[ℤ] Additive.ofMul b)

variable {F : Type*} [Field F]

theorem geoSymbol_mul_left (a a' b : Fˣ) :
    geoSymbol (a * a') b = geoSymbol a b + geoSymbol a' b := by
  simp only [geoSymbol, ofMul_mul, TensorProduct.add_tmul, Submodule.Quotient.mk_add]

theorem geoSymbol_mul_right (a b b' : Fˣ) :
    geoSymbol a (b * b') = geoSymbol a b + geoSymbol a b' := by
  simp only [geoSymbol, ofMul_mul, TensorProduct.tmul_add, Submodule.Quotient.mk_add]

/-- The Steinberg relation `{a, 1 - a} = 0`. -/
theorem geoSymbol_steinberg (a : F) (ha : a ≠ 0) (ha1 : 1 - a ≠ 0) :
    geoSymbol (Units.mk0 a ha) (Units.mk0 (1 - a) ha1) = 0 := by
  rw [geoSymbol, Submodule.Quotient.mk_eq_zero]
  exact Submodule.subset_span ⟨a, ha, ha1, rfl⟩

/-- The Steinberg relation for units: `{u, v} = 0` whenever `u + v = 1`. -/
private theorem geoSymbol_unit_steinberg (u v : Fˣ) (h : (u : F) + v = 1) :
    geoSymbol u v = 0 := by
  have hv : (1 : F) - u ≠ 0 := by rw [← h, add_sub_cancel_left]; exact v.ne_zero
  have hu : Units.mk0 (u : F) u.ne_zero = u := Units.ext rfl
  have hv' : Units.mk0 (1 - (u : F)) hv = v := Units.ext (by simp [← h])
  rw [← hu, ← hv']
  exact geoSymbol_steinberg _ _ _

/-- `{1, b} = 0`. -/
private theorem geoSymbol_one_left (b : Fˣ) : geoSymbol 1 b = 0 := by
  have h := geoSymbol_mul_left (1 : Fˣ) 1 b
  rw [mul_one] at h
  exact left_eq_add.mp h

/-- `{a⁻¹, b} = -{a, b}`. -/
private theorem geoSymbol_inv_left (a b : Fˣ) : geoSymbol a⁻¹ b = -geoSymbol a b := by
  have h := geoSymbol_mul_left a a⁻¹ b
  rw [mul_inv_cancel, geoSymbol_one_left] at h
  exact eq_neg_of_add_eq_zero_right h.symm

/-- `{a, -a} = 0`. -/
theorem geoSymbol_neg_self (a : Fˣ) : geoSymbol a (-a) = 0 := by
  by_cases ha : (a : F) = 1
  · rw [show a = 1 from Units.ext ha, geoSymbol_one_left]
  have hu : (1 : F) - a ≠ 0 := sub_ne_zero.mpr (Ne.symm ha)
  have hv : (1 : F) - (a⁻¹ : Fˣ) ≠ 0 := by
    rw [sub_ne_zero, ne_eq, eq_comm, Units.val_eq_one, inv_eq_one, ← Units.val_eq_one]
    exact ha
  have hprod : -a * Units.mk0 _ hv = Units.mk0 _ hu := by
    ext
    simp only [Units.val_mul, Units.val_neg, Units.val_mk0, Units.val_inv_eq_inv_val]
    field_simp [a.ne_zero]
    ring
  have h1 : geoSymbol a (Units.mk0 _ hu) = 0 := geoSymbol_unit_steinberg _ _ (by simp)
  have h2 : geoSymbol a⁻¹ (Units.mk0 _ hv) = 0 := geoSymbol_unit_steinberg _ _ (by simp)
  rw [← hprod, geoSymbol_mul_right, geoSymbol_inv_left] at *
  rw [neg_eq_zero] at h2
  rw [h2, add_zero] at h1
  exact h1

/-- `{a, b} = -{b, a}`. -/
theorem geoSymbol_antisymm (a b : Fˣ) : geoSymbol a b = -geoSymbol b a := by
  have h := geoSymbol_neg_self (a * b)
  rw [geoSymbol_mul_left, show -(a * b) = -a * b by simp, geoSymbol_mul_right,
    show -a * b = a * -b by simp, geoSymbol_mul_right, geoSymbol_neg_self, geoSymbol_neg_self]
    at h
  linear_combination (norm := module) h

/-- `{-1, a}` is `2`-torsion. -/
theorem geoSymbol_two_nsmul_neg_one (a : Fˣ) : 2 • geoSymbol (-1) a = 0 := by
  rw [two_nsmul, ← geoSymbol_mul_left, neg_one_mul, neg_neg, geoSymbol_one_left]

/-- The Steinberg relation for units: `{u, v} = 0` whenever `u + v = 1`. -/
theorem geoSymbol_eq_zero_of_add_eq_one (u v : Fˣ) (h : (u : F) + v = 1) :
    geoSymbol u v = 0 :=
  geoSymbol_unit_steinberg u v h

end AJConjecture
