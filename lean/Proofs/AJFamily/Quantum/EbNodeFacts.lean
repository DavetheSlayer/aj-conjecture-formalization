      n ^ 4 + 32 * ℓ * n ^ 9 + 80 * ℓ * n ^ 8 + 80 * ℓ * n ^ 7 + 40 * ℓ * n ^ 6 + 10 * ℓ * n ^ 5 + ℓ
      * n ^ 4 + 128 * n ^ 10 + 320 * n ^ 9 + 320 * n ^ 8 + 160 * n ^ 7 + 40 * n ^ 6 + 4 * n ^ 5) *
      hℓ + (-128 * m₀ ^ 6 * n ^ 9 - 256 * m₀ ^ 6 * n ^ 8 - 192 * m₀ ^ 6 * n ^ 7 - 64 * m₀ ^ 6 *
      n ^ 6 - 8 * m₀ ^ 6 * n ^ 5 + 512 * m₀ ^ 4 * n ^ 10 + 1152 * m₀ ^ 4 * n ^ 9 + 1088 * m₀ ^ 4 *
      n ^ 8 + 576 * m₀ ^ 4 * n ^ 7 + 192 * m₀ ^ 4 * n ^ 6 + 40 * m₀ ^ 4 * n ^ 5 + 4 * m₀ ^ 4 * n ^ 4
      + 1024 * m₀ ^ 2 * n ^ 10 + 2688 * m₀ ^ 2 * n ^ 9 + 2944 * m₀ ^ 2 * n ^ 8 + 1728 * m₀ ^ 2 *
      n ^ 7 + 576 * m₀ ^ 2 * n ^ 6 + 104 * m₀ ^ 2 * n ^ 5 + 8 * m₀ ^ 2 * n ^ 4 + 512 * n ^ 10 + 1408
      * n ^ 9 + 1600 * n ^ 8 + 960 * n ^ 7 + 320 * n ^ 6 + 56 * n ^ 5 + 4 * n ^ 4) * heb
  exact (mul_eq_zero.1 h).resolve_left (mul_ne_zero (pow_ne_zero 4 hn0) (pow_ne_zero 6 hs0))

/-- Vanishing of the criticality relation `2(w + nδ)` at the E/B node. -/
theorem ebNode_vanish_crit {n m₀ ℓ : ℂ}
    (hn0 : n ≠ 0) (hs0 : 2 * n + 1 ≠ 0)
    (heb : n * (2 * n + 1) * (m₀ ^ 2) ^ 2 + (4 * n ^ 2 + 2 * n + 1) * m₀ ^ 2 + n * (2 * n + 1) = 0)
    (hℓ : (2 * n + 1) * ℓ = (4 * n + 1) * (2 * n + 1) + 8 * n ^ 2 * m₀ ^ 2) :
    2 * (((m₀ ^ 4 + 1) * ℓ ^ 2 - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4 - 2 * m₀ ^ 2 + 1) * ℓ + m₀ ^ 4 *
    (m₀ ^ 4 + 1)) / 2 + n * ((m₀ ^ 4 * ℓ ^ 2 + (-m₀ ^ 8 + m₀ ^ 6 + 2 * m₀ ^ 4 + m₀ ^ 2 - 1) * ℓ +
    m₀ ^ 4) - ((m₀ ^ 4 + 1) * ℓ ^ 2 - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4 - 2 * m₀ ^ 2 + 1) * ℓ +
    m₀ ^ 4 * (m₀ ^ 4 + 1)) / 2)) = 0 := by
  have h : n ^ 4 * (2 * n + 1) ^ 6 * (2 * (((m₀ ^ 4 + 1) * ℓ ^ 2 - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 *
      m₀ ^ 4 - 2 * m₀ ^ 2 + 1) * ℓ + m₀ ^ 4 *
    (m₀ ^ 4 + 1)) / 2 + n * ((m₀ ^ 4 * ℓ ^ 2 + (-m₀ ^ 8 + m₀ ^ 6 + 2 * m₀ ^ 4 + m₀ ^ 2 - 1) * ℓ +
    m₀ ^ 4) - ((m₀ ^ 4 + 1) * ℓ ^ 2 - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4 - 2 * m₀ ^ 2 + 1) * ℓ +
    m₀ ^ 4 * (m₀ ^ 4 + 1)) / 2))) = 0 := by
    linear_combination (-32 * m₀ ^ 8 * n ^ 10 - 112 * m₀ ^ 8 * n ^ 9 - 160 * m₀ ^ 8 * n ^ 8 - 120
      * m₀ ^ 8 * n ^ 7 - 50 * m₀ ^ 8 * n ^ 6 - 11 * m₀ ^ 8 * n ^ 5 - m₀ ^ 8 * n ^ 4 + 128 * m₀ ^ 6 *
      n ^ 11 + 384 * m₀ ^ 6 * n ^ 10 + 512 * m₀ ^ 6 * n ^ 9 + 416 * m₀ ^ 6 * n ^ 8 + 232 * m₀ ^ 6 *
      n ^ 7 + 88 * m₀ ^ 6 * n ^ 6 + 20 * m₀ ^ 6 * n ^ 5 + 2 * m₀ ^ 6 * n ^ 4 + 32 * m₀ ^ 4 * ℓ *
      n ^ 10 + 112 * m₀ ^ 4 * ℓ * n ^ 9 + 160 * m₀ ^ 4 * ℓ * n ^ 8 + 120 * m₀ ^ 4 * ℓ * n ^ 7 + 50 *
      m₀ ^ 4 * ℓ * n ^ 6 + 11 * m₀ ^ 4 * ℓ * n ^ 5 + m₀ ^ 4 * ℓ * n ^ 4 + 128 * m₀ ^ 4 * n ^ 11 +
      544 * m₀ ^ 4 * n ^ 10 + 976 * m₀ ^ 4 * n ^ 9 + 960 * m₀ ^ 4 * n ^ 8 + 560 * m₀ ^ 4 * n ^ 7 +
      194 * m₀ ^ 4 * n ^ 6 + 37 * m₀ ^ 4 * n ^ 5 + 3 * m₀ ^ 4 * n ^ 4 - 128 * m₀ ^ 2 * n ^ 11 - 128
      * m₀ ^ 2 * n ^ 10 + 128 * m₀ ^ 2 * n ^ 9 + 288 * m₀ ^ 2 * n ^ 8 + 216 * m₀ ^ 2 * n ^ 7 + 88 *
      m₀ ^ 2 * n ^ 6 + 20 * m₀ ^ 2 * n ^ 5 + 2 * m₀ ^ 2 * n ^ 4 - 32 * ℓ * n ^ 10 - 48 * ℓ * n ^ 9 +
      40 * ℓ * n ^ 7 + 30 * ℓ * n ^ 6 + 9 * ℓ * n ^ 5 + ℓ * n ^ 4 - 128 * n ^ 11 - 256 * n ^ 10 -
      160 * n ^ 9 + 40 * n ^ 7 + 16 * n ^ 6 + 2 * n ^ 5) * hℓ + (-128 * m₀ ^ 6 * n ^ 10 - 384 *
      m₀ ^ 6 * n ^ 9 - 448 * m₀ ^ 6 * n ^ 8 - 256 * m₀ ^ 6 * n ^ 7 - 72 * m₀ ^ 6 * n ^ 6 - 8 *
      m₀ ^ 6 * n ^ 5 + 512 * m₀ ^ 4 * n ^ 11 + 1408 * m₀ ^ 4 * n ^ 10 + 1664 * m₀ ^ 4 * n ^ 9 + 1120
      * m₀ ^ 4 * n ^ 8 + 480 * m₀ ^ 4 * n ^ 7 + 136 * m₀ ^ 4 * n ^ 6 + 24 * m₀ ^ 4 * n ^ 5 + 2 *
      m₀ ^ 4 * n ^ 4 + 896 * m₀ ^ 2 * n ^ 10 + 2176 * m₀ ^ 2 * n ^ 9 + 2176 * m₀ ^ 2 * n ^ 8 + 1152
      * m₀ ^ 2 * n ^ 7 + 344 * m₀ ^ 2 * n ^ 6 + 56 * m₀ ^ 2 * n ^ 5 + 4 * m₀ ^ 2 * n ^ 4 - 512 *
      n ^ 11 - 1152 * n ^ 10 - 896 * n ^ 9 - 160 * n ^ 8 + 160 * n ^ 7 + 104 * n ^ 6 + 24 * n ^ 5 +
      2 * n ^ 4) * heb
  exact (mul_eq_zero.1 h).resolve_left (mul_ne_zero (pow_ne_zero 4 hn0) (pow_ne_zero 6 hs0))

/-- A linear form `u + v x` in a root `x = m₀²` of the node quadratic is nonzero as soon as its
norm `n(2n+1)u² - (4n²+2n+1)uv + n(2n+1)v²` is. -/
private theorem ebNode_lin_ne_zero {n m₀ u v : ℂ}
    (heb : n * (2 * n + 1) * (m₀ ^ 2) ^ 2 + (4 * n ^ 2 + 2 * n + 1) * m₀ ^ 2 + n * (2 * n + 1) = 0)
    (h : n * (2 * n + 1) * u ^ 2 - (4 * n ^ 2 + 2 * n + 1) * u * v + n * (2 * n + 1) * v ^ 2 ≠ 0) :
    u + v * m₀ ^ 2 ≠ 0 := by
  intro h0
  apply h
  linear_combination (n * (2 * n + 1) * u - n * (2 * n + 1) * v * m₀ ^ 2 -
    (4 * n ^ 2 + 2 * n + 1) * v) * h0 + v ^ 2 * heb

/-- The double-root closed form when `w + kδ = 0`, with the denominators cleared. -/
theorem dblRootDeriv_eq_of_crit {w δ z₁ α β : ℂ} {k : ℕ} (hk : 2 ≤ k)
    (hw : w ≠ 0) (hδ : w + k * δ = 0) :
    dblRootDeriv w δ z₁ α β k = w ^ (k - 2) / 6 *
      (6 * k * w * z₁ + (k - 1) * (2 * k - 1) * α * w - 2 * (k - 1) * (k + 1) * β) := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le' hk
  have hk0 : ((j + 2 : ℕ) : ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero (j + 1)
  have hδ' : δ = -w / ((j + 2 : ℕ) : ℂ) := by
    field_simp
    linear_combination hδ
  rw [dblRootDeriv, Nat.add_sub_cancel, pow_add, hδ']
  push_cast at hk0 ⊢
  field_simp
  ring

/-- The values and derivatives at the E/B node used by the index criterion. -/
theorem ebNode_facts (m : ℕ) (hm : 2 ≤ m) {m₀ : ℂ}
    (heb : (m : ℂ) * (2 * m + 1) * (m₀ ^ 2) ^ 2 + (4 * m ^ 2 + 2 * m + 1) * m₀ ^ 2 +
      m * (2 * m + 1) = 0) :
    m₀ ≠ 0 ∧ m₀ ^ 2 ≠ 1 ∧ m₀ ^ 2 ≠ -1 ∧ m₀ ^ 2 ≠ ebNodeJ m ∧ m₀ ^ 2 * ebNodeJ m ≠ 1 ∧
      ebNodeL m m₀ ≠ 0 ∧ evalIntPoint (X - 1) m₀ (ebNodeL m m₀) ≠ 0 ∧
      evalIntPoint extraFactor m₀ (ebNodeL m m₀) = 0 ∧
      evalIntPoint (twistPoly m) m₀ (ebNodeL m m₀) = 0 ∧
      evalIntPoint (derivative extraFactor) m₀ (ebNodeL m m₀) ≠ 0 ∧
      evalIntPoint (derivative (twistPoly m)) m₀ (ebNodeL m m₀) ≠ 0 ∧
      evalIntPoint (derivative extraFactor) m₀ (ebNodeL m m₀) *
          evalIntPoint (coeffDerivative (twistPoly m)) m₀ (ebNodeL m m₀) -
        evalIntPoint (coeffDerivative extraFactor) m₀ (ebNodeL m m₀) *
          evalIntPoint (derivative (twistPoly m)) m₀ (ebNodeL m m₀) ≠ 0 := by
  have hn0 : (m : ℂ) ≠ 0 := by exact_mod_cast (by omega : m ≠ 0)
  have hs0 : 2 * (m : ℂ) + 1 ≠ 0 := by exact_mod_cast (by omega : 2 * m + 1 ≠ 0)
  have h4 : 4 * (m : ℂ) + 1 ≠ 0 := by exact_mod_cast (by omega : 4 * m + 1 ≠ 0)
  have hc0 : 8 * (m : ℂ) ^ 2 + 4 * m + 1 ≠ 0 := by
    exact_mod_cast (by positivity : 8 * m ^ 2 + 4 * m + 1 ≠ 0)
  have hd0 : 10 * (m : ℂ) ^ 2 + 5 * m + 1 ≠ 0 := by
    exact_mod_cast (by positivity : 10 * m ^ 2 + 5 * m + 1 ≠ 0)
  have h0 : m₀ ≠ 0 := by
    rintro rfl
    exact mul_ne_zero hn0 hs0 (by linear_combination heb)
  have hx0 : m₀ ^ 2 ≠ 0 := pow_ne_zero 2 h0
  have h1 : m₀ ^ 2 ≠ 1 := by
    intro h
    rw [h] at heb
    exact hc0 (by linear_combination heb)
  have h2 : m₀ ^ 2 ≠ -1 := by
    intro h
    rw [h] at heb
    exact one_ne_zero (by linear_combination -heb : (1 : ℂ) = 0)
  have hJ : (2 * (m : ℂ) + 1) * ebNodeJ m = -(2 * m - 1) := by
    rw [ebNodeJ]
    field_simp
  have hxJ : m₀ ^ 2 ≠ ebNodeJ m := by
    intro h
    rw [h] at heb
    exact one_ne_zero
      (by linear_combination heb - ((m : ℂ) * ebNodeJ m + m + 1) * hJ : (1 : ℂ) = 0)
  have hxJ1 : m₀ ^ 2 * ebNodeJ m ≠ 1 := by
    intro h
    exact one_ne_zero (by
      linear_combination ebNodeJ m ^ 2 * heb - ((m : ℂ) * (2 * m + 1) * (m₀ ^ 2 * ebNodeJ m + 1) +
        (4 * (m : ℂ) ^ 2 + 2 * m + 1) * ebNodeJ m) * h - ((m : ℂ) * ebNodeJ m + m + 1) * hJ :
        (1 : ℂ) = 0)
  have hJx : ebNodeJ m - m₀ ^ 2 ≠ 0 := sub_ne_zero.mpr (Ne.symm hxJ)
  have h1ℓ : (ebNodeJ m - m₀ ^ 2) * ebNodeL m m₀ = 1 - m₀ ^ 2 * ebNodeJ m := by
    rw [ebNodeL, famNodeL]
    field_simp
  have hℓ0 : ebNodeL m m₀ ≠ 0 := by
    rw [ebNodeL, famNodeL]
    exact div_ne_zero (sub_ne_zero.mpr (Ne.symm hxJ1)) hJx
  set ℓ := ebNodeL m m₀
  have hℓ : (2 * (m : ℂ) + 1) * ℓ = (4 * m + 1) * (2 * m + 1) + 8 * m ^ 2 * m₀ ^ 2 := by
    have h : (2 * (m : ℂ) + 1) * (ebNodeJ m - m₀ ^ 2) *
        ((2 * m + 1) * ℓ - ((4 * m + 1) * (2 * m + 1) + 8 * m ^ 2 * m₀ ^ 2)) = 0 := by
      linear_combination (2 * (m : ℂ) + 1) ^ 2 * h1ℓ + (-8 * (m : ℂ) ^ 2 * m₀ ^ 2 -
        8 * m ^ 2 - 2 * m * m₀ ^ 2 - 6 * m - m₀ ^ 2 - 1) * hJ + 8 * (m : ℂ) * heb
    linear_combination (mul_eq_zero.1 h).resolve_left (mul_ne_zero hs0 hJx)
  have hℓx : ℓ + m₀ ^ 2 ≠ 0 := by
    have hne := ebNode_lin_ne_zero (u := 8 * (m : ℂ) ^ 2 + 6 * m + 1)
      (v := 8 * (m : ℂ) ^ 2 + 2 * m + 1) heb
      (fun h ↦ mul_ne_zero (pow_ne_zero 2 hs0) hc0 (by linear_combination -h))
    intro h
    exact hne (by linear_combination (2 * (m : ℂ) + 1) * h - hℓ)
  -- the values of `Ẑ` and of the twist polynomials at the node
  have hZ : evalIntPoint zetaMoebiusM m₀ ℓ = -2 * m₀ ^ 2 * (ℓ + m₀ ^ 2) ^ 2 := by
    rw [evalIntPoint_zetaMoebiusM]
    linear_combination ebNode_vanish_zeta hn0 hs0 heb hℓ
  have hw : evalIntPoint zetaMoebiusM m₀ ℓ ≠ 0 := by
    rw [hZ]
    exact mul_ne_zero (mul_ne_zero (by norm_num) hx0) (pow_ne_zero 2 hℓx)
  have hdbl : evalIntPoint zetaMoebiusM m₀ ℓ ^ 2 = 4 * ((m₀ ^ 2) ^ 2 * (ℓ + m₀ ^ 2) ^ 4) := by
    rw [hZ]
    ring
  have hcrit : evalIntPoint zetaMoebiusM m₀ ℓ / 2 +
      (m : ℂ) * (evalIntPoint (twistPoly 1) m₀ ℓ - evalIntPoint zetaMoebiusM m₀ ℓ / 2) = 0 := by
    rw [evalIntPoint_zetaMoebiusM, evalIntPoint_twistPoly_one]
    linear_combination (1 / 2 : ℂ) * ebNode_vanish_crit hn0 hs0 heb hℓ
  have hw' := ebNode_lin_half_zeta hn0 hs0 heb hℓ
  rw [← evalIntPoint_zetaMoebiusM] at hw'
  have hz' := ebNode_lin_dL_twist_one hs0 heb hℓ
  rw [← evalIntPoint_derivative_twistPoly_one] at hz'
  have hα' := ebNode_lin_dL_zeta hs0 heb hℓ
  rw [← evalIntPoint_derivative_zetaMoebiusM] at hα'
  have hβ' := ebNode_lin_dL_twistCoeff heb hℓ
  rw [← evalIntPoint_derivative_twistCoeff] at hβ'
  have hzM := ebNode_lin_dM_twist_one hn0 hs0 heb hℓ
  have hαM := ebNode_lin_dM_zeta hn0 hs0 heb hℓ
  have hβM := ebNode_lin_dM_twistCoeff heb hℓ
  have hEL := ebNode_lin_dL_extra hs0 heb hℓ
  have hEM := ebNode_lin_dM_extra hn0 heb hℓ
  have hPL := ebNode_lin_PL hn0 hs0 heb hw' hz' hα' hβ'
  have hPM := ebNode_lin_PM hn0 hs0 heb hw' hzM hαM hβM
  have hjac := ebNode_jac_identity hn0 hs0 heb hEL hEM hPL hPM hw'
  obtain ⟨hB, hBL, hBM⟩ := twistPoly_node_values hdbl hw m
  set w := evalIntPoint zetaMoebiusM m₀ ℓ / 2
  have hw2 : w ≠ 0 := div_ne_zero hw two_ne_zero
  rw [dblRootDeriv_eq_of_crit hm hw2 hcrit] at hBL hBM
  rw [evalIntPoint_coeffDerivative_twistPoly_one,
    evalIntPoint_coeffDerivative_zetaMoebiusM,
    evalIntPoint_coeffDerivative_twistCoeff] at hBM
  refine ⟨h0, h1, h2, hxJ, hxJ1, hℓ0, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [evalIntPoint_X_sub_one_ebNode]
    intro h
    have h' : 4 * (m : ℂ) * ((2 * m + 1) + 2 * m * m₀ ^ 2) = 0 := by
      linear_combination (2 * (m : ℂ) + 1) * h - hℓ
    exact ebNode_lin_ne_zero heb (fun hN ↦ mul_ne_zero hn0 hs0 (by linear_combination -hN))
      ((mul_eq_zero.1 h').resolve_left (mul_ne_zero (by norm_num : (4 : ℂ) ≠ 0) hn0))
  · rw [evalIntPoint_extraFactor_ebNode]
    exact ebNode_vanish_extra hn0 hs0 heb hℓ
  · have hpow : w ^ m = w ^ (m - 1) * w := by
      rw [← pow_succ, Nat.sub_add_cancel (by omega)]
    rw [hB, hpow]
    linear_combination w ^ (m - 1) * hcrit
  · rw [evalIntPoint_derivative_extraFactor]
    intro h
    rw [h, mul_zero] at hEL
    refine ebNode_lin_ne_zero heb (fun hN ↦ ?_) hEL.symm
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero hn0 hs0) (pow_ne_zero 2 h4)) hc0
      (by linear_combination -hN)
  · rw [hBL]
    refine mul_ne_zero (div_ne_zero (pow_ne_zero _ hw2) (by norm_num)) ?_
    intro h
    rw [h, mul_zero] at hPL
    refine ebNode_lin_ne_zero heb (fun hN ↦ ?_)
      ((mul_eq_zero.1 hPL.symm).resolve_left (mul_ne_zero hc0 hd0))
    exact mul_ne_zero (mul_ne_zero (pow_ne_zero 7 hn0) (pow_ne_zero 11 hs0)) hc0
      (by linear_combination -hN)
  · rw [hBL, hBM, evalIntPoint_derivative_extraFactor,
      evalIntPoint_coeffDerivative_extraFactor]
    intro h
    have key : w ^ (m - 2) * m₀ * (12 * (8 * (m : ℂ) ^ 2 + 4 * m + 1) * w ^ 2) = 0 := by
      linear_combination (w ^ (m - 2) * m₀) * hjac - 6 * (m : ℂ) * h
    exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ hw2) h0)
      (mul_ne_zero (mul_ne_zero (by norm_num) hc0) (pow_ne_zero 2 hw2)) key

end AJConjecture
