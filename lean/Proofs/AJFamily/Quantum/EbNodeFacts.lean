import Mathlib
import AJFamily.Quantum.TwistPolyBasic
import AJConjecture.WitnessPolynomials
import AJFamily.Quantum.TwistPolyNodeValues

/-!
# E/B node: values and derivatives

`ebNode_facts`: at the E/B node `(m₀, L₀)`, where `x₀ = m₀²` solves
`m(2m + 1) x₀² + (4m² + 2m + 1) x₀ + m(2m + 1) = 0` and `L₀ = ebNodeL m m₀`, `E` and `B_m`
vanish, while `L - 1`, `∂_L E`, `∂_L B_m` and the Jacobian `∂_L E ∂_M B_m - ∂_M E ∂_L B_m` do
not. All node values are reduced to linear forms in `x₀` modulo the node quadratic.
-/

open Polynomial IntermediateField

noncomputable section

namespace AJConjecture

/-- The inner derivative of the outer variable vanishes. -/
theorem innerDerivative_X : innerDerivative (X : ℤ[X][X]) = 0 := by
  rw [← monomial_one_one_eq_X]
  simp [innerDerivative]

/-- `E` at `(M, ℓ)`. -/
private theorem evalIntPoint_extraFactor_ebNode (M ℓ : ℂ) :
    evalIntPoint extraFactor M ℓ = ℓ ^ 2 - (M ^ 4 - 4 * M ^ 2 + 1) * ℓ + M ^ 4 := by
  rw [evalIntPoint_eq, extraFactor]
  simp [evalIntHomTwistNode, eval₂_pow]

/-- `∂_L E` at `(M, ℓ)`. -/
theorem evalIntPoint_derivative_extraFactor (M ℓ : ℂ) :
    evalIntPoint (derivative extraFactor) M ℓ = 2 * ℓ - (M ^ 4 - 4 * M ^ 2 + 1) := by
  rw [evalIntPoint_eq, extraFactor]
  simp [evalIntHomTwistNode, eval₂_pow, derivative_pow, derivative_mul]

/-- `∂_M E` at `(M, ℓ)`. -/
theorem evalIntPoint_coeffDerivative_extraFactor (M ℓ : ℂ) :
    evalIntPoint (coeffDerivative extraFactor) M ℓ = M * (4 * M ^ 2 - (4 * M ^ 2 - 8) * ℓ) := by
  rw [evalIntPoint_eq, extraFactor, coeffDerivative_eq_innerDerivative]
  simp only [innerDerivative_add, innerDerivative_sub, innerDerivative_mul,
    innerDerivative_C, innerDerivative_X, pow_succ, pow_zero, one_mul]
  simp [evalIntHomTwistNode, derivative_mul]
  ring

/-- `Ẑ` at `(M, ℓ)`. -/
theorem evalIntPoint_zetaMoebiusM (M ℓ : ℂ) :
    evalIntPoint zetaMoebiusM M ℓ = (M ^ 4 + 1) * ℓ ^ 2 -
      (M ^ 8 - 2 * M ^ 6 - 2 * M ^ 4 - 2 * M ^ 2 + 1) * ℓ + M ^ 4 * (M ^ 4 + 1) := by
  rw [evalIntPoint_eq, zetaMoebiusM_eq_explicit]
  simp [evalIntHomTwistNode, eval₂_pow]

/-- `∂_L Ẑ` at `(M, ℓ)`. -/
theorem evalIntPoint_derivative_zetaMoebiusM (M ℓ : ℂ) :
    evalIntPoint (derivative zetaMoebiusM) M ℓ = 2 * (M ^ 4 + 1) * ℓ -
      (M ^ 8 - 2 * M ^ 6 - 2 * M ^ 4 - 2 * M ^ 2 + 1) := by
  rw [evalIntPoint_eq, zetaMoebiusM_eq_explicit]
  simp [evalIntHomTwistNode, eval₂_pow, derivative_pow, derivative_mul]
  ring

/-- `∂_M Ẑ` at `(M, ℓ)`. -/
theorem evalIntPoint_coeffDerivative_zetaMoebiusM (M ℓ : ℂ) :
    evalIntPoint (coeffDerivative zetaMoebiusM) M ℓ = M * (4 * M ^ 2 * ℓ ^ 2 -
      (8 * M ^ 6 - 12 * M ^ 4 - 8 * M ^ 2 - 4) * ℓ + (8 * M ^ 6 + 4 * M ^ 2)) := by
  rw [evalIntPoint_eq, zetaMoebiusM_eq_explicit,
    coeffDerivative_eq_innerDerivative]
  simp only [innerDerivative_add, innerDerivative_sub, innerDerivative_mul,
    innerDerivative_C, innerDerivative_X, pow_succ, pow_zero, one_mul]
  simp [evalIntHomTwistNode, derivative_mul]
  ring

/-- `B_1` at `(M, ℓ)`. -/
theorem evalIntPoint_twistPoly_one (M ℓ : ℂ) :
    evalIntPoint (twistPoly 1) M ℓ = M ^ 4 * ℓ ^ 2 +
      (-M ^ 8 + M ^ 6 + 2 * M ^ 4 + M ^ 2 - 1) * ℓ + M ^ 4 := by
  rw [evalIntPoint_eq, twistPoly_one_eq_explicit]
  simp [evalIntHomTwistNode, eval₂_pow]

/-- `∂_L B_1` at `(M, ℓ)`. -/
theorem evalIntPoint_derivative_twistPoly_one (M ℓ : ℂ) :
    evalIntPoint (derivative (twistPoly 1)) M ℓ = 2 * M ^ 4 * ℓ +
      (-M ^ 8 + M ^ 6 + 2 * M ^ 4 + M ^ 2 - 1) := by
  rw [evalIntPoint_eq, twistPoly_one_eq_explicit]
  simp [evalIntHomTwistNode, eval₂_pow, derivative_pow, derivative_mul]
  ring

/-- `∂_M B_1` at `(M, ℓ)`. -/
theorem evalIntPoint_coeffDerivative_twistPoly_one (M ℓ : ℂ) :
    evalIntPoint (coeffDerivative (twistPoly 1)) M ℓ = M * (4 * M ^ 2 * ℓ ^ 2 +
      (-8 * M ^ 6 + 6 * M ^ 4 + 8 * M ^ 2 + 2) * ℓ + 4 * M ^ 2) := by
  rw [evalIntPoint_eq, twistPoly_one_eq_explicit,
    coeffDerivative_eq_innerDerivative]
  simp only [innerDerivative_add, innerDerivative_mul,
    innerDerivative_C, innerDerivative_X, pow_succ, pow_zero, one_mul]
  simp [evalIntHomTwistNode, derivative_mul]
  ring

/-- `∂_L (x²(L + x)⁴)` at `(M, ℓ)`. -/
theorem evalIntPoint_derivative_twistCoeff (M ℓ : ℂ) :
    evalIntPoint (derivative (C (X ^ 4) * (C (X ^ 2) + X) ^ 4 : ℤ[X][X])) M ℓ =
      4 * M ^ 4 * (M ^ 2 + ℓ) ^ 3 := by
  rw [evalIntPoint_eq]
  simp [evalIntHomTwistNode, eval₂_pow, derivative_pow, derivative_mul]
  ring

/-- `∂_M (x²(L + x)⁴)` at `(M, ℓ)`. -/
theorem evalIntPoint_coeffDerivative_twistCoeff (M ℓ : ℂ) :
    evalIntPoint (coeffDerivative (C (X ^ 4) * (C (X ^ 2) + X) ^ 4 : ℤ[X][X])) M ℓ =
      M * (4 * M ^ 2 * (M ^ 2 + ℓ) ^ 4 + 8 * M ^ 4 * (M ^ 2 + ℓ) ^ 3) := by
  rw [evalIntPoint_eq, coeffDerivative_eq_innerDerivative]
  simp only [innerDerivative_add, innerDerivative_mul, innerDerivative_C,
    innerDerivative_X, pow_succ, pow_zero, one_mul]
  simp [evalIntHomTwistNode, derivative_mul]
  ring

/-- `L - 1` at `(M, ℓ)`. -/
private theorem evalIntPoint_X_sub_one_ebNode (M ℓ : ℂ) :
    evalIntPoint (X - 1) M ℓ = ℓ - 1 := by
  rw [evalIntPoint_eq]
  simp [evalIntHomTwistNode]

/-- Linear form of half the value of `Ẑ` at the E/B node. -/
theorem ebNode_lin_half_zeta {n m₀ ℓ : ℂ}
    (hn0 : n ≠ 0) (hs0 : 2 * n + 1 ≠ 0)
    (heb : n * (2 * n + 1) * (m₀ ^ 2) ^ 2 + (4 * n ^ 2 + 2 * n + 1) * m₀ ^ 2 + n * (2 * n + 1) = 0)
    (hℓ : (2 * n + 1) * ℓ = (4 * n + 1) * (2 * n + 1) + 8 * n ^ 2 * m₀ ^ 2) :
    n ^ 2 * (2 * n + 1) ^ 4 * (((m₀ ^ 4 + 1) * ℓ ^ 2 - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4 - 2 *
        m₀ ^ 2 + 1) * ℓ +
      m₀ ^ 4 * (m₀ ^ 4 + 1)) / 2) =
      256 * n ^ 7 + 192 * n ^ 6 + 32 * n ^ 5 - 24 * n ^ 4 - 20 * n ^ 3 - 6 * n ^ 2 - n + (256 *
      n ^ 7 - 32 * n ^ 5 - 80 * n ^ 4 - 48 * n ^ 3 - 24 * n ^ 2 - 6 * n - 1) * m₀ ^ 2 := by
  have h : n ^ 4 * (2 * n + 1) ^ 6 * (((m₀ ^ 4 + 1) * ℓ ^ 2 - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4
      - 2 * m₀ ^ 2 + 1) * ℓ +
      m₀ ^ 4 * (m₀ ^ 4 + 1)) / 2) =
      n ^ 2 * (2 * n + 1) ^ 2 * (256 * n ^ 7 + 192 * n ^ 6 + 32 * n ^ 5 - 24 * n ^ 4 - 20 *
          n ^ 3 - 6 * n ^ 2 - n + (256 *
      n ^ 7 - 32 * n ^ 5 - 80 * n ^ 4 - 48 * n ^ 3 - 24 * n ^ 2 - 6 * n - 1) * m₀ ^ 2) := by
    linear_combination (-16 * m₀ ^ 8 * n ^ 9 - 40 * m₀ ^ 8 * n ^ 8 - 40 * m₀ ^ 8 * n ^ 7 - 20 *
      m₀ ^ 8 * n ^ 6 - 5 * m₀ ^ 8 * n ^ 5 - m₀ ^ 8 * n ^ 4/2 + 64 * m₀ ^ 6 * n ^ 10 + 160 * m₀ ^ 6 *
      n ^ 9 + 176 * m₀ ^ 6 * n ^ 8 + 112 * m₀ ^ 6 * n ^ 7 + 44 * m₀ ^ 6 * n ^ 6 + 10 * m₀ ^ 6 *
      n ^ 5 + m₀ ^ 6 * n ^ 4 + 16 * m₀ ^ 4 * ℓ * n ^ 9 + 40 * m₀ ^ 4 * ℓ * n ^ 8 + 40 * m₀ ^ 4 * ℓ *
      n ^ 7 + 20 * m₀ ^ 4 * ℓ * n ^ 6 + 5 * m₀ ^ 4 * ℓ * n ^ 5 + m₀ ^ 4 * ℓ * n ^ 4/2 + 64 * m₀ ^ 4
      * n ^ 10 + 208 * m₀ ^ 4 * n ^ 9 + 280 * m₀ ^ 4 * n ^ 8 + 200 * m₀ ^ 4 * n ^ 7 + 80 * m₀ ^ 4 *
      n ^ 6 + 17 * m₀ ^ 4 * n ^ 5 + 3 * m₀ ^ 4 * n ^ 4/2 + 64 * m₀ ^ 2 * n ^ 10 + 160 * m₀ ^ 2 *
      n ^ 9 + 176 * m₀ ^ 2 * n ^ 8 + 112 * m₀ ^ 2 * n ^ 7 + 44 * m₀ ^ 2 * n ^ 6 + 10 * m₀ ^ 2 *
      n ^ 5 + m₀ ^ 2 * n ^ 4 + 16 * ℓ * n ^ 9 + 40 * ℓ * n ^ 8 + 40 * ℓ * n ^ 7 + 20 * ℓ * n ^ 6 + 5
      * ℓ * n ^ 5 + ℓ * n ^ 4/2 + 64 * n ^ 10 + 160 * n ^ 9 + 160 * n ^ 8 + 80 * n ^ 7 + 20 * n ^ 6
      + 2 * n ^ 5) * hℓ + (-64 * m₀ ^ 6 * n ^ 9 - 128 * m₀ ^ 6 * n ^ 8 - 96 * m₀ ^ 6 * n ^ 7 - 32 *
      m₀ ^ 6 * n ^ 6 - 4 * m₀ ^ 6 * n ^ 5 + 256 * m₀ ^ 4 * n ^ 10 + 576 * m₀ ^ 4 * n ^ 9 + 544 *
      m₀ ^ 4 * n ^ 8 + 288 * m₀ ^ 4 * n ^ 7 + 96 * m₀ ^ 4 * n ^ 6 + 20 * m₀ ^ 4 * n ^ 5 + 2 * m₀ ^ 4
      * n ^ 4 + 320 * m₀ ^ 2 * n ^ 9 + 544 * m₀ ^ 2 * n ^ 8 + 336 * m₀ ^ 2 * n ^ 7 + 80 * m₀ ^ 2 *
      n ^ 6 - 4 * m₀ ^ 2 * n ^ 5 - 6 * m₀ ^ 2 * n ^ 4 - m₀ ^ 2 * n ^ 3 + 256 * n ^ 10 + 192 * n ^ 9
      + 160 * n ^ 8 + 224 * n ^ 7 + 176 * n ^ 6 + 92 * n ^ 5 + 34 * n ^ 4 + 8 * n ^ 3 + n ^ 2) * heb
  exact mul_left_cancel₀ (mul_ne_zero (pow_ne_zero 2 hn0) (pow_ne_zero 2 hs0)) (by
      linear_combination h)

/-- Linear form of `∂_L B_1` at the E/B node. -/
theorem ebNode_lin_dL_twist_one {n m₀ ℓ : ℂ}
    (hs0 : 2 * n + 1 ≠ 0)
    (heb : n * (2 * n + 1) * (m₀ ^ 2) ^ 2 + (4 * n ^ 2 + 2 * n + 1) * m₀ ^ 2 + n * (2 * n + 1) = 0)
    (hℓ : (2 * n + 1) * ℓ = (4 * n + 1) * (2 * n + 1) + 8 * n ^ 2 * m₀ ^ 2) :
    n ^ 3 * (2 * n + 1) ^ 3 * (2 * m₀ ^ 4 * ℓ + (-m₀ ^ 8 + m₀ ^ 6 + 2 * m₀ ^ 4 + m₀ ^ 2 - 1)) =
      64 * n ^ 7 + 32 * n ^ 6 + 16 * n ^ 5 + 28 * n ^ 4 + 20 * n ^ 3 + 7 * n ^ 2 + n + (64 * n ^ 7 +
      48 * n ^ 5 + 56 * n ^ 4 + 48 * n ^ 3 + 24 * n ^ 2 + 7 * n + 1) * m₀ ^ 2 := by
  have h : n ^ 3 * (2 * n + 1) ^ 4 * (2 * m₀ ^ 4 * ℓ + (-m₀ ^ 8 + m₀ ^ 6 + 2 * m₀ ^ 4 + m₀ ^ 2 -
      1)) =
      (2 * n + 1) * (64 * n ^ 7 + 32 * n ^ 6 + 16 * n ^ 5 + 28 * n ^ 4 + 20 * n ^ 3 + 7 * n ^ 2
          + n + (64 * n ^ 7 +
      48 * n ^ 5 + 56 * n ^ 4 + 48 * n ^ 3 + 24 * n ^ 2 + 7 * n + 1) * m₀ ^ 2) := by
    linear_combination (16 * m₀ ^ 4 * n ^ 6 + 24 * m₀ ^ 4 * n ^ 5 + 12 * m₀ ^ 4 * n ^ 4 + 2 *
      m₀ ^ 4 * n ^ 3) * hℓ + (-8 * m₀ ^ 4 * n ^ 5 - 12 * m₀ ^ 4 * n ^ 4 - 6 * m₀ ^ 4 * n ^ 3 -
      m₀ ^ 4 * n ^ 2 + 64 * m₀ ^ 2 * n ^ 6 + 88 * m₀ ^ 2 * n ^ 5 + 52 * m₀ ^ 2 * n ^ 4 + 22 * m₀ ^ 2
      * n ^ 3 + 7 * m₀ ^ 2 * n ^ 2 + m₀ ^ 2 * n - 64 * n ^ 6 - 40 * n ^ 5 - 28 * n ^ 4 - 34 * n ^ 3
      - 21 * n ^ 2 - 7 * n - 1) * heb
  exact mul_left_cancel₀ hs0 (by linear_combination h)

/-- Linear form of `∂_L Ẑ` at the E/B node. -/
theorem ebNode_lin_dL_zeta {n m₀ ℓ : ℂ}
    (hs0 : 2 * n + 1 ≠ 0)
    (heb : n * (2 * n + 1) * (m₀ ^ 2) ^ 2 + (4 * n ^ 2 + 2 * n + 1) * m₀ ^ 2 + n * (2 * n + 1) = 0)
    (hℓ : (2 * n + 1) * ℓ = (4 * n + 1) * (2 * n + 1) + 8 * n ^ 2 * m₀ ^ 2) :
    n ^ 3 * (2 * n + 1) ^ 3 * (2 * (m₀ ^ 4 + 1) * ℓ - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4 - 2 *
        m₀ ^ 2 + 1)) =
      128 * n ^ 7 + 160 * n ^ 6 + 112 * n ^ 5 + 64 * n ^ 4 + 28 * n ^ 3 + 8 * n ^ 2 + n + (128 *
      n ^ 7 + 96 * n ^ 6 + 112 * n ^ 5 + 96 * n ^ 4 + 68 * n ^ 3 + 30 * n ^ 2 + 8 * n + 1) *
          m₀ ^ 2 := by
  have h : n ^ 3 * (2 * n + 1) ^ 4 * (2 * (m₀ ^ 4 + 1) * ℓ - (m₀ ^ 8 - 2 * m₀ ^ 6 - 2 * m₀ ^ 4 -
      2 * m₀ ^ 2 + 1)) =
      (2 * n + 1) * (128 * n ^ 7 + 160 * n ^ 6 + 112 * n ^ 5 + 64 * n ^ 4 + 28 * n ^ 3 + 8 *
          n ^ 2 + n + (128 *
      n ^ 7 + 96 * n ^ 6 + 112 * n ^ 5 + 96 * n ^ 4 + 68 * n ^ 3 + 30 * n ^ 2 + 8 * n + 1) *
          m₀ ^ 2) := by
    linear_combination (16 * m₀ ^ 4 * n ^ 6 + 24 * m₀ ^ 4 * n ^ 5 + 12 * m₀ ^ 4 * n ^ 4 + 2 *
      m₀ ^ 4 * n ^ 3 + 16 * n ^ 6 + 24 * n ^ 5 + 12 * n ^ 4 + 2 * n ^ 3) * hℓ + (-8 * m₀ ^ 4 * n ^ 5
      - 12 * m₀ ^ 4 * n ^ 4 - 6 * m₀ ^ 4 * n ^ 3 - m₀ ^ 4 * n ^ 2 + 64 * m₀ ^ 2 * n ^ 6 + 96 *
      m₀ ^ 2 * n ^ 5 + 64 * m₀ ^ 2 * n ^ 4 + 28 * m₀ ^ 2 * n ^ 3 + 8 * m₀ ^ 2 * n ^ 2 + m₀ ^ 2 * n -
      64 * n ^ 6 - 56 * n ^ 5 - 52 * n ^ 4 - 50 * n ^ 3 - 27 * n ^ 2 - 8 * n - 1) * heb
  exact mul_left_cancel₀ hs0 (by linear_combination h)

