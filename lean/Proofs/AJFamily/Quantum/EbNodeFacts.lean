    n ^ 2 * (2 * n + 1) ^ 4 * (4 * m₀ ^ 2 * ℓ ^ 2 + (-8 * m₀ ^ 6 + 6 * m₀ ^ 4 + 8 * m₀ ^ 2 + 2)
