      m₀ ^ 2 + 2) * ℓ +
      4 * m₀ ^ 2) =
      n * (2 * n + 1) * (-1024 * n ^ 7 - 1472 * n ^ 6 - 640 * n ^ 5 - 192 * n ^ 4 - 96 * n ^ 3 -
          36 * n ^ 2 - 8 * n +
      (-1024 * n ^ 7 - 704 * n ^ 6 - 208 * n ^ 4 - 168 * n ^ 3 - 128 * n ^ 2 - 38 * n - 8) *
