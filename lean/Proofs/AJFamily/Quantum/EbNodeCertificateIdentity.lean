/-!
# E/B node: the certificate identity

`ebNode_certificate_identity` is the numerical identity of
`evalIntPoint_weylSymbol_famTransferOp_of_certificate` for `G = E`, `D = B_m`, `T = L - 1` at the
E/B node `(m₀, L₀)`, where `x₀ = m₀²` solves `m(2m + 1) x₀² + (4m² + 2m + 1) x₀ + m(2m + 1) = 0`,
`J₀ = ebNodeJ m` and `L₀ = ebNodeL m m₀`. All node values are reduced to linear forms in `x₀`
modulo the node quadratic.
-/

open Polynomial IntermediateField

noncomputable section

namespace AJConjecture

/-- `L - 1` at `(M, ℓ)`. -/
private theorem evalIntPoint_X_sub_one_ebCert (M ℓ : ℂ) :
    evalIntPoint (X - 1) M ℓ = ℓ - 1 := by
  rw [evalIntPoint_eq]
  simp [evalIntHomTwistNode]

/-- The target jet `famTargetJet (k + 2) x J w` times `w`, divided by `w ^ k` (with
`n = k + 2`). -/
private def famTargetJetRedEbCert (n x J w : ℂ) : ℂ :=
  let d : ℂ := 2 * n + 3
  let z₁ : ℂ := -8 * d * x ^ 2 - 4 * d * (1 + x) - 4 * d * x +
    J * (-8 * d * x + 4 * (d + 1) + 4 * x * (1 + x) + 4 * d * x * (1 + x) + 4 * d * x ^ 2) -
    (8 + 4 * d) * x * J ^ 2
  let s₁ : ℂ := -(16 * d - 4) * x ^ 2
  let A₀ : ℂ := (1 - J) * (x - J) * (1 - x * J)
  let zJ : ℂ := -1 - x ^ 2 + 2 * x * J
  x ^ 2 * ((n - 1) ^ 2 * w * z₁ - (n - 1) * (n - 2) * s₁) - 16 * d * x ^ 2 * (2 * w ^ 2) +
    4 * A₀ * x ^ 2 * ((n - 1) ^ 2 * ((n - 1) ^ 2 - 1) / 12) * zJ +
    x * (1 - J) * (n ^ 2 * w ^ 2 * z₁ - n * (n - 1) * w * s₁) +
    (4 * J - 8 * d * (1 - J)) * x * (2 * w ^ 3) +
    4 * A₀ * x * (-(n ^ 2 * w ^ 2) + n ^ 2 * (n ^ 2 - 1) / 12 * w * zJ * (1 - J)) -
    J * ((n + 1) ^ 2 * w ^ 3 * z₁ - (n + 1) * n * w ^ 2 * s₁) + 4 * J * (2 * w ^ 4) -
    4 * A₀ * ((n + 1) ^ 2 * w ^ 3 + (n + 1) ^ 2 * ((n + 1) ^ 2 - 1) / 12 * w ^ 2 * zJ * J)

/-- The target jet with the power `w ^ k` split off. -/
private theorem famTargetJet_mul_eq_ebCert (k : ℕ) (x J w : ℂ) :
    famTargetJet (k + 2) x J w * w = w ^ k * famTargetJetRedEbCert ((k + 2 : ℕ) : ℂ) x J w := by
  rcases k with _ | j
  · simp only [famTargetJet, famTargetJetRedEbCert]
    norm_num
    ring
  · simp only [famTargetJet, famTargetJetRedEbCert]
    simp only [show j + 1 + 2 - 1 = j + 2 by omega, show j + 1 + 2 - 2 = j + 1 by omega,
      show j + 1 + 2 + 1 - 1 = j + 3 by omega, show j + 1 + 2 + 1 - 2 = j + 2 by omega]
    push_cast
    ring

