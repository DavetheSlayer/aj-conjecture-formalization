    16 * n ^ 2) (he : n * (2 * n + 1) * e = 16 * n ^ 3 + 12 * n ^ 2 + 2 * n + (16 * n ^ 3 + 12 *
    n ^ 2 + 6 * n + 1) * m₀ ^ 2) (hf : (2 * n + 1) ^ 2 * f = 192 * n ^ 3 + 192 * n ^ 2 + 64 * n + 8
    + (192 * n ^ 3 + 64 * n ^ 2 + 16 * n) * m₀ ^ 2) (hp : n ^ 6 * (2 * n + 1) ^ 7 * p = (8 * n ^ 2 +
    4 * n + 1) * (10 * n ^ 2 + 5 * n + 1) * (384 * n ^ 10 + 128 * n ^ 9 + 192 * n ^ 8 + 272 * n ^ 7
