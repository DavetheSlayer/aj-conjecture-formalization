    896 * n ^ 8 + 96 * n ^ 7 - 352 * n ^ 6 - 168 * n ^ 5 - 168 * n ^ 4 - 70 * n ^ 3 - 29 * n ^ 2 - 6
    * n - 1) * m₀ ^ 2))
    (hx0 : m₀ ^ 2 ≠ 0) (hw : w = -(m₀ ^ 2) * (ℓ + m₀ ^ 2) ^ 2) (hXL : XL = ℓ - 1) (hEL : EL = e)
    (hEM : EM = m₀ * f) (hBL : BL = w ^ (m - 2) / 6 * p)
    (hBM : BM = w ^ (m - 2) / 6 * (m₀ * q)) :
    famTargetJet m (m₀ ^ 2) J (-(m₀ ^ 2)) *
        ((m₀ ^ 2 - 1) ^ (2 * m + 3) * ((m₀ ^ 2) ^ 2 - 1) ^ (2 * m + 3)) =
      famBasisGamma m (m₀ ^ 2) J * ((m₀ ^ 2 + 1) ^ 2 * (m₀ ^ 2 - 1)) * XL *
        (2 * c * ℓ ^ 2 * (EL * BL) - ℓ * m₀ * (EL * BM + EM * BL)) := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 2 := ⟨m - 2, by omega⟩
  rw [Nat.add_sub_cancel] at hBL hBM
  subst hnm hXL hEL hEM hBL hBM hw
  have hres := ebCert_residual_of_lin hn0 hs0 heb (ebCert_lin_jetRed hn0 hs0 heb hJ)
    (ebCert_lin_pow7 heb hℓ) (ebCert_lin_prefactor hn0 heb hℓ)
    (ebCert_lin_bracket hn0 heb hℓ (ebCert_lin_bracket_inner hn0 hs0 heb
      (ebCert_lin_cl heb hℓ hc) (ebCert_lin_ep heb he hp)
      (ebCert_lin_eqfp hn0 hs0 heb he hf hp hq)))
  have hF := famTargetJet_mul_eq_ebCert k (m₀ ^ 2) J (-(m₀ ^ 2))
  have hγ : famBasisGamma (k + 2) (m₀ ^ 2) J =
      -((m₀ ^ 2 - 1) ^ (2 * (k + 2) + 3) * (m₀ ^ 2 - J) ^ (2 * (k + 2) + 3)) := by
    rw [famBasisGamma, mul_pow, show 1 - m₀ ^ 2 = -(m₀ ^ 2 - 1) by ring,
      Odd.neg_pow ⟨k + 3, by ring⟩]
    ring
  have hsq : ((m₀ ^ 2) ^ 2 - 1) ^ (2 * (k + 2) + 3) = (m₀ ^ 2 - J) ^ (2 * (k + 2) + 3) *
      (((ℓ + m₀ ^ 2) ^ 2) ^ k * (ℓ + m₀ ^ 2) ^ 7) := by
    rw [← hprod, mul_pow, ← pow_mul, ← pow_add]
    ring_nf
  rw [hγ, hsq, mul_pow]
  generalize (m₀ ^ 2 - 1) ^ (2 * (k + 2) + 3) = P
  generalize (m₀ ^ 2 - J) ^ (2 * (k + 2) + 3) = A
  generalize ((ℓ + m₀ ^ 2) ^ 2) ^ k = B
  generalize (-(m₀ ^ 2)) ^ k = Y at hF ⊢
  have hx : -(m₀ ^ 2) ≠ 0 := neg_ne_zero.mpr hx0
  apply mul_left_cancel₀ hx
  linear_combination (P * A * B * (ℓ + m₀ ^ 2) ^ 7) * hF + (P * A * B * Y / 6) * hres

/-- The certificate identity at the E/B node. -/
theorem ebNode_certificate_identity (m : ℕ) (hm : 2 ≤ m) {m₀ : ℂ}
    (heb : (m : ℂ) * (2 * m + 1) * (m₀ ^ 2) ^ 2 + (4 * m ^ 2 + 2 * m + 1) * m₀ ^ 2 +
      m * (2 * m + 1) = 0) :
    famTargetJet m (m₀ ^ 2) (ebNodeJ m) (-(m₀ ^ 2)) *
        ((m₀ ^ 2 - 1) ^ (2 * m + 3) * ((m₀ ^ 2) ^ 2 - 1) ^ (2 * m + 3)) =
      famBasisGamma m (m₀ ^ 2) (ebNodeJ m) * ((m₀ ^ 2 + 1) ^ 2 * (m₀ ^ 2 - 1)) *
        evalIntPoint (X - 1) m₀ (ebNodeL m m₀) *
        (2 * famBasisJetC (m₀ ^ 2) (ebNodeJ m) * ebNodeL m m₀ ^ 2 *
            (evalIntPoint (derivative extraFactor) m₀ (ebNodeL m m₀) *
              evalIntPoint (derivative (twistPoly m)) m₀ (ebNodeL m m₀)) -
          ebNodeL m m₀ * m₀ *
            (evalIntPoint (derivative extraFactor) m₀ (ebNodeL m m₀) *
                evalIntPoint (coeffDerivative (twistPoly m)) m₀ (ebNodeL m m₀) +
              evalIntPoint (coeffDerivative extraFactor) m₀ (ebNodeL m m₀) *
                evalIntPoint (derivative (twistPoly m)) m₀ (ebNodeL m m₀))) := by
  have hn0 : (m : ℂ) ≠ 0 := by exact_mod_cast (by omega : m ≠ 0)
  have hs0 : 2 * (m : ℂ) + 1 ≠ 0 := by exact_mod_cast (by omega : 2 * m + 1 ≠ 0)
  obtain ⟨h0, h1, h2, hxJ, hxJ1, -, -, -, -, -, -, -⟩ := ebNode_facts m hm heb
  have hx0 : m₀ ^ 2 ≠ 0 := pow_ne_zero 2 h0
  have hJ : (2 * (m : ℂ) + 1) * ebNodeJ m = -(2 * m - 1) := by
    rw [ebNodeJ]
    field_simp
  have hJx : ebNodeJ m - m₀ ^ 2 ≠ 0 := sub_ne_zero.mpr (Ne.symm hxJ)
  have h1ℓ : (ebNodeJ m - m₀ ^ 2) * ebNodeL m m₀ = 1 - m₀ ^ 2 * ebNodeJ m := by
    rw [ebNodeL, famNodeL]
    field_simp
  have hc := famBasisJetC_ebCert hs0 heb hJ (sub_ne_zero.mpr hxJ)
    (sub_ne_zero.mpr (Ne.symm hxJ1))
  set ℓ := ebNodeL m m₀
  have hℓ : (2 * (m : ℂ) + 1) * ℓ = (4 * m + 1) * (2 * m + 1) + 8 * m ^ 2 * m₀ ^ 2 := by
    have h : (2 * (m : ℂ) + 1) * (ebNodeJ m - m₀ ^ 2) *
        ((2 * m + 1) * ℓ - ((4 * m + 1) * (2 * m + 1) + 8 * m ^ 2 * m₀ ^ 2)) = 0 := by
      linear_combination (2 * (m : ℂ) + 1) ^ 2 * h1ℓ + (-8 * (m : ℂ) ^ 2 * m₀ ^ 2 -
        8 * m ^ 2 - 2 * m * m₀ ^ 2 - 6 * m - m₀ ^ 2 - 1) * hJ + 8 * (m : ℂ) * heb
    linear_combination (mul_eq_zero.1 h).resolve_left (mul_ne_zero hs0 hJx)
  have hprod : (m₀ ^ 2 - ebNodeJ m) * (ℓ + m₀ ^ 2) = (m₀ ^ 2) ^ 2 - 1 := by
    linear_combination -h1ℓ
  have hℓx : ℓ + m₀ ^ 2 ≠ 0 := by
    intro h
    have h' : (m₀ ^ 2 - 1) * (m₀ ^ 2 + 1) = 0 := by
      linear_combination (m₀ ^ 2 - ebNodeJ m) * h - hprod
    rcases mul_eq_zero.1 h' with h' | h'
    · exact h1 (sub_eq_zero.1 h')
    · exact h2 (eq_neg_of_add_eq_zero_left h')
  have hZ : evalIntPoint zetaMoebiusM m₀ ℓ = -2 * m₀ ^ 2 * (ℓ + m₀ ^ 2) ^ 2 := by
    rw [evalIntPoint_zetaMoebiusM]
    linear_combination ebNode_vanish_zeta hn0 hs0 heb hℓ
  have hw : evalIntPoint zetaMoebiusM m₀ ℓ ≠ 0 := by
    rw [hZ]
    exact mul_ne_zero (mul_ne_zero (by norm_num) hx0) (pow_ne_zero 2 hℓx)
  have hdbl : evalIntPoint zetaMoebiusM m₀ ℓ ^ 2 = 4 * ((m₀ ^ 2) ^ 2 * (ℓ + m₀ ^ 2) ^ 4) := by
    rw [hZ]
    ring
  have hcrit : evalIntPoint zetaMoebiusM m₀ ℓ / 2 +
      (m : ℂ) * (evalIntPoint (twistPoly 1) m₀ ℓ - evalIntPoint zetaMoebiusM m₀ ℓ / 2) = 0 := by
    rw [evalIntPoint_zetaMoebiusM, evalIntPoint_twistPoly_one]
    linear_combination (1 / 2 : ℂ) * ebNode_vanish_crit hn0 hs0 heb hℓ
  have hw' := ebNode_lin_half_zeta hn0 hs0 heb hℓ
  rw [← evalIntPoint_zetaMoebiusM] at hw'
  have hz' := ebNode_lin_dL_twist_one hs0 heb hℓ
  rw [← evalIntPoint_derivative_twistPoly_one] at hz'
  have hα' := ebNode_lin_dL_zeta hs0 heb hℓ
  rw [← evalIntPoint_derivative_zetaMoebiusM] at hα'
  have hβ' := ebNode_lin_dL_twistCoeff heb hℓ
  rw [← evalIntPoint_derivative_twistCoeff] at hβ'
  have hzM := ebNode_lin_dM_twist_one hn0 hs0 heb hℓ
  have hαM := ebNode_lin_dM_zeta hn0 hs0 heb hℓ
  have hβM := ebNode_lin_dM_twistCoeff heb hℓ
  have hEL := ebNode_lin_dL_extra hs0 heb hℓ
  have hEM := ebNode_lin_dM_extra hn0 heb hℓ
  have hPL := ebNode_lin_PL hn0 hs0 heb hw' hz' hα' hβ'
  have hPM := ebNode_lin_PM hn0 hs0 heb hw' hzM hαM hβM
  obtain ⟨-, hBL, hBM⟩ := twistPoly_node_values hdbl hw m
  set w := evalIntPoint zetaMoebiusM m₀ ℓ / 2 with hwdef
  have hw2 : w ≠ 0 := div_ne_zero hw two_ne_zero
  rw [dblRootDeriv_eq_of_crit hm hw2 hcrit] at hBL hBM
  rw [evalIntPoint_coeffDerivative_twistPoly_one,
    evalIntPoint_coeffDerivative_zetaMoebiusM,
    evalIntPoint_coeffDerivative_twistCoeff] at hBM
  have hwv : w = -(m₀ ^ 2) * (ℓ + m₀ ^ 2) ^ 2 := by
    rw [hwdef, hZ]
    ring
  exact ebCert_assembly m hm rfl hn0 hs0 heb hJ hprod hℓ hc hEL hEM hPL hPM hx0 hwv
    (evalIntPoint_X_sub_one_ebCert _ _) (evalIntPoint_derivative_extraFactor _ _)
    (evalIntPoint_coeffDerivative_extraFactor _ _) hBL (by rw [hBM]; ring)

end AJConjecture
