/-- The basis-jet coefficient `c = 16n²/(2n+1)` at the E/B node. -/
private theorem famBasisJetC_ebCert {n x J : ℂ} (hs0 : 2 * n + 1 ≠ 0)
    (heb : n * (2 * n + 1) * x ^ 2 + (4 * n ^ 2 + 2 * n + 1) * x + n * (2 * n + 1) = 0)
    (hJ : (2 * n + 1) * J = -(2 * n - 1)) (hxJ : x - J ≠ 0) (hxJ1 : 1 - x * J ≠ 0) :
    (2 * n + 1) * famBasisJetC x J = 16 * n ^ 2 := by
  rw [famBasisJetC, div_add_div _ _ hxJ hxJ1, mul_div_assoc', div_eq_iff (mul_ne_zero hxJ hxJ1)]
  have h : (2 * n + 1) ^ 2 * ((2 * n + 1) * (2 * J * (1 - x * J) + (x - J) * 2) -
      16 * n ^ 2 * ((x - J) * (1 - x * J))) = 0 := by
    linear_combination (-32 * J * n ^ 3 * x - 24 * J * n ^ 2 * x - 8 * J * n * x - 2 * J * x +
      32 * n ^ 3 * x ^ 2 + 32 * n ^ 3 * x + 32 * n ^ 3 + 16 * n ^ 2 * x ^ 2 - 8 * n ^ 2 * x +
      16 * n ^ 2 - 2 * x) * hJ + (-32 * n ^ 2 + 16 * n) * heb
  linear_combination (mul_eq_zero.1 h).resolve_left (pow_ne_zero 2 hs0)

