import Mathlib

/-!
# Residues of powers of `L` modulo a monic right factor

For `R ∈ A[L; τ]` monic of degree `d`, every operator is congruent modulo the left ideal
`A[L; τ] R` to a unique operator of degree less than `d`. The objects below describe this
reduction by linear algebra, without Euclidean division.

* `oreCompanion R`: the companion matrix `C_R` of `R` (`d × d`): the subdiagonal is `1` and the
  last column is `-R.coeff k`.
* `oreResidue τ R m ∈ A^d`: the coordinates `ρ_m` of `L^m` modulo `R` in the basis
  `1, L, …, L^(d-1)`: `ρ_0 = e_0` and `ρ_(m+1) = C_R τ(ρ_m)`, because
  `L (∑ c_k L^k) = ∑ τ(c_k) L^(k+1)` and `L^d ≡ -∑_(k<d) R_k L^k`.
* `oreResidueClass τ R Q = ∑_m Q_m ρ_m`: the coordinates of `Q` modulo `R`.
* `oreResidueDet τ R t`: the determinant of the columns `ρ_(t 0), …, ρ_(t (d-1))`.
-/

open Polynomial

noncomputable section

namespace AJConjecture

/-- The companion matrix of `R`: `1` on the subdiagonal and `-R.coeff k` in the last column. -/
def oreCompanion {A : Type*} [CommRing A] (R : A[X]) :
    Matrix (Fin R.natDegree) (Fin R.natDegree) A :=
  Matrix.of fun k j ↦
    if (j : ℕ) + 1 = R.natDegree then -R.coeff k else if (k : ℕ) = j + 1 then 1 else 0

/-- The coordinates of `L^m` modulo the left ideal generated by `R` (for monic `R`):
`ρ_0 = e_0`, `ρ_(m+1) = C_R τ(ρ_m)`. -/
def oreResidue {A : Type*} [CommRing A] (τ : A →+* A) (R : A[X]) : ℕ → Fin R.natDegree → A
  | 0 => fun k ↦ if (k : ℕ) = 0 then 1 else 0
  | m + 1 => (oreCompanion R).mulVec fun k ↦ τ (oreResidue τ R m k)

/-- The coordinates `∑_m Q_m ρ_m` of an operator `Q` modulo the left ideal generated by `R`. -/
def oreResidueClass {A : Type*} [CommRing A] (τ : A →+* A) (R Q : A[X]) : Fin R.natDegree → A :=
  Q.sum fun m c ↦ c • oreResidue τ R m

/-- The determinant of the residues `ρ_(t i)`, `i < d`, as columns. -/
def oreResidueDet {A : Type*} [CommRing A] (τ : A →+* A) (R : A[X]) (t : Fin R.natDegree → ℕ) :
    A :=
  (Matrix.of fun k i ↦ oreResidue τ R (t i) k).det

end AJConjecture
