import Mathlib
import AJConjecture.QAlgCoboundaryOfSpan
import AJConjecture.QAlgOreCompanionDet
import AJConjecture.QAlgOreMulDegree
import AJConjecture.QAlgOreResidueClass
import AJConjecture.QAlgOreResidueDetShift
import AJConjecture.QAlgOreResidueSpan

/-!
# The constant term of a right factor is a unit times a coboundary

Let `O` be a unique factorisation domain with fraction field `F` and an automorphism `σ`, and
let `P` be monic with coefficients in `O` and constant coefficient a unit of `O`. If `R` is a
monic right factor of `P` in `F[L; σ]`, of degree `d`, then `R(0) = v σ(γ)/γ` with `v` a unit of
`O` and `γ ∈ O` nonzero.

Proof. Let `ρ_m ∈ F^d` be the coordinates of `L^m` modulo `R`, `Λ` the `O`-span of
`ρ_0, …, ρ_(n-1)` and `Φ(c) = C_R σ(c)` the action of `L`, `C_R` the companion matrix of `R`, of
determinant `±R(0)`. Because `P ∈ F[L; σ] R` has coefficients in `O` and unit constant
coefficient, `Φ(Λ) = Λ`. The `O`-module `𝔟` generated by the `d × d` minors of
`(ρ_0, …, ρ_(n-1))` contains `1` and satisfies `𝔟 = det(C_R) σ(𝔟)`. Write `𝔟 = γ⁻¹ 𝔠` with
`γ ∈ O` and `𝔠` an ideal whose elements have greatest common divisor `1`; then
`det(C_R) γ / σ(γ)` maps `σ(𝔠)` onto `𝔠`, both of greatest common divisor `1`, so it is a unit.

In the files: `oreResidueClass_oreMul` (the class of `P` is `0`), `oreResidueDet_val`
(`1 ∈ 𝔟`), `span_oreResidueDet_succ_eq` and `oreResidueDet_succ` (`𝔟 = det(C_R) τ(𝔟)` on
generators), `exists_unit_mul_coboundary_of_span_eq` (the UFD argument) and `det_oreCompanion`.
-/

open Polynomial

namespace AJConjecture

/-- The constant coefficient of a monic right factor, over the fraction field, of a monic
operator with integral coefficients and unit constant coefficient is a unit times `σ(γ)/γ`. -/
theorem exists_unit_mul_coboundary_of_oreMul_eq_map {O F : Type*} [CommRing O] [IsDomain O]
    [UniqueFactorizationMonoid O] [Field F] [Algebra O F] [IsFractionRing O F] (σ : O ≃+* O)
    (τ : F →+* F) (hτ : ∀ a : O, τ (algebraMap O F a) = algebraMap O F (σ a)) {P : O[X]}
    (hP : P.Monic) (hP0 : IsUnit (P.coeff 0)) {S R : F[X]} (hR : R.Monic)
    (h : oreMul τ S R = P.map (algebraMap O F)) :
    ∃ (v : Oˣ) (γ : O), γ ≠ 0 ∧ R.coeff 0 * algebraMap O F γ = algebraMap O F (v * σ γ) := by
  have hPm : (P.map (algebraMap O F)).Monic := hP.map _
  have hS : S ≠ 0 := by
    rintro rfl
    rw [oreMul_zero_left] at h
    exact hPm.ne_zero h.symm
  have hdeg : P.natDegree = S.natDegree + R.natDegree := by
    rw [← natDegree_oreMul τ.injective hS hR.ne_zero, h, hP.natDegree_map]
  have hres : oreResidueClass τ R (P.map (algebraMap O F)) = 0 := by
    rw [← h]
    exact oreResidueClass_oreMul τ hR S
  have h1 : (1 : F) ∈ Submodule.span O (Set.range fun s : Fin R.natDegree → Fin P.natDegree ↦
      oreResidueDet τ R fun i ↦ (s i : ℕ)) := by
    refine Submodule.subset_span ⟨fun i ↦ ⟨i, by omega⟩, ?_⟩
    exact oreResidueDet_val τ R
  have hspan := span_oreResidueDet_succ_eq τ hP hP0 R hres
  simp only [oreResidueDet_succ] at hspan
  obtain ⟨v, γ, hγ, hv⟩ := exists_unit_mul_coboundary_of_span_eq σ τ hτ _ _ h1 hspan
  rw [det_oreCompanion hR] at hv
  refine ⟨(-1) ^ R.natDegree * v, γ, hγ, ?_⟩
  have hsq : ((-1 : F) ^ R.natDegree) * (-1) ^ R.natDegree = 1 := by
    rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
  calc R.coeff 0 * algebraMap O F γ
      = (-1) ^ R.natDegree * ((-1) ^ R.natDegree * R.coeff 0 * algebraMap O F γ) := by
        rw [← mul_assoc, ← mul_assoc, hsq, one_mul]
    _ = algebraMap O F (((-1) ^ R.natDegree * v : Oˣ) * σ γ) := by
        rw [hv]
        simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one, map_mul,
          map_pow, map_neg, map_one]
        ring

end AJConjecture
