import Mathlib
import AJConjecture.QAlgDetSumSmul
import AJConjecture.QAlgOreResidue

/-!
# The module of minors of the residues is stable under the index shift

Let `P = ∑_(m ≤ n) a_m L^m` be monic of degree `n` over `O`, with `a_0` a unit, and let its
residue class modulo `R` be `0`: `∑_(m ≤ n) a_m ρ_m = 0`. Then
`ρ_n = -∑_(m<n) a_m ρ_m` and `ρ_0 = -a_0⁻¹ ∑_(1 ≤ m ≤ n) a_m ρ_m`, so the families
`(ρ_0, …, ρ_(n-1))` and `(ρ_1, …, ρ_n)` have the same `O`-span, each member of one being an
explicit `O`-combination of the other. By `det_sum_smul_eq_sum` the `O`-modules generated by
the determinants `det(ρ_(s i))` and `det(ρ_(s i + 1))`, `s : Fin d → Fin n`, are equal.
-/

open Polynomial

namespace AJConjecture

/-- Determinants of columns taken in a family `w'` whose members are combinations of a family
`w` lie in the span of the determinants of columns taken in `w`. -/
private theorem span_det_le_span_det_of_eq_sum {O F : Type*} [CommRing O] [CommRing F]
    [Algebra O F] {n ι ι' : Type*} [Fintype n] [DecidableEq n] [Fintype ι] (w : ι → n → F)
    (w' : ι' → n → F) (b : ι' → ι → O) (h : ∀ j', w' j' = ∑ j, b j' j • w j) :
    Submodule.span O (Set.range fun s : n → ι' ↦ (Matrix.of fun k i ↦ w' (s i) k).det) ≤
      Submodule.span O (Set.range fun s : n → ι ↦ (Matrix.of fun k i ↦ w (s i) k).det) := by
  rw [Submodule.span_le]
  rintro _ ⟨s, rfl⟩
  have hM : (Matrix.of fun k i ↦ w' (s i) k) = Matrix.of fun k i ↦ ∑ j, b (s i) j • w j k := by
    ext k i
    simp only [Matrix.of_apply, h (s i), Finset.sum_apply, Pi.smul_apply]
  change (Matrix.of fun k i ↦ w' (s i) k).det ∈ _
  rw [hM, det_sum_smul_eq_sum]
  exact Submodule.sum_mem _ fun s' _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨s', rfl⟩)

/-- The vanishing of the residue class of `P` as a relation between the residues `ρ_m`. -/
private theorem sum_range_coeff_smul_oreResidue_eq_zero {O F : Type*} [CommRing O] [CommRing F]
    [Algebra O F] (τ : F →+* F) (P : O[X]) (R : F[X])
    (hres : oreResidueClass τ R (P.map (algebraMap O F)) = 0) :
    ∑ m ∈ Finset.range (P.natDegree + 1), P.coeff m • oreResidue τ R m = 0 := by
  rw [← hres]
  unfold oreResidueClass
  rw [Polynomial.sum_over_range' (P.map (algebraMap O F)) (f := fun m c ↦ c • oreResidue τ R m)
    (fun m ↦ zero_smul _ _) (P.natDegree + 1) (Nat.lt_succ_of_le Polynomial.natDegree_map_le)]
  refine Finset.sum_congr rfl fun m _ ↦ ?_
  rw [Polynomial.coeff_map, algebraMap_smul]

/-- Each of `ρ_1, …, ρ_n` is an explicit combination of `ρ_0, …, ρ_(n-1)` when `P` is monic of
degree `n` with residue class `0`. -/
private theorem oreResidue_succ_eq_sum_smul {O F : Type*} [CommRing O] [CommRing F]
    [Algebra O F] (τ : F →+* F) {P : O[X]} (hP : P.Monic) (R : F[X])
    (hrel : ∑ m ∈ Finset.range (P.natDegree + 1), P.coeff m • oreResidue τ R m = 0)
    (j : Fin P.natDegree) :
    oreResidue τ R ((j : ℕ) + 1) = ∑ j' : Fin P.natDegree,
      (if (j : ℕ) + 1 = P.natDegree then -P.coeff j' else if (j' : ℕ) = j + 1 then 1 else 0) •
        oreResidue τ R j' := by
  by_cases h : (j : ℕ) + 1 = P.natDegree
  · simp only [h, ↓reduceIte]
    rw [Finset.sum_range_succ, hP.coeff_natDegree, one_smul] at hrel
    rw [Fin.sum_univ_eq_sum_range (fun m ↦ (-P.coeff m) • oreResidue τ R m)]
    simp only [neg_smul, Finset.sum_neg_distrib]
    exact eq_neg_of_add_eq_zero_right hrel
  · have hj : (j : ℕ) + 1 < P.natDegree := by have := j.isLt; omega
    simp only [h, ↓reduceIte]
    rw [Finset.sum_eq_single ⟨(j : ℕ) + 1, hj⟩]
    · simp
    · intro j' _ hj'
      have hne : (j' : ℕ) ≠ j + 1 := fun h' ↦ hj' (Fin.ext h')
      simp [hne]
    · intro h'
      exact absurd (Finset.mem_univ _) h'

/-- Each of `ρ_0, …, ρ_(n-1)` is an explicit combination of `ρ_1, …, ρ_n` when the constant
coefficient of `P` is invertible and `P` has residue class `0`. -/
private theorem oreResidue_eq_sum_smul_succ {O F : Type*} [CommRing O] [CommRing F]
    [Algebra O F] (τ : F →+* F) {P : O[X]} (u : O) (hu : u * P.coeff 0 = 1) (R : F[X])
    (hrel : ∑ m ∈ Finset.range (P.natDegree + 1), P.coeff m • oreResidue τ R m = 0)
    (j : Fin P.natDegree) :
    oreResidue τ R (j : ℕ) = ∑ j' : Fin P.natDegree,
      (if (j : ℕ) = 0 then -(u * P.coeff ((j' : ℕ) + 1)) else
        if (j' : ℕ) + 1 = j then 1 else 0) • oreResidue τ R ((j' : ℕ) + 1) := by
  by_cases h : (j : ℕ) = 0
  · simp only [h, ↓reduceIte]
    rw [Finset.sum_range_succ'] at hrel
    have h0 : P.coeff 0 • oreResidue τ R 0 =
        -∑ m ∈ Finset.range P.natDegree, P.coeff (m + 1) • oreResidue τ R (m + 1) :=
      eq_neg_of_add_eq_zero_right hrel
    rw [Fin.sum_univ_eq_sum_range (fun m ↦ (-(u * P.coeff (m + 1))) • oreResidue τ R (m + 1))]
    calc oreResidue τ R 0 = u • P.coeff 0 • oreResidue τ R 0 := by
          rw [← mul_smul, hu, one_smul]
      _ = _ := by
          rw [h0, smul_neg, Finset.smul_sum, ← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl fun m _ ↦ ?_
          rw [neg_smul, mul_smul]
  · have hj : (j : ℕ) - 1 < P.natDegree := by have := j.isLt; omega
    have hj1 : (j : ℕ) - 1 + 1 = j := by omega
    simp only [h, ↓reduceIte]
    rw [Finset.sum_eq_single ⟨(j : ℕ) - 1, hj⟩]
    · simp [hj1]
    · intro j' _ hj'
      have hne : (j' : ℕ) + 1 ≠ j := fun h' ↦ hj' (Fin.ext (by simp only; omega))
      simp [hne]
    · intro h'
      exact absurd (Finset.mem_univ _) h'

/-- The determinants of residues with indices in `1, …, n` and those with indices in
`0, …, n - 1` generate the same `O`-module, when the monic operator `P` of degree `n`, with
unit constant coefficient, has residue class `0`. -/
theorem span_oreResidueDet_succ_eq {O F : Type*} [CommRing O] [CommRing F] [Algebra O F]
    (τ : F →+* F) {P : O[X]} (hP : P.Monic) (hP0 : IsUnit (P.coeff 0)) (R : F[X])
    (hres : oreResidueClass τ R (P.map (algebraMap O F)) = 0) :
    Submodule.span O (Set.range fun s : Fin R.natDegree → Fin P.natDegree ↦
        oreResidueDet τ R fun i ↦ (s i : ℕ) + 1) =
      Submodule.span O (Set.range fun s : Fin R.natDegree → Fin P.natDegree ↦
        oreResidueDet τ R fun i ↦ (s i : ℕ)) := by
  obtain ⟨u, hu⟩ := hP0.exists_left_inv
  have hrel := sum_range_coeff_smul_oreResidue_eq_zero τ P R hres
  refine le_antisymm ?_ ?_
  · exact span_det_le_span_det_of_eq_sum (fun j : Fin P.natDegree ↦ oreResidue τ R (j : ℕ))
      (fun j : Fin P.natDegree ↦ oreResidue τ R ((j : ℕ) + 1)) _
      (oreResidue_succ_eq_sum_smul τ hP R hrel)
  · exact span_det_le_span_det_of_eq_sum (fun j : Fin P.natDegree ↦ oreResidue τ R ((j : ℕ) + 1))
      (fun j : Fin P.natDegree ↦ oreResidue τ R (j : ℕ)) _
      (oreResidue_eq_sum_smul_succ τ u hu R hrel)

end AJConjecture
