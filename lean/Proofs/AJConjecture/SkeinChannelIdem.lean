import Mathlib
import AJConjecture.SkeinTurnbackEigenBasic
import AJConjecture.SkeinTurnbackMinpoly

/-!
# The channel idempotents

`Q_n = (f ⊗ f) ∏_{m ≠ n} (D_1 - d_{1,m}) / (d_{1,n} - d_{1,m})` are the spectral idempotents of
`D_1`:
`D_1 Q_n = d_{1,n} Q_n`, `Q_n Q_{n'} = δ_{n n'} Q_n`, `∑_n Q_n = f ⊗ f`. All four statements are
Lagrange interpolation for the nodes `d_{1,0}, …, d_{1,c}`, which are distinct
(`AJConjecture.turnbackEigen_one_injective`), in the commutative algebra generated by `D_1` with
the unit `f ⊗ f`, modulo the relation `AJConjecture.twoBundleProj_mul_prod_turnback_sub`:
`(D_1 - d_{1,n}) Q_n` is a multiple of the full product; `Q_n Q_{n'}` for `n ≠ n'` contains the full
product; `∑_n L_n = 1` for the Lagrange basis polynomials (`Lagrange.sum_basis` after writing
`Q_n = (f ⊗ f) · aeval D_1 (Lagrange.basis …)`); and `Q_n² = Q_n` follows from the other three.
-/

namespace AJConjecture

open Polynomial in
/-- The image of a product over the elements of a list without repetitions. -/
private theorem aeval_prod_toFinset_channelIdem {K A : Type*} [Field K] [Ring A] [Algebra K A]
    (D : A) (l : List ℕ) (hl : l.Nodup) (f : ℕ → K[X]) :
    aeval D (∏ i ∈ l.toFinset, f i) = (l.map fun i ↦ aeval D (f i)).prod := by
  rw [List.prod_toFinset f hl, map_list_prod, List.map_map]
  rfl

open Polynomial in
/-- An element commuting with `D` commutes with the polynomials in `D`. -/
private theorem commute_aeval_channelIdem {K A : Type*} [Field K] [Ring A] [Algebra K A]
    (P D : A) (h : Commute P D) (p : K[X]) : Commute P (aeval D p) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add]
    exact hp.add_right hq
  | monomial n a =>
    rw [aeval_monomial]
    exact (Algebra.commute_algebraMap_right a P).mul_right (h.pow_right n)

open Polynomial in
/-- A polynomial in `D` acts on an eigenvector of `D` by its value at the eigenvalue. -/
private theorem aeval_mul_eq_eval_smul_channelIdem {K A : Type*} [Field K] [Ring A] [Algebra K A]
    (D Q : A) (d : K) (h : D * Q = d • Q) (p : K[X]) : aeval D p * Q = p.eval d • Q := by
  have hpow : ∀ n : ℕ, D ^ n * Q = d ^ n • Q := by
    intro n
    induction n with
    | zero => rw [pow_zero, pow_zero, one_mul, one_smul]
    | succ n ih => rw [pow_succ, mul_assoc, h, mul_smul_comm, ih, smul_smul, pow_succ']
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add, add_mul, hp, hq, eval_add, add_smul]
  | monomial n a =>
    rw [aeval_monomial, mul_assoc, hpow, eval_monomial, Algebra.algebraMap_eq_smul_one,
      smul_mul_assoc, one_mul, smul_smul]

open Polynomial in
/-- The Lagrange idempotents of an element `D` annihilated by the nodal polynomial are
eigenvectors of `D`. -/
private theorem mul_aeval_basis_channelIdem {K A : Type*} [Field K] [Ring A] [Algebra K A]
    (P D : A) (hPD : Commute P D) (s : Finset ℕ) (v : ℕ → K)
    (hrel : P * aeval D (Lagrange.nodal s v) = 0) (i : ℕ) (hi : i ∈ s) :
    D * (P * aeval D (Lagrange.basis s v i)) = v i • (P * aeval D (Lagrange.basis s v i)) := by
  have hpoly : X * Lagrange.basis s v i =
      C (v i) * Lagrange.basis s v i + C (Lagrange.nodalWeight s v i) * Lagrange.nodal s v := by
    rw [Lagrange.basis_eq_prod_sub_inv_mul_nodal_div hi, ← Lagrange.nodal_erase_eq_nodal_div hi,
      Lagrange.nodal_eq_mul_nodal_erase hi]
    ring
  have h1 : D * aeval D (Lagrange.basis s v i) = aeval D (X * Lagrange.basis s v i) := by
    rw [map_mul, aeval_X]
  rw [← mul_assoc, ← hPD.eq, mul_assoc, h1, hpoly, map_add, map_mul, map_mul, aeval_C, aeval_C,
    Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, smul_mul_assoc,
    smul_mul_assoc, one_mul, one_mul, mul_add, mul_smul_comm, mul_smul_comm, hrel, smul_zero,
    add_zero]

open Polynomial in
/-- The channel idempotent as a Lagrange basis polynomial in `D_1`. -/
private theorem channelIdem_eq_aeval_basis (c n : ℕ) :
    channelIdem c n = twoBundleProj c * aeval (turnback c 1)
      (Lagrange.basis (Finset.range (c + 1)) (claspAlgTurnbackEigen c 1) n) := by
  have hl : ((List.range (c + 1)).filter (· ≠ n)).Nodup := (List.nodup_range).filter _
  have hs : ((List.range (c + 1)).filter (· ≠ n)).toFinset = (Finset.range (c + 1)).erase n := by
    ext x
    simp only [List.mem_toFinset, List.mem_filter, List.mem_range, decide_eq_true_eq,
      Finset.mem_erase, Finset.mem_range]
    tauto
  rw [Lagrange.basis, ← hs, aeval_prod_toFinset_channelIdem _ _ hl, channelIdem]
  congr 2
  refine List.map_congr_left fun m _ ↦ ?_
  rw [Lagrange.basisDivisor, map_mul, aeval_C, map_sub, aeval_X, aeval_C,
    Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]

open Polynomial in
/-- The polynomial relation of `D_1` in terms of the nodal polynomial. -/
private theorem twoBundleProj_mul_aeval_nodal_channelIdem (c : ℕ) :
    twoBundleProj c * aeval (turnback c 1)
      (Lagrange.nodal (Finset.range (c + 1)) (claspAlgTurnbackEigen c 1)) = 0 := by
  have h := twoBundleProj_mul_prod_turnback_sub c
  rw [Lagrange.nodal, ← List.toFinset_range,
    aeval_prod_toFinset_channelIdem _ _ List.nodup_range]
  rw [← h]
  congr 2
  refine List.map_congr_left fun m _ ↦ ?_
  rw [map_sub, aeval_X, aeval_C, Algebra.algebraMap_eq_smul_one]

/-- `f ⊗ f` commutes with `D_1`. -/
private theorem commute_twoBundleProj_turnback_channelIdem (c : ℕ) :
    Commute (twoBundleProj c) (turnback c 1) :=
  (twoBundleProj_mul_turnback c 1).trans (turnback_mul_twoBundleProj c 1).symm

/-- The eigenvalues `d_{1,n}`, `n ≤ c`, are distinct. -/
private theorem injOn_turnbackEigen_channelIdem (c : ℕ) :
    Set.InjOn (claspAlgTurnbackEigen c 1) (Finset.range (c + 1) : Finset ℕ) := by
  intro x hx y hy h
  rw [Finset.mem_coe, Finset.mem_range] at hx hy
  exact turnbackEigen_one_injective c x y (by omega) (by omega) h

/-- `f ⊗ f` is a left unit for the channel idempotents. -/
theorem twoBundleProj_mul_channelIdem (c n : ℕ) :
    twoBundleProj c * channelIdem c n = channelIdem c n := by
  rw [channelIdem, ← Matrix.mul_assoc, twoBundleProj_mul_self]

/-- `f ⊗ f` is a right unit for the channel idempotents. -/
theorem channelIdem_mul_twoBundleProj (c n : ℕ) :
    channelIdem c n * twoBundleProj c = channelIdem c n := by
  rw [channelIdem_eq_aeval_basis, mul_assoc,
    ← (commute_aeval_channelIdem _ _ (commute_twoBundleProj_turnback_channelIdem c) _).eq,
    ← mul_assoc, twoBundleProj_mul_self]

/-- `D_1 Q_n = d_{1,n} Q_n`. -/
theorem turnback_one_mul_channelIdem (c n : ℕ) (hn : n ≤ c) :
    turnback c 1 * channelIdem c n = claspAlgTurnbackEigen c 1 n • channelIdem c n := by
  rw [channelIdem_eq_aeval_basis]
  exact mul_aeval_basis_channelIdem _ _ (commute_twoBundleProj_turnback_channelIdem c) _ _
    (twoBundleProj_mul_aeval_nodal_channelIdem c) n (Finset.mem_range.mpr (by omega))

/-- The channel idempotents are orthogonal idempotents. -/
theorem channelIdem_mul_channelIdem (c n n' : ℕ) (hn : n ≤ c) (hn' : n' ≤ c) :
    channelIdem c n * channelIdem c n' = if n = n' then channelIdem c n else 0 := by
  have h := aeval_mul_eq_eval_smul_channelIdem _ _ _ (turnback_one_mul_channelIdem c n' hn')
    (Lagrange.basis (Finset.range (c + 1)) (claspAlgTurnbackEigen c 1) n)
  rw [channelIdem_eq_aeval_basis c n, mul_assoc, h, mul_smul_comm, twoBundleProj_mul_channelIdem]
  split_ifs with hnn
  · subst hnn
    rw [Lagrange.eval_basis_self (injOn_turnbackEigen_channelIdem c)
      (Finset.mem_range.mpr (by omega)), one_smul, ← channelIdem_eq_aeval_basis]
  · rw [Lagrange.eval_basis_of_ne hnn (Finset.mem_range.mpr (by omega)), zero_smul]

/-- The channel idempotents sum to `f ⊗ f`. -/
theorem sum_channelIdem (c : ℕ) :
    ∑ n ∈ Finset.range (c + 1), channelIdem c n = twoBundleProj c := by
  simp only [channelIdem_eq_aeval_basis]
  rw [← Finset.mul_sum, ← map_sum, Lagrange.sum_basis (injOn_turnbackEigen_channelIdem c)
    ⟨0, Finset.mem_range.mpr (by omega)⟩, map_one, mul_one]

end AJConjecture
