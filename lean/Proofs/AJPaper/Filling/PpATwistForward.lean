import Mathlib
import AJFamily.Classical.FamilyPeripheralLongitude
import AJTwist.Classical.TwCRestrict
import AJTwist.Classical.TwCSatelliteDefs
import AJPaper.Filling.PpATwistKnot

/-!
# The pattern relations in the group of a twist knot (PpA, Section 7.6, claim 1; crux)

Source: arXiv:2611.24826v1, Section 7.2 (`classical.tex`, "A containing equation for a signed
filling"): in the filling `Z_(-k)` the axis meridian is the `k`-th power of the axis longitude,
`Y = W^k`; in the library's letters, the axis meridian is `t = c^ℓ` for the axis longitude `c`
of `Z_ℓ` (eq. (twistgluing): `λ_C ↦ μ_A λ_A^(-ℓ)`, and `λ_C = 1` for the unknot).

`ppa_twistPattern_of_fixed`: let `F` be a tuple fixed by the run of `ppaTwistBlocks ℓ` whose
orbit loop commutes with `μ = edgeMer F 0` (automatic for the tuple of a representation). With
`x = twcChainLoop 3 1 ℓ F` the loop of the chain and `c = x⁻¹`,

  `IsWhPattern μ (c ^ ℓ) c (orbitLoop F)`:

`c = compMer μ (c^(-ℓ) μ c^ℓ)` and the longitude is the outer word of the pattern. This is the
twisted satellite structure of `AJTwist.Classical.TwCSatelliteDefs` over the unknot, whose
"companion" is the cyclic group generated by `c`.

Route (the computation of `AJTwist.Classical.TwCOrbitSplit`, `TwCHopf`, `TwCPatternAlg` in
miniature: three old levels instead of `2c + 1`).
1. *Chain.* No block of the tail touches a new level, so the chain restores the new entries of
   `F` (`runTop_apply_of_ge`, as the private `runTop_twChain_new_twCLoops`); hence
   `prePr_runTop_twChain` (`M = 3`, `j₀ = 1`): the chain multiplies the chamber product of the
   level `1` by `x` and no other; and `twChain_detour`: the strand from the top position `1`
   runs through new positions to `0` collecting `x^(1-ℓ)`, the strand from `0` runs through the
   other new positions to `1` collecting `x^ℓ`, the position `2` is fixed with loop `1`.
2. *Gap relations.* All gap products of `F` are `1` (`prePr_runTop`, `gapProd_append`): at the
   level `1` the loop `y` of `σ_0⁻¹` is `x⁻¹ = c`; at the level `2` the loops `h₁`, `h₂` of the
   two Hopf letters satisfy `h₂ h₁ = 1`.
3. *Edge meridians.* Write `e_t = edgeMer F t` and `E = edgeMer` of the tuple above the chain.
   `edgeMer_runTop` with step 1: `E_0 = x^(1-ℓ)`-conjugate of `e_1`, `E_1 = x^ℓ`-conjugate of
   `e_0`, `E_2 = e_2`. The loops of the three letters of the tail in terms of edge meridians
   (the private `loop_neg_eq_edgeMer` of `FamilyPeripheralBlock`, and `SBlock.prePr_step`,
   `SBlock.edgeMer_step` for the tuples between them) give `h₁`, `y`, `h₂` as words in
   `E_0, E_1, E_2, x`; with step 2 these are the clasp relation `c = compMer μ (c^(-ℓ) μ c^ℓ)`.
4. *Orbit loop.* The strand map of the tail sends the top positions `0, 1, 2` to `2, 1, 0`, so
   the orbit of `0` is `0, 2, (new positions), 1, (new positions)`; `orbitLoop` is the product
   of `stLoop (chain ++ tail)` along it (`stLoop_append`, `stPerm_append`; the new positions
   contribute the two detour products of step 1, as in `twcOrbit_edges_twCOrbitSplit`). With
   steps 2–3 and `hcomm` this is the word `μ² t μ⁻¹ t⁻¹ μ (t⁻¹ μ t)⁻¹ μ⁻¹`, `t = c^ℓ`.
Suggested cut: (a) steps 1–2; (b) step 3 (the tail on three strands, a finite computation);
(c) step 4; (d) the group algebra (in the style of `twcPattern_neg`).

Checked numerically (`SCR/A/py/twistfwd.py`): on nonabelian `SL₂(ℂ)` representations of the
groups of `ppaTwistBlocks ℓ` found by least squares, independently of any construction, for
`ℓ ∈ {-3, -2, -1, 1, 2}` (three each): both relations to `10⁻¹⁰` with the library's longitude.
-/

namespace AJConjecture

variable {G : Type*} [Group G]

/-- The gap factor of a negative letter. -/
private theorem gapLoop_neg_ppaTwistForward {m : ℕ} (f : Fin m → G) (i n : ℕ) :
    (SBlock.neg i).gapLoop f n = if n = i + 1 then (SBlock.neg i).loop f else 1 := by
  simp only [SBlock.gapLoop, SBlock.lo, SBlock.hi]
  congr 1
  apply propext
  omega

/-- The chamber products above a negative letter. -/
private theorem prePr_step_neg_ppaTwistForward {m : ℕ} (i : ℕ) (hi : i + 1 < m) (f : Fin m → G)
    (n : ℕ) : prePr ((SBlock.neg i).step m f) n =
      if n = i + 1 then (SBlock.neg i).loop f * prePr f n else prePr f n := by
  rw [SBlock.prePr_step (SBlock.neg i) hi, gapLoop_neg_ppaTwistForward]
  by_cases h : n = i + 1
  · rw [ite_eq_left h, ite_eq_left h]
  · rw [ite_eq_right h, ite_eq_right h, one_mul]

/-- The strand loop of a negative letter. -/
private theorem strandLoop_neg_ppaTwistForward {m : ℕ} (f : Fin m → G) (i t : ℕ) :
    (SBlock.neg i).strandLoop f t = if t = i then (SBlock.neg i).loop f else 1 := by
  simp only [SBlock.strandLoop, SBlock.carries, decide_eq_true_eq]

/-- The strand map of a negative letter. -/
private theorem perm_neg_ppaTwistForward (i t : ℕ) :
    (SBlock.neg i).perm t = if t = i then i + 1 else if t = i + 1 then i else t := rfl

/-- The tail `σ_1⁻¹ σ_0⁻¹ σ_1⁻¹` on an arbitrary tuple: its three loops in terms of the chamber
products of the levels `1, 2, 3`, its gap factors and the loops collected by the strands. -/
private theorem tail_data_ppaTwistForward {m : ℕ} (hm : 3 ≤ m) (g : Fin m → G) :
    ∃ h₁ y h₂ : G,
      h₁ = prePr g 1 * (prePr g 2)⁻¹ * prePr g 3 * (prePr g 2)⁻¹ ∧
      y = (prePr g 1)⁻¹ * (h₁ * prePr g 2) * (prePr g 1)⁻¹ ∧
      h₂ = y * prePr g 1 * (h₁ * prePr g 2)⁻¹ * prePr g 3 * (h₁ * prePr g 2)⁻¹ ∧
      gapProd m ppaTwistTail g 1 = y ∧ gapProd m ppaTwistTail g 2 = h₂ * h₁ ∧
      stLoop m ppaTwistTail g 0 = y * h₁ ∧ stLoop m ppaTwistTail g 1 = h₂ ∧
      ∀ t, 2 ≤ t → stLoop m ppaTwistTail g t = 1 := by
  refine ⟨(SBlock.neg 1).loop g, (SBlock.neg 0).loop ((SBlock.neg 1).step m g),
    (SBlock.neg 1).loop ((SBlock.neg 0).step m ((SBlock.neg 1).step m g)), rfl, ?_, ?_, ?_, ?_,
    ?_, ?_, ?_⟩
  · rw [SBlock.loop, prePr_zero, prePr_step_neg_ppaTwistForward 1 (by omega),
      prePr_step_neg_ppaTwistForward 1 (by omega), ite_eq_right (by omega),
      ite_eq_left (by omega), one_mul]
  · rw [SBlock.loop, prePr_step_neg_ppaTwistForward 0 (by omega),
      prePr_step_neg_ppaTwistForward 0 (by omega), prePr_step_neg_ppaTwistForward 0 (by omega),
      prePr_step_neg_ppaTwistForward 1 (by omega), prePr_step_neg_ppaTwistForward 1 (by omega),
      prePr_step_neg_ppaTwistForward 1 (by omega)]
    simp only [show ¬((1 : ℕ) + 1 = 0 + 1) by omega, show ¬((1 : ℕ) + 2 = 0 + 1) by omega,
      show ¬((1 : ℕ) + 2 = 1 + 1) by omega, show ¬((1 : ℕ) = 1 + 1) by omega, ite_true, ite_false]
  · simp only [ppaTwistTail, gapProd, gapLoop_neg_ppaTwistForward]
    simp
  · simp only [ppaTwistTail, gapProd, gapLoop_neg_ppaTwistForward]
    simp
  · simp only [ppaTwistTail, stLoop, stPerm, strandLoop_neg_ppaTwistForward,
      perm_neg_ppaTwistForward]
    simp
  · simp only [ppaTwistTail, stLoop, stPerm, strandLoop_neg_ppaTwistForward,
      perm_neg_ppaTwistForward]
    simp
  · intro t ht
    simp only [ppaTwistTail, stLoop, stPerm, strandLoop_neg_ppaTwistForward,
      perm_neg_ppaTwistForward]
    obtain rfl | ht : t = 2 ∨ 3 ≤ t := by omega
    · simp
    · simp (disch := omega) only [ite_eq_right, mul_one]

/-- The strand map of the tail exchanges the positions `0` and `2`. -/
private theorem stPerm_ppaTwistTail_ppaTwistForward (t : ℕ) :
    stPerm ppaTwistTail t = if t = 0 then 2 else if t = 2 then 0 else t := by
  obtain rfl | rfl | rfl | ht : t = 0 ∨ t = 1 ∨ t = 2 ∨ 3 ≤ t := by omega
  · rfl
  · rfl
  · rfl
  · have h1 : (SBlock.neg 1).perm t = t := by
      simp only [SBlock.perm]
      split_ifs <;> omega
    have h0 : (SBlock.neg 0).perm t = t := by
      simp only [SBlock.perm]
      split_ifs <;> omega
    simp only [ppaTwistTail, stPerm, h1, h0]
    split_ifs <;> omega

/-- The orbit of `0` under a map `σ` that sends `0` to `2`, `2` to `c 0` and agrees with `c`
elsewhere, when `c` leads from `0` to `1` and from `1` on through positions `≥ 3`. -/
private theorem iterate_orbit_ppaTwistForward (c σ : ℕ → ℕ) (k₁ k₂ : ℕ) (hk₂ : 0 < k₂)
    (hσ0 : σ 0 = 2) (hσ1 : σ 1 = c 1) (hσ2 : σ 2 = c 0) (hσ : ∀ t, 3 ≤ t → σ t = c t)
    (h1 : ∀ i, 0 < i → i < k₁ → 3 ≤ c^[i] 1) (h2 : c^[k₂] 0 = 1)
    (h2' : ∀ i, 0 < i → i < k₂ → 3 ≤ c^[i] 0) :
    (∀ i, 0 < i → i ≤ k₂ → σ^[1 + i] 0 = c^[i] 0) ∧
      ∀ i, i ≤ k₁ → σ^[1 + k₂ + i] 0 = c^[i] 1 := by
  have hA : ∀ i, 0 < i → i ≤ k₂ → σ^[1 + i] 0 = c^[i] 0 := by
    intro i hi
    induction i, hi using Nat.le_induction with
    | base =>
      intro _
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_zero,
        id, hσ0, hσ2]
      rfl
    | succ i hi ih =>
      intro hik
      rw [← Nat.add_assoc, Function.iterate_succ_apply', ih (by omega),
        hσ _ (h2' i hi (by omega)), Function.iterate_succ_apply']
  refine ⟨hA, fun i ↦ ?_⟩
  induction i with
  | zero =>
    intro _
    rw [Nat.add_zero, hA k₂ hk₂ le_rfl, h2]
    rfl
  | succ i ih =>
    intro hik
    rw [← Nat.add_assoc, Function.iterate_succ_apply', ih (by omega),
      Function.iterate_succ_apply']
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · exact hσ1
    · exact hσ _ (h1 i hi (by omega))

/-- A product over `1 + k₂ + k₁` indices, split at `1` and at `1 + k₂`. -/
private theorem prod_range_split_ppaTwistForward (f : ℕ → G) (k₁ k₂ : ℕ) :
    ((List.range (1 + k₂ + k₁)).map f).prod =
      f 0 * ((List.range k₂).map fun i ↦ f (1 + i)).prod *
        ((List.range k₁).map fun i ↦ f (1 + k₂ + i)).prod := by
  rw [List.range_add, List.map_append, List.prod_append, List.range_add, List.map_append,
    List.prod_append, List.map_map, List.map_map]
  simp [Function.comp_def]

/-- A product whose first factor carries an extra factor on the left. -/
private theorem prod_range_head_ppaTwistForward (h : G) (f : ℕ → G) (k : ℕ) (hk : 0 < k) :
    ((List.range k).map fun i ↦ (if i = 0 then h else 1) * f i).prod =
      h * ((List.range k).map f).prod := by
  obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  rw [List.range_succ_eq_map, List.map_cons, List.prod_cons, List.map_cons, List.prod_cons,
    List.map_map, List.map_map]
  simp [Function.comp_def, mul_assoc]

/-- The product of the strand loops along the orbit of `0`: the two loops of the tail met at the
positions `0` and `1`, and the two detours through the chain. -/
private theorem orbit_prod_ppaTwistForward (m : ℕ) (σ c : ℕ → ℕ) (S SX : ℕ → G) (k₁ k₂ : ℕ)
    (y h₁ h₂ : G) (hm : m = 1 + k₂ + k₁) (hk₁ : 0 < k₁) (hk₂ : 0 < k₂)
    (hσ0 : σ 0 = 2) (hσ1 : σ 1 = c 1) (hσ2 : σ 2 = c 0) (hσ : ∀ t, 3 ≤ t → σ t = c t)
    (h1 : ∀ i, 0 < i → i < k₁ → 3 ≤ c^[i] 1) (h2 : c^[k₂] 0 = 1)
    (h2' : ∀ i, 0 < i → i < k₂ → 3 ≤ c^[i] 0)
    (hS0 : S 0 = y * h₁) (hS1 : S 1 = h₂ * SX 1) (hS2 : S 2 = SX 0)
    (hS : ∀ t, 3 ≤ t → S t = SX t) :
    ((List.range m).map fun j ↦ S (σ^[j] 0)).prod =
      y * h₁ * ((List.range k₂).map fun i ↦ SX (c^[i] 0)).prod *
        (h₂ * ((List.range k₁).map fun i ↦ SX (c^[i] 1)).prod) := by
  subst hm
  obtain ⟨hA, hB⟩ := iterate_orbit_ppaTwistForward c σ k₁ k₂ hk₂ hσ0 hσ1 hσ2 hσ h1 h2 h2'
  have hl1 : ((List.range k₂).map fun i ↦ S (σ^[1 + i] 0)) =
      (List.range k₂).map fun i ↦ SX (c^[i] 0) := by
    refine List.map_congr_left fun i hi ↦ ?_
    have hi' := List.mem_range.1 hi
    rcases Nat.eq_zero_or_pos i with rfl | hi0
    · rw [Nat.add_zero, Function.iterate_one, hσ0, hS2]
      rfl
    · rw [hA i hi0 hi'.le, hS _ (h2' i hi0 hi')]
  have hl2 : ((List.range k₁).map fun i ↦ S (σ^[1 + k₂ + i] 0)) =
      (List.range k₁).map fun i ↦ (if i = 0 then h₂ else 1) * SX (c^[i] 1) := by
    refine List.map_congr_left fun i hi ↦ ?_
    have hi' := List.mem_range.1 hi
    rw [hB i hi'.le]
    rcases Nat.eq_zero_or_pos i with rfl | hi0
    · rw [ite_eq_left rfl]
      exact hS1
    · rw [ite_eq_right (by omega), one_mul, hS _ (h1 i hi0 hi')]
  rw [prod_range_split_ppaTwistForward, hl1, hl2, prod_range_head_ppaTwistForward _ _ _ hk₁]
  exact congrArg (fun z ↦ z * _ * _) hS0

/-- Edge meridians along a path of the strand map: if every edge meridian above is the conjugate
of the edge meridian below at the image position, and the two agree at the positions `≥ 3`,
then along a path through such positions the conjugators multiply. -/
private theorem edge_iterate_ppaTwistForward (c : ℕ → ℕ) (S E e : ℕ → G) (m t₀ k : ℕ)
    (hlt : ∀ t, t < m → c t < m) (ht₀ : t₀ < m)
    (hE : ∀ t, t < m → E t = S t * e (c t) * (S t)⁻¹)
    (hEe : ∀ t, 3 ≤ t → t < m → e t = E t)
    (hpath : ∀ i, 0 < i → i < k → 3 ≤ c^[i] t₀) (hk : 0 < k) :
    E t₀ = ((List.range k).map fun i ↦ S (c^[i] t₀)).prod * e (c^[k] t₀) *
      (((List.range k).map fun i ↦ S (c^[i] t₀)).prod)⁻¹ := by
  have hlt' : ∀ i, c^[i] t₀ < m := by
    intro i
    induction i with
    | zero => exact ht₀
    | succ i ih =>
      rw [Function.iterate_succ_apply']
      exact hlt _ ih
  induction k, hk using Nat.le_induction with
  | base =>
    simp only [List.range_one, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
      mul_one, Function.iterate_zero, id, Function.iterate_one]
    exact hE t₀ ht₀
  | succ k hk ih =>
    rw [ih fun i h0 hi ↦ hpath i h0 (by omega), hEe _ (hpath k hk (by omega)) (hlt' k),
      hE _ (hlt' k), List.range_succ, List.map_append, List.prod_append, List.map_singleton,
      List.prod_singleton, Function.iterate_succ_apply']
    group

/-- The group algebra: from the loops of the tail, the two gap relations, the edge relation of
the chain and the orbit loop to the pattern relations. -/
private theorem pattern_algebra_ppaTwistForward (ℓ : ℤ) (μ x P2 P3 h₁ y h₂ l : G)
    (hh₁ : h₁ = x * μ * P2⁻¹ * P3 * P2⁻¹)
    (hy : y = (x * μ)⁻¹ * (h₁ * P2) * (x * μ)⁻¹)
    (hh₂ : h₂ = y * (x * μ) * (h₁ * P2)⁻¹ * P3 * (h₁ * P2)⁻¹)
    (hyx : y * x = 1) (hhh : h₂ * h₁ = 1)
    (hchain : P2 * (x * μ)⁻¹ = x ^ (1 - ℓ) * μ * (x ^ (1 - ℓ))⁻¹)
    (hl : l = y * h₁ * x ^ ℓ * (h₂ * x ^ (1 - ℓ)))
    (hcomm : l * μ = μ * l) : IsWhPattern μ (x⁻¹ ^ ℓ) x⁻¹ l := by
  have hy' : y = x⁻¹ := eq_inv_of_mul_eq_one_left hyx
  have hh₂' : h₂ = h₁⁻¹ := eq_inv_of_mul_eq_one_left hhh
  have hP2 : P2 = x ^ (1 - ℓ) * μ * x ^ ℓ * μ := by
    calc P2 = P2 * (x * μ)⁻¹ * (x * μ) := by group
      _ = _ := by rw [hchain]; group
  have hH : h₁ = x * μ * μ * P2⁻¹ := by
    have h : x⁻¹ = (x * μ)⁻¹ * (h₁ * P2) * (x * μ)⁻¹ := hy' ▸ hy
    calc h₁ = x * μ * ((x * μ)⁻¹ * (h₁ * P2) * (x * μ)⁻¹) * (x * μ) * P2⁻¹ := by group
      _ = _ := by rw [← h]; group
  have hP3 : P3 = x * μ * P2 := by
    have h := hh₂
    rw [hh₂', hy'] at h
    calc P3 = h₁ * P2 * μ⁻¹ * (x⁻¹ * (x * μ) * (h₁ * P2)⁻¹ * P3 * (h₁ * P2)⁻¹) * (h₁ * P2) := by
          group
      _ = h₁ * P2 * μ⁻¹ * h₁⁻¹ * (h₁ * P2) := by rw [← h]
      _ = h₁ * P2 * μ⁻¹ * P2 := by group
      _ = _ := by rw [hH]; group
  have hrel : x = P2 * μ * P2⁻¹ * μ⁻¹ := by
    have h := hh₁
    rw [hP3, hH] at h
    calc x = P2 * ((x * μ)⁻¹ * (x * μ * P2⁻¹ * (x * μ * P2) * P2⁻¹)) * μ⁻¹ := by group
      _ = P2 * ((x * μ)⁻¹ * (x * μ * μ * P2⁻¹)) * μ⁻¹ := by rw [← h]
      _ = _ := by group
  have hc : Commute l μ := hcomm
  refine ⟨?_, ?_⟩
  · rw [compMer]
    calc x⁻¹ = (μ * x ^ (1 - ℓ))⁻¹ * x⁻¹ * x * (μ * x ^ (1 - ℓ)) * x⁻¹ := by group
      _ = (μ * x ^ (1 - ℓ))⁻¹ * (P2 * μ * P2⁻¹ * μ⁻¹)⁻¹ * x * (μ * x ^ (1 - ℓ)) * x⁻¹ := by
          rw [← hrel]
      _ = _ := by rw [hP2]; group
  · have hE : l = μ * x⁻¹ ^ ℓ * μ⁻¹ * (x⁻¹ ^ ℓ)⁻¹ * μ * (x⁻¹ ^ ℓ)⁻¹ * μ⁻¹ * x⁻¹ ^ ℓ := by
      rw [hl, hy', hh₂', hH, hP2]
      group
    calc l = μ * l * μ⁻¹ := by rw [← hc.eq]; group
      _ = μ * (μ * x⁻¹ ^ ℓ * μ⁻¹ * (x⁻¹ ^ ℓ)⁻¹ * μ * (x⁻¹ ^ ℓ)⁻¹ * μ⁻¹ * x⁻¹ ^ ℓ) * μ⁻¹ := by
          rw [← hE]
      _ = _ := by rw [pow_two]; group

/-- The chain of the twist knot on a tuple whose new entries it restores: the chamber products
of the old levels above the chain, and the edge relation `e_1 x⁻¹ = x^(1-ℓ) e_0 x^(ℓ-1)` read
along the detour from the top position `1` to `0`. -/
private theorem chain_edge_ppaTwistForward (ℓ : ℤ) (F : Fin (3 + twExtra ℓ) → G)
    (hfix : ∀ k : Fin (3 + twExtra ℓ), 3 ≤ (k : ℕ) →
      runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F k = F k) :
    prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 1 = twcChainLoop 3 1 ℓ F * edgeMer F 0 ∧
      prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 2 = prePr F 2 ∧
      prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 3 = prePr F 3 ∧
      prePr F 2 * (twcChainLoop 3 1 ℓ F * edgeMer F 0)⁻¹ =
        twcChainLoop 3 1 ℓ F ^ (1 - ℓ) * edgeMer F 0 * (twcChainLoop 3 1 ℓ F ^ (1 - ℓ))⁻¹ := by
  have hvX : ∀ b ∈ twChain 3 1 ℓ, b.Valid (3 + twExtra ℓ) :=
    twChain_valid (by norm_num) (by norm_num) ℓ
  obtain ⟨-, k₁, k₂, hk₁, -, -, h1, h1', hp1, -⟩ :=
    twChain_detour (M := 3) (j₀ := 1) (by norm_num) (by norm_num) ℓ F hfix
  have hpre : ∀ n, n ≤ 3 → prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) n =
      if 1 ≤ n ∧ n ≤ 1 then twcChainLoop 3 1 ℓ F * prePr F n else prePr F n := fun n hn ↦
    prePr_runTop_twChain (by norm_num) (by norm_num) ℓ F hfix hn
  have hP1 : prePr F 1 = edgeMer F 0 := by rw [edgeMer, prePr_zero, inv_one, mul_one]
  have hQ1 := hpre 1 (by norm_num)
  have hQ2 := hpre 2 (by norm_num)
  have hQ3 := hpre 3 (by norm_num)
  rw [ite_eq_left (by norm_num), hP1] at hQ1
  rw [ite_eq_right (by norm_num)] at hQ2 hQ3
  have hnew : ∀ n, 3 ≤ n → n ≤ 3 + twExtra ℓ →
      prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) n = prePr F n := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => exact fun _ ↦ hQ3
    | succ n hn ih =>
      intro hm
      rw [prePr_succ _ n (by omega), prePr_succ F n (by omega), ih (by omega),
        hfix ⟨n, by omega⟩ hn]
  have hEe : ∀ t, 3 ≤ t → t < 3 + twExtra ℓ →
      edgeMer F t = edgeMer (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) t := by
    intro t ht htm
    rw [edgeMer, edgeMer, hnew t ht htm.le, hnew (t + 1) (by omega) (by omega)]
  have hE1 := edge_iterate_ppaTwistForward (stPerm (twChain 3 1 ℓ))
    (stLoop (3 + twExtra ℓ) (twChain 3 1 ℓ) F)
    (edgeMer (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F)) (edgeMer F) (3 + twExtra ℓ) 1 k₁
    (fun t ht ↦ stPerm_lt _ hvX t ht) (by omega) (fun t ht ↦ edgeMer_runTop _ hvX F t ht) hEe
    h1' hk₁
  rw [h1, hp1, show edgeMer (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 1 =
    prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 2 *
      (prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 1)⁻¹ from rfl, hQ2, hQ1] at hE1
  exact ⟨hQ1, hQ2, hQ3, hE1⟩

/-- The orbit loop of a tuple whose new entries the chain restores, in terms of the loops
collected in the tail by the strands at the top positions `0` and `1`. -/
private theorem orbitLoop_ppaTwistForward (ℓ : ℤ) (F : Fin (3 + twExtra ℓ) → G)
    (hfix : ∀ k : Fin (3 + twExtra ℓ), 3 ≤ (k : ℕ) →
      runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F k = F k) (y h₁ h₂ : G)
    (hS0 : stLoop (3 + twExtra ℓ) ppaTwistTail
      (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 0 = y * h₁)
    (hS1 : stLoop (3 + twExtra ℓ) ppaTwistTail
      (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) 1 = h₂)
    (hS2 : ∀ t, 2 ≤ t → stLoop (3 + twExtra ℓ) ppaTwistTail
      (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) t = 1) :
    orbitLoop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F =
      y * h₁ * twcChainLoop 3 1 ℓ F ^ ℓ * (h₂ * twcChainLoop 3 1 ℓ F ^ (1 - ℓ)) := by
  obtain ⟨hold, k₁, k₂, hk₁, hk₂, hk, -, h1', hp1, h2, h2', hp2, -⟩ :=
    twChain_detour (M := 3) (j₀ := 1) (by norm_num) (by norm_num) ℓ F hfix
  obtain ⟨hc2, hX2⟩ := hold 2 (by norm_num) (by norm_num) (by norm_num)
  rw [ite_eq_right (by norm_num)] at hX2
  have hσ : ∀ t, stPerm (ppaTwistBlocks ℓ) t =
      stPerm (twChain 3 1 ℓ) (if t = 0 then 2 else if t = 2 then 0 else t) := fun t ↦ by
    rw [ppaTwistBlocks, stPerm_append, stPerm_ppaTwistTail_ppaTwistForward]
  have hS : ∀ t, stLoop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F t =
      stLoop (3 + twExtra ℓ) ppaTwistTail (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) t *
        stLoop (3 + twExtra ℓ) (twChain 3 1 ℓ) F (if t = 0 then 2 else if t = 2 then 0 else t) :=
    fun t ↦ by rw [ppaTwistBlocks, stLoop_append, stPerm_ppaTwistTail_ppaTwistForward]
  have hl := orbit_prod_ppaTwistForward (3 + twExtra ℓ) (stPerm (ppaTwistBlocks ℓ))
    (stPerm (twChain 3 1 ℓ)) (stLoop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F)
    (stLoop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) k₁ k₂ y h₁ h₂ (by omega) hk₁ hk₂
    (by rw [hσ, ite_eq_left rfl, hc2])
    (by rw [hσ, ite_eq_right (by norm_num), ite_eq_right (by norm_num)])
    (by rw [hσ, ite_eq_right (by norm_num), ite_eq_left rfl])
    (fun t ht ↦ by rw [hσ, ite_eq_right (by omega), ite_eq_right (by omega)]) h1' h2 h2'
    (by rw [hS, ite_eq_left rfl, hS0, hX2, mul_one])
    (by rw [hS, ite_eq_right (by norm_num), ite_eq_right (by norm_num), hS1])
    (by rw [hS, ite_eq_right (by norm_num), ite_eq_left rfl, hS2 2 le_rfl, one_mul])
    (fun t ht ↦ by
      rw [hS, ite_eq_right (by omega), ite_eq_right (by omega), hS2 t (by omega), one_mul])
  rw [hp1, hp2] at hl
  exact hl

/-- A fixed tuple of the block list of the twist knot `Z_ℓ` satisfies the pattern relations
with axis longitude `c`, the inverse of the loop of the chain, and axis meridian `c ^ ℓ`. -/
theorem ppa_twistPattern_of_fixed (ℓ : ℤ) (F : Fin (3 + twExtra ℓ) → G)
    (hF : runTop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F = F)
    (hcomm : orbitLoop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F * edgeMer F 0 =
      edgeMer F 0 * orbitLoop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F) :
    IsWhPattern (edgeMer F 0) ((twcChainLoop 3 1 ℓ F)⁻¹ ^ ℓ) (twcChainLoop 3 1 ℓ F)⁻¹
      (orbitLoop (3 + twExtra ℓ) (ppaTwistBlocks ℓ) F) := by
  have hvX : ∀ b ∈ twChain 3 1 ℓ, b.Valid (3 + twExtra ℓ) :=
    twChain_valid (by norm_num) (by norm_num) ℓ
  have hvT3 : ∀ b ∈ ppaTwistTail, b.Valid 3 := by
    intro b hb
    simp only [ppaTwistTail, List.mem_cons, List.not_mem_nil, or_false] at hb
    rcases hb with rfl | rfl | rfl <;> simp only [SBlock.Valid] <;> omega
  have hvT : ∀ b ∈ ppaTwistTail, b.Valid (3 + twExtra ℓ) := fun b hb ↦
    ppaTwistBlocks_valid ℓ b (List.mem_append_right _ hb)
  have hTg : runTop (3 + twExtra ℓ) ppaTwistTail
      (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) = F := by
    rw [← runTop_append]
    exact hF
  have hfix : ∀ k : Fin (3 + twExtra ℓ), 3 ≤ (k : ℕ) →
      runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F k = F k := by
    intro k hk
    have h1 := runTop_apply_of_ge (Nat.le_add_right 3 (twExtra ℓ)) ppaTwistTail hvT3
      (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) k hk
    rw [hTg] at h1
    exact h1.symm
  obtain ⟨hQ1, hQ2, hQ3, hE1⟩ := chain_edge_ppaTwistForward ℓ F hfix
  obtain ⟨h₁, y, h₂, hh₁, hy, hh₂, hg1, hg2, hS0, hS1, hS2⟩ :=
    tail_data_ppaTwistForward (Nat.le_add_right 3 (twExtra ℓ))
      (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F)
  rw [hQ1, hQ2, hQ3] at hh₁ hh₂
  rw [hQ1, hQ2] at hy
  have hgF : ∀ n, prePr F n =
      gapProd (3 + twExtra ℓ) ppaTwistTail (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) n *
        prePr (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) n := fun n ↦ by
    have h := prePr_runTop ppaTwistTail hvT (runTop (3 + twExtra ℓ) (twChain 3 1 ℓ) F) n
    rwa [hTg] at h
  have hP1 : prePr F 1 = edgeMer F 0 := by rw [edgeMer, prePr_zero, inv_one, mul_one]
  have hyx : y * twcChainLoop 3 1 ℓ F = 1 := by
    have h := hgF 1
    rw [hg1, hQ1, hP1, ← mul_assoc] at h
    exact mul_eq_right.1 h.symm
  have hhh : h₂ * h₁ = 1 := by
    have h := hgF 2
    rw [hg2, hQ2] at h
    exact mul_eq_right.1 h.symm
  exact pattern_algebra_ppaTwistForward ℓ (edgeMer F 0) (twcChainLoop 3 1 ℓ F) (prePr F 2)
    (prePr F 3) h₁ y h₂ _ hh₁ hy hh₂ hyx hhh hE1
    (orbitLoop_ppaTwistForward ℓ F hfix y h₁ h₂ hS0 hS1 hS2) hcomm

end AJConjecture
