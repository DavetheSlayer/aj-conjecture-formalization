import Mathlib
import AJPaper.Ideal.PpIConjectures
import AJPaper.Ideal.PpITau

/-!
# Separation of the radicals at one point (Unit PpI, node `PpI_Separate`)

Source: Section 8.5 of the paper (`conclusion.tex`): "The image of the generic point is
therefore outside the classical boundary-character image closure … It lies in the specialized
invariant recurrence zero set. This separates the zero sets and hence the radicals in the two
stated formulations."

Let `p = (M, L)`, `M, L ≠ 0`, be outside the Zariski closure of the eigenvalue set of `K`, and
suppose the specialization of every element of the recurrence ideal vanishes at `p`.

* `ppi_exists_separating_invariant`: there is `g ∈ 𝔱^σ` vanishing on the eigenvalue set with
  `g(p) ≠ 0`. Route: `p⁻¹` is outside the closure too (`zariskiClosure_eigenvalueSet_symm`);
  take polynomials `F₁`, `F₂` vanishing on the eigenvalue set with `F₁(p) ≠ 0`,
  `F₂(p⁻¹) ≠ 0`, a combination `F = F₁ + c F₂` with `F(p) ≠ 0 ≠ F(p⁻¹)` (two values of `c`
  are excluded), and `g = F · σ(F)` in `𝔱` (`ppiOfPoly`, `ppiEval_mul`, `ppiEval_ppiSigma`,
  `eigenvalueSet_symm`).
* `ppi_eval_eq_zero_of_mem_radical`: every element of the radical of the ideal of `𝔱^σ`
  generated by `ε(𝒜_K^σ)` vanishes at `p` (`Submodule.span_induction`, `ppiEval_mul`).
* `ppiSikoraSet_subset`: Sikora's set is contained in Tran's.
* `not_ppiTranConjecture_of_point`, `not_ppiSikoraConjecture_of_point`: both formulations fail
  for `K`.
-/

open Polynomial

noncomputable section

namespace AJConjecture

/-- The involution `σ` of the torus algebra is an involution. -/
private theorem ppiSigma_ppiSigma_ppiSeparate (g : PpiTorus) : ppiSigma (ppiSigma g) = g := by
  induction g using AddMonoidAlgebra.induction_linear with
  | zero => rw [map_zero, map_zero]
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | single m c =>
    rw [ppiSigma, AddMonoidAlgebra.domCongr_single, AddMonoidAlgebra.domCongr_single,
      AddEquiv.neg_apply, AddEquiv.neg_apply, neg_neg]

/-- A polynomial vanishing on the eigenvalue set and at neither `p` nor its inverse. -/
private theorem exists_poly_ne_zero_ppiSeparate {K : BraidKnot} {p : ℂ × ℂ} (h1 : p.1 ≠ 0)
    (h2 : p.2 ≠ 0) (hp : p ∉ zariskiClosure (eigenvalueSet K)) :
    ∃ F : ℂ[X][X], (∀ q ∈ eigenvalueSet K, evalPoint F q = 0) ∧ evalPoint F p ≠ 0 ∧
      evalPoint F (p.1⁻¹, p.2⁻¹) ≠ 0 := by
  have hp' : (p.1⁻¹, p.2⁻¹) ∉ zariskiClosure (eigenvalueSet K) := fun hinv ↦ hp <| by
    have h3 := zariskiClosure_eigenvalueSet_symm K (p := (p.1⁻¹, p.2⁻¹)) (inv_ne_zero h1)
      (inv_ne_zero h2) hinv
    rwa [inv_inv, inv_inv] at h3
  have hq : ¬ ∀ P : ℂ[X][X], (∀ q ∈ eigenvalueSet K, evalPoint P q = 0) → evalPoint P p = 0 := hp
  have hq' : ¬ ∀ P : ℂ[X][X], (∀ q ∈ eigenvalueSet K, evalPoint P q = 0) →
      evalPoint P (p.1⁻¹, p.2⁻¹) = 0 := hp'
  push Not at hq hq'
  obtain ⟨F₁, hF₁, hne₁⟩ := hq
  obtain ⟨F₂, hF₂, hne₂⟩ := hq'
  by_cases c1 : evalPoint F₁ (p.1⁻¹, p.2⁻¹) = 0
  · by_cases c2 : evalPoint F₂ p = 0
    · refine ⟨F₁ + F₂, fun q hq ↦ ?_, ?_, ?_⟩
      · have e1 := hF₁ q hq
        have e2 := hF₂ q hq
        rw [evalPoint] at e1 e2 ⊢
        rw [eval₂_add, e1, e2, add_zero]
      · rw [evalPoint] at c2 hne₁ ⊢
        rwa [eval₂_add, c2, add_zero]
      · rw [evalPoint] at c1 hne₂ ⊢
        rwa [eval₂_add, c1, zero_add]
    · exact ⟨F₂, hF₂, c2, hne₂⟩
  · exact ⟨F₁, hF₁, hne₁, c1⟩

/-- The evaluation at a point with nonzero coordinates, as a ring homomorphism on the
invariant subalgebra. -/
private def ppiEvalHomSeparate {p : ℂ × ℂ} (h1 : p.1 ≠ 0) (h2 : p.2 ≠ 0) :
    ppiInvariants →+* ℂ where
  toFun g := ppiEval p (g : PpiTorus)
  map_one' := ppiEval_one p
  map_mul' x y := ppiEval_mul h1 h2 x y
  map_zero' := by
    change ppiEval p 0 = 0
    rw [ppiEval, AddMonoidAlgebra.coeff_zero, Finsupp.sum_zero_index]
  map_add' x y := ppiEval_add p x y

/-- An invariant function vanishing on the eigenvalue set and not at `p`. -/
theorem ppi_exists_separating_invariant {K : BraidKnot} {p : ℂ × ℂ} (h1 : p.1 ≠ 0)
    (h2 : p.2 ≠ 0) (hp : p ∉ zariskiClosure (eigenvalueSet K)) :
    ∃ g : ppiInvariants, g ∈ ppiAIdealSet K ∧ ppiEval p (g : PpiTorus) ≠ 0 := by
  obtain ⟨F, hF, hne, hne'⟩ := exists_poly_ne_zero_ppiSeparate h1 h2 hp
  have hmem : ppiOfPoly F * ppiSigma (ppiOfPoly F) ∈ ppiInvariants := by
    rw [ppiInvariants, AlgHom.mem_equalizer]
    change ppiSigma (ppiOfPoly F * ppiSigma (ppiOfPoly F)) = ppiOfPoly F * ppiSigma (ppiOfPoly F)
    rw [map_mul, ppiSigma_ppiSigma_ppiSeparate, mul_comm]
  refine ⟨⟨_, hmem⟩, fun q hq ↦ ?_, ?_⟩
  · change ppiEval q (ppiOfPoly F * ppiSigma (ppiOfPoly F)) = 0
    rw [ppiEval_mul (fst_ne_zero_of_mem_eigenvalueSet hq) (snd_ne_zero_of_mem_eigenvalueSet hq),
      ppiEval_ppiOfPoly, hF q hq, zero_mul]
  · change ppiEval p (ppiOfPoly F * ppiSigma (ppiOfPoly F)) ≠ 0
    rw [ppiEval_mul h1 h2, ppiEval_ppiSigma, ppiEval_ppiOfPoly, ppiEval_ppiOfPoly]
    exact mul_ne_zero hne hne'

/-- The elements of the radical of the ideal generated by `ε(𝒜_K^σ)` vanish wherever all
specialized annihilators vanish. -/
theorem ppi_eval_eq_zero_of_mem_radical {K : BraidKnot} {p : ℂ × ℂ} (h1 : p.1 ≠ 0)
    (h2 : p.2 ≠ 0)
    (hvan : ∀ P : PpiOp ℂ, PpiAnnihilates P K → ppiEval p (ppiEps P) = 0)
    {g : ppiInvariants} (hg : g ∈ (Ideal.span (ppiTranSet K)).radical) :
    ppiEval p (g : PpiTorus) = 0 := by
  have hle : Ideal.span (ppiTranSet K) ≤ RingHom.ker (ppiEvalHomSeparate h1 h2) := by
    refine Ideal.span_le.mpr fun x hx ↦ ?_
    obtain ⟨P, hP, -, hε⟩ := hx
    rw [SetLike.mem_coe, RingHom.mem_ker]
    change ppiEval p (x : PpiTorus) = 0
    rw [← hε]
    exact hvan P hP
  exact RingHom.mem_ker.mp
    (((RingHom.ker_isPrime (ppiEvalHomSeparate h1 h2)).radical_le_iff).mpr hle hg)

/-- Sikora's operators (coefficients in `ℂ[t^{±2}]`) are among Tran's. -/
theorem ppiSikoraSet_subset (K : BraidKnot) : ppiSikoraSet K ⊆ ppiTranSet K :=
  fun _ ⟨P, hP, _, hσ, hε⟩ ↦ ⟨P, hP, hσ, hε⟩

/-- The `t = -1` ideal formulation (Tran's Conjecture 2) fails for a knot with a point as
above. -/
theorem not_ppiTranConjecture_of_point {K : BraidKnot} {p : ℂ × ℂ} (h1 : p.1 ≠ 0)
    (h2 : p.2 ≠ 0) (hp : p ∉ zariskiClosure (eigenvalueSet K))
    (hvan : ∀ P : PpiOp ℂ, PpiAnnihilates P K → ppiEval p (ppiEps P) = 0) :
    ¬ PpiTranConjecture K := by
  intro hconj
  obtain ⟨g, hg, hne⟩ := ppi_exists_separating_invariant h1 h2 hp
  rw [PpiTranConjecture] at hconj
  rw [← hconj] at hg
  exact hne (ppi_eval_eq_zero_of_mem_radical h1 h2 hvan hg)

/-- Sikora's `sl₂` formulation (Conjecture 9, `G = SL(2, ℂ)`) fails for a knot with a point as
above. -/
theorem not_ppiSikoraConjecture_of_point {K : BraidKnot} {p : ℂ × ℂ} (h1 : p.1 ≠ 0)
    (h2 : p.2 ≠ 0) (hp : p ∉ zariskiClosure (eigenvalueSet K))
    (hvan : ∀ P : PpiOp ℂ, PpiAnnihilates P K → ppiEval p (ppiEps P) = 0) :
    ¬ PpiSikoraConjecture K := by
  intro hconj
  obtain ⟨g, hg, hne⟩ := ppi_exists_separating_invariant h1 h2 hp
  rw [PpiSikoraConjecture] at hconj
  rw [← hconj] at hg
  exact hne (ppi_eval_eq_zero_of_mem_radical h1 h2 hvan
    (Ideal.radical_mono (Ideal.span_mono (ppiSikoraSet_subset K)) hg))

end AJConjecture
