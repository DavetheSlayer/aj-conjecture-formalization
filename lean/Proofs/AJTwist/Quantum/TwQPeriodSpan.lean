import Mathlib
import AJTwist.Quantum.TwQGaussForcing
import AJTwist.Quantum.TwQSymbolFacts

/-!
# `P_a F` lies in the left module generated by the Gaussian periods (Unit Q4)

Source: revision 5, Section 6.3, eq. (finite-U): "in each case `P_a F` belongs to the left
`𝔻`-module generated by the … periods `𝒰_ℓ = ∑_c 𝔻 G_c^{(ℓ)}`".

`twQ_transfer_mem_periodSpan` is this membership in the form used by the selection package
(the predicate `TwsInSpan` of `AJTwist/Select/TwSGrowthClass.lean`, unfolded): a nonzero
coefficient `δ ∈ ℤ[t][M]`, a finite set `S` of indices and recurrence operators `D_c` such that
on a tail `n ≥ n₀` (one can take `n₀ = 1`)
`δ(t, t^(2n)) (P_a F)(n) = ∑_{c ∈ S} (D_c G_c^{(ℓ)})(n)`.
It follows from `twQ_gaussForcing`: `δ = t^(4E) (t⁴ - 1)` clears the denominator `q^{±1} - 1` of
the `c_i` and the negative powers of `q`; `D_c` is the sum, over the pairs `(i, z)` with
`p_i - z = c`, of a signed monomial in `t` and `M` times `twWeightOp d z`; the index set is
`S = {p_i, p_i - 1}`.

`twQ_transfer_main` packages what the selection needs about `P_a` and `F`: `P_a ≠ 0` and the
membership.
-/

open Polynomial

noncomputable section

namespace AJConjecture

/-- The action on sequences is additive in the operator. -/
private theorem opApplyField_finsetSum_left_periodSpan {ι : Type*} (s : Finset ι)
    (P : ι → RecOp) (f : ℤ → RatFunc ℚ) (n : ℤ) :
    opApplyField (∑ k ∈ s, P k) f n = ∑ k ∈ s, opApplyField (P k) f n := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.sum_empty, opApplyField, sum_zero_index]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, opApplyField_add_left, ih]

/-- Collecting the operators that act on the same member of a family of sequences. -/
private theorem sum_opApplyField_fiberwise_periodSpan {ι : Type*} [Fintype ι] (idx : ι → ℤ)
    (A : ι → RecOp) (G : ℤ → ℤ → RatFunc ℚ) (n : ℤ) :
    ∑ c ∈ Finset.univ.image idx,
        opApplyField (∑ x ∈ Finset.univ.filter (fun x ↦ idx x = c), A x) (G c) n =
      ∑ x, opApplyField (A x) (G (idx x)) n := by
  simp only [opApplyField_finsetSum_left_periodSpan]
  rw [← Finset.sum_fiberwise_of_maps_to (s := Finset.univ) (t := Finset.univ.image idx)
    (g := idx) (fun x _ ↦ Finset.mem_image_of_mem idx (Finset.mem_univ x))]
  refine Finset.sum_congr rfl fun c _ ↦ Finset.sum_congr rfl fun x hx ↦ ?_
  rw [(Finset.mem_filter.mp hx).2]

/-- `q - 1` is a signed power of `q` times the denominator `q^η - 1` of the `c_i`. -/
private theorem qParam_sub_one_eq_mul_den_periodSpan (η : Bool) :
    ∃ τ f : ℤ, qParam - 1 =
      (τ : RatFunc ℚ) * qParam ^ f * (qParam ^ (if η then (1 : ℤ) else -1) - 1) := by
  have hq := qParam_ne_zero
  cases η
  · refine ⟨-1, 1, ?_⟩
    simp only [Bool.false_eq_true, ite_false, zpow_neg_one, zpow_one, Int.cast_neg,
      Int.cast_one]
    field_simp
    ring
  · refine ⟨1, 0, ?_⟩
    simp only [ite_true, zpow_one, zpow_zero, Int.cast_one, one_mul]

/-- `(q - 1) (-q^(ηm+ℓ)) c_i(q^η)` is a signed power of `q`. -/
private theorem exists_int_mul_qParam_zpow_twCoef_periodSpan (η : Bool) (r s : ℕ) (ℓ : ℤ)
    (i : Fin 4) :
    ∃ τ f : ℤ, (qParam - 1) *
        (-(qParam ^ ((if η then 1 else -1) * ((r : ℤ) * s) + ℓ)) * twCoef η r s i) =
      (τ : RatFunc ℚ) * qParam ^ f := by
  have hq := qParam_ne_zero
  obtain ⟨σ, hσ⟩ : ∃ σ : ℤ, (![1, -1, -1, 1] i : RatFunc ℚ) = (σ : RatFunc ℚ) := by
    fin_cases i
    exacts [⟨1, by simp⟩, ⟨-1, by simp⟩, ⟨-1, by simp⟩, ⟨1, by simp⟩]
  obtain ⟨τ, f, hτ⟩ := qParam_sub_one_eq_mul_den_periodSpan η
  have hm := twCoef_mul η r s i
  rw [hσ] at hm
  refine ⟨-(τ * σ), f + ((if η then 1 else -1) * ((r : ℤ) * s) + ℓ) +
    (if η then 1 else -1) * (twLambda r s i - (r : ℤ) * s + (![1, 0, 0, 1] i : ℤ)), ?_⟩
  have hp : qParam ^ (f + ((if η then 1 else -1) * ((r : ℤ) * s) + ℓ) +
      (if η then 1 else -1) * (twLambda r s i - (r : ℤ) * s + (![1, 0, 0, 1] i : ℤ))) =
      qParam ^ f * qParam ^ ((if η then 1 else -1) * ((r : ℤ) * s) + ℓ) *
        qParam ^ ((if η then 1 else -1) *
          (twLambda r s i - (r : ℤ) * s + (![1, 0, 0, 1] i : ℤ))) := by
    rw [zpow_add₀ hq, zpow_add₀ hq]
  rw [hτ, hp]
  push_cast
  linear_combination (-((τ : RatFunc ℚ) * qParam ^ f *
    qParam ^ ((if η then 1 else -1) * ((r : ℤ) * s) + ℓ))) * hm

/-- The value of a constant coefficient `τ t^(4k)`. -/
private theorem evalAtField_C_int_mul_X_pow_periodSpan (n : ℤ) (τ : ℤ) (k : ℕ) :
    evalAtField n (C (C τ * X ^ (4 * k)) : Coeff) = (τ : RatFunc ℚ) * qParam ^ k := by
  rw [evalAtField, coe_eval₂RingHom, eval₂_C, coe_eval₂RingHom, eval₂_mul, eval₂_C, eval₂_pow,
    eval₂_X, qParam, pow_mul, eq_intCast]

/-- The value of the clearing coefficient `t^(4E) (t⁴ - 1)`. -/
private theorem evalAtField_clearing_periodSpan (n : ℤ) (E : ℕ) :
    evalAtField n (C (X ^ (4 * E) * (X ^ 4 - 1)) : Coeff) = qParam ^ E * (qParam - 1) := by
  rw [evalAtField, coe_eval₂RingHom, eval₂_C, coe_eval₂RingHom, eval₂_mul, eval₂_sub, eval₂_pow,
    eval₂_pow, eval₂_X, eval₂_one, qParam, pow_mul]

/-- The value of `t^(4d) (t^(4d) M²)` at the colour `n` is `q^d q^(n+d)`. -/
private theorem evalAtField_window_var_periodSpan (n : ℤ) (d : ℕ) :
    evalAtField n (C (X ^ (4 * d)) * (C (X ^ (4 * d)) * X ^ 2) : Coeff) =
      qParam ^ d * qParam ^ (n + (d : ℤ)) := by
  have hn : ((RatFunc.X : RatFunc ℚ) ^ (2 * n)) ^ 2 = qParam ^ n := by
    rw [qParam_zpow_eq_ratFuncX_zpow, ← zpow_natCast, ← zpow_mul]
    congr 1
    push_cast
    ring
  rw [evalAtField, coe_eval₂RingHom, eval₂_mul, eval₂_mul, eval₂_C, eval₂_pow, eval₂_X,
    coe_eval₂RingHom, eval₂_pow, eval₂_X, hn, zpow_add₀ qParam_ne_zero, zpow_natCast, qParam,
    pow_mul]
  ring

/-- `P_a F ∈ ∑_c 𝔻 G_c^{(ℓ)}` on a tail, for every companion sign and every twist. -/
theorem twQ_transfer_mem_periodSpan (η : Bool) (r s : ℕ) (ℓ : ℤ) :
    ∃ δ : Coeff, δ ≠ 0 ∧ ∃ (S : Finset ℤ) (D : ℤ → RecOp) (n₀ : ℤ), ∀ n : ℤ, n₀ ≤ n →
      evalAtField n δ *
          opApplyField (twTransferOp (twIndex η r s ℓ)) (twReducedEven η r s ℓ) n =
        ∑ c ∈ S, opApplyField (D c) (twPeriod ℓ c) n := by
  have hq := qParam_ne_zero
  choose τ f hτ using fun i ↦ exists_int_mul_qParam_zpow_twCoef_periodSpan η r s ℓ i
  obtain ⟨E, hE⟩ : ∃ E : ℕ, ∀ i, 0 ≤ (E : ℤ) + f i := by
    refine ⟨∑ i, (f i).natAbs, fun i ↦ ?_⟩
    have h1 : (f i).natAbs ≤ ∑ i, (f i).natAbs :=
      Finset.single_le_sum (f := fun i ↦ (f i).natAbs) (fun _ _ ↦ Nat.zero_le _)
        (Finset.mem_univ i)
    omega
  obtain ⟨K, hK⟩ : ∃ K : Fin 4 → Coeff, ∀ (n : ℤ) (i : Fin 4), evalAtField n (K i) =
      (τ i : RatFunc ℚ) * qParam ^ ((E : ℤ) + f i).toNat *
        (qParam ^ twWindow (twIndex η r s ℓ) *
          qParam ^ (n + (twWindow (twIndex η r s ℓ) : ℤ))) ^ ((twIndex η r s ℓ).natAbs + 1) :=
    ⟨fun i ↦ C (C (τ i) * X ^ (4 * ((E : ℤ) + f i).toNat)) *
      (C (X ^ (4 * twWindow (twIndex η r s ℓ))) *
        (C (X ^ (4 * twWindow (twIndex η r s ℓ))) * X ^ 2)) ^ ((twIndex η r s ℓ).natAbs + 1),
      fun n i ↦ by
        rw [map_mul, map_pow, evalAtField_C_int_mul_X_pow_periodSpan,
          evalAtField_window_var_periodSpan]⟩
  obtain ⟨idx, hidx⟩ : ∃ idx : Fin 4 ⊕ Fin 4 → ℤ,
      idx = Sum.elim (twExp η r s ℓ) fun i ↦ twExp η r s ℓ i - 1 := ⟨_, rfl⟩
  obtain ⟨Op, hOp⟩ : ∃ Op : Fin 4 ⊕ Fin 4 → RecOp,
      Op = Sum.elim (fun i ↦ C (K i) * twWeightOp (twWindow (twIndex η r s ℓ)) 0)
        fun i ↦ C (-K i) * twWeightOp (twWindow (twIndex η r s ℓ)) 1 := ⟨_, rfl⟩
  refine ⟨C (X ^ (4 * E) * (X ^ 4 - 1)), ?_, Finset.univ.image idx,
    fun c ↦ ∑ x ∈ Finset.univ.filter (fun x ↦ idx x = c), Op x, 1, fun n hn ↦ ?_⟩
  · intro h0
    have h1 := congrArg (fun p : ℤ[X] ↦ p.eval 2) (C_eq_zero.mp h0)
    simp only [eval_mul, eval_pow, eval_X, eval_sub, eval_one, eval_zero, mul_eq_zero,
      pow_eq_zero_iff', OfNat.ofNat_ne_zero, false_and, false_or] at h1
    norm_num at h1
  · have hKc : ∀ i, evalAtField n (K i) =
        evalAtField n (C (X ^ (4 * E) * (X ^ 4 - 1)) : Coeff) *
          (-(qParam ^ ((if η then 1 else -1) * ((r : ℤ) * s) + ℓ)) *
            (qParam ^ twWindow (twIndex η r s ℓ) *
              qParam ^ (n + (twWindow (twIndex η r s ℓ) : ℤ))) ^
                ((twIndex η r s ℓ).natAbs + 1)) * twCoef η r s i := fun i ↦ by
      have hpow : qParam ^ ((E : ℤ) + f i).toNat = qParam ^ E * qParam ^ f i := by
        rw [← zpow_natCast, Int.toNat_of_nonneg (hE i), zpow_add₀ hq, zpow_natCast]
      rw [hK, evalAtField_clearing_periodSpan, hpow]
      linear_combination (-(qParam ^ E * (qParam ^ twWindow (twIndex η r s ℓ) *
        qParam ^ (n + (twWindow (twIndex η r s ℓ) : ℤ))) ^
          ((twIndex η r s ℓ).natAbs + 1))) * hτ i
    refine Eq.trans ?_ ((sum_opApplyField_fiberwise_periodSpan idx Op (twPeriod ℓ) n).trans
      (Fintype.sum_sum_type _)).symm
    rw [hidx, hOp, twQ_gaussForcing η r s ℓ hn]
    simp only [Sum.elim_inl, Sum.elim_inr, opApplyField_C_mul_left]
    simp only [map_neg, hKc]
    rw [← Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    ring

/-- The transfer package for the selection: `P_a` is a nonzero operator of order `twWindow a`
and `P_a F` lies in the module of the Gaussian periods. -/
theorem twQ_transfer_main (η : Bool) (r s : ℕ) (ℓ : ℤ) :
    twTransferOp (twIndex η r s ℓ) ≠ 0 ∧
      (twTransferOp (twIndex η r s ℓ)).natDegree = twWindow (twIndex η r s ℓ) ∧
      ∃ δ : Coeff, δ ≠ 0 ∧ ∃ (S : Finset ℤ) (D : ℤ → RecOp) (n₀ : ℤ), ∀ n : ℤ, n₀ ≤ n →
        evalAtField n δ *
            opApplyField (twTransferOp (twIndex η r s ℓ)) (twReducedEven η r s ℓ) n =
          ∑ c ∈ S, opApplyField (D c) (twPeriod ℓ c) n :=
  ⟨twTransferOp_ne_zero _, natDegree_twTransferOp _, twQ_transfer_mem_periodSpan η r s ℓ⟩

end AJConjecture
