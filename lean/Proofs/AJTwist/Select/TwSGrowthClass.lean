import Mathlib
import AJConjecture.QAlgOpApplyFieldBasic
import AJConjecture.QAlgOpApplyFieldOreMul
import AJConjecture.QAlgEvalAtFieldZeros

/-!
# Growth classes of sequences: the submodules of the relative forcing lemma

Source: Section 6 of the revision-5 manuscript (`selection.tex`), the left `𝔻`-submodules
`𝒰 ⊂ 𝒮` of sequences on positive tails modulo eventual equality.

A *growth class* is a predicate `U` on sequences `ℤ → ℚ(t)` that contains the sequences vanishing
on a tail and is closed under subtraction, under multiplication by the Laurent monomials
`t^i M^j` evaluated at `M = t^(2n)` (`i, j ∈ ℤ`), and under the shift `n ↦ n + 1`. Such a class is
closed under the action of every recurrence operator (`TwsGrowthClass.opApplyField`), so the
closure of the modules of Section 6 "under the Ore operations" is proved once.

* `TwsSat U` is the saturation of `U`: `g ∈ TwsSat U` iff `κ(t, t^(2n)) g(n)` is in `U` for a
  nonzero coefficient `κ`. It is the `ℚ(t, M)`-span of `U`: a growth class closed under division
  by nonzero coefficients (`TwsGrowthClass.sat`, `TwsSat.of_coeff_mul`).
* `TwsInSpan G g`: on a tail, a nonzero coefficient multiple of `g` is a finite sum of images of
  the sequences `G c`, `c ∈ ℤ`, under recurrence operators: `g ∈ ∑_c 𝔻 G_c` (eq. (finite-U)).
-/

open Polynomial

noncomputable section

namespace AJConjecture

/-- A growth class: a set of sequences `ℤ → ℚ(t)` containing the sequences that vanish on a tail,
closed under subtraction, under multiplication by `t^i M^j` at `M = t^(2n)` (`i, j ∈ ℤ`) and under
the shift. -/
structure TwsGrowthClass (U : (ℤ → RatFunc ℚ) → Prop) : Prop where
  /-- Sequences vanishing on a tail belong to the class. -/
  zero_tail : ∀ {g : ℤ → RatFunc ℚ} {n₀ : ℤ}, (∀ n : ℤ, n₀ ≤ n → g n = 0) → U g
  /-- The class is closed under subtraction. -/
  sub : ∀ {g₁ g₂ : ℤ → RatFunc ℚ}, U g₁ → U g₂ → U fun n ↦ g₁ n - g₂ n
  /-- The class is closed under multiplication by `t^i M^j`, `M = t^(2n)`. -/
  monomial : ∀ {g : ℤ → RatFunc ℚ} (i j : ℤ), U g →
    U fun n ↦ (RatFunc.X : RatFunc ℚ) ^ (i + 2 * n * j) * g n
  /-- The class is closed under the shift of the colour. -/
  shift : ∀ {g : ℤ → RatFunc ℚ}, U g → U fun n ↦ g (n + 1)

/-- The saturation of a class of sequences: `g` belongs to it when `κ(t, t^(2n)) g(n)` belongs to
`U` for some nonzero coefficient `κ`. -/
def TwsSat (U : (ℤ → RatFunc ℚ) → Prop) (g : ℤ → RatFunc ℚ) : Prop :=
  ∃ κ : Coeff, κ ≠ 0 ∧ U fun n ↦ evalAtField n κ * g n

/-- On a tail, a nonzero coefficient multiple of `g` is a finite sum of images of the sequences
`G c` under recurrence operators: `g` lies in the left module generated by the `G c`. -/
def TwsInSpan (G : ℤ → ℤ → RatFunc ℚ) (g : ℤ → RatFunc ℚ) : Prop :=
  ∃ δ : Coeff, δ ≠ 0 ∧ ∃ (S : Finset ℤ) (D : ℤ → RecOp) (n₀ : ℤ), ∀ n : ℤ, n₀ ≤ n →
    evalAtField n δ * g n = ∑ c ∈ S, opApplyField (D c) (G c) n

/-- A class of sequences contains every sequence equal to one of its members. -/
private theorem of_forall_eq_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} {g₁ g₂ : ℤ → RatFunc ℚ}
    (h : U g₁) (heq : ∀ n : ℤ, g₁ n = g₂ n) : U g₂ :=
  funext heq ▸ h

/-- A growth class contains the zero sequence. -/
private theorem zero_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U) :
    U fun _ ↦ 0 :=
  hU.zero_tail (n₀ := 0) fun _ _ ↦ rfl

/-- A growth class is closed under addition. -/
private theorem add_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {g₁ g₂ : ℤ → RatFunc ℚ} (h₁ : U g₁) (h₂ : U g₂) : U fun n ↦ g₁ n + g₂ n :=
  of_forall_eq_twsGrowth (hU.sub h₁ (hU.sub (zero_twsGrowth hU) h₂)) fun n ↦ by
    rw [zero_sub, sub_neg_eq_add]

/-- A growth class is closed under finite sums. -/
private theorem sum_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {ι : Type*} (S : Finset ι) {G : ι → ℤ → RatFunc ℚ} (hG : ∀ c ∈ S, U (G c)) :
    U fun n ↦ ∑ c ∈ S, G c n := by
  classical
  induction S using Finset.induction_on with
  | empty => exact of_forall_eq_twsGrowth (zero_twsGrowth hU) fun n ↦ by rw [Finset.sum_empty]
  | insert a S ha ih =>
    refine of_forall_eq_twsGrowth (add_twsGrowth hU (hG a (Finset.mem_insert_self a S))
      (ih fun c hc ↦ hG c (Finset.mem_insert_of_mem hc))) fun n ↦ ?_
    rw [Finset.sum_insert ha]

/-- A growth class is closed under multiplication by integers. -/
private theorem intCast_mul_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    (z : ℤ) {g : ℤ → RatFunc ℚ} (h : U g) : U fun n ↦ (z : RatFunc ℚ) * g n := by
  induction z using Int.induction_on with
  | zero =>
    exact of_forall_eq_twsGrowth (zero_twsGrowth hU) fun n ↦ by rw [Int.cast_zero, zero_mul]
  | succ k ih =>
    exact of_forall_eq_twsGrowth (add_twsGrowth hU ih h) fun n ↦ by
      push_cast
      ring
  | pred k ih =>
    exact of_forall_eq_twsGrowth (hU.sub ih h) fun n ↦ by
      push_cast
      ring

/-- A growth class is closed under multiplication by polynomials in `t`. -/
private theorem C_mul_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    (a : ℤ[X]) : ∀ {g : ℤ → RatFunc ℚ}, U g → U fun n ↦ evalAtField n (C a) * g n := by
  induction a using Polynomial.induction_on with
  | C z =>
    intro g h
    exact of_forall_eq_twsGrowth (intCast_mul_twsGrowth hU z h) fun n ↦ by
      simp [evalAtField]
  | add p q hp hq =>
    intro g h
    exact of_forall_eq_twsGrowth (add_twsGrowth hU (hp h) (hq h)) fun n ↦ by
      rw [C_add, map_add, add_mul]
  | monomial k a ih =>
    intro g h
    refine of_forall_eq_twsGrowth (ih (hU.monomial 1 0 h)) fun n ↦ ?_
    have hE : evalAtField n (C (C a * X ^ (k + 1))) =
        evalAtField n (C (C a * X ^ k)) * RatFunc.X := by
      rw [pow_succ, ← mul_assoc, C_mul, map_mul]
      congr 1
      simp [evalAtField]
    rw [hE, mul_zero, add_zero, zpow_one, mul_assoc]

/-- A growth class is closed under multiplication by coefficients. -/
private theorem coeff_mul_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    (c : Coeff) : ∀ {g : ℤ → RatFunc ℚ}, U g → U fun n ↦ evalAtField n c * g n := by
  induction c using Polynomial.induction_on with
  | C a => exact fun h ↦ C_mul_twsGrowth hU a h
  | add p q hp hq =>
    intro g h
    exact of_forall_eq_twsGrowth (add_twsGrowth hU (hp h) (hq h)) fun n ↦ by
      rw [map_add, add_mul]
  | monomial k a ih =>
    intro g h
    refine of_forall_eq_twsGrowth (ih (hU.monomial 0 1 h)) fun n ↦ ?_
    have hE : evalAtField n (C a * X ^ (k + 1)) =
        evalAtField n (C a * X ^ k) * RatFunc.X ^ (2 * n) := by
      rw [pow_succ, ← mul_assoc, map_mul]
      congr 1
      simp [evalAtField]
    rw [hE, zero_add, mul_one, mul_assoc]

/-- A growth class is closed under iterated shifts. -/
private theorem iterate_shift_twsGrowth {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {g : ℤ → RatFunc ℚ} (h : U g) (i : ℕ) : U fun n ↦ g (n + i) := by
  induction i with
  | zero => exact of_forall_eq_twsGrowth h fun n ↦ by rw [Nat.cast_zero, add_zero]
  | succ i ih =>
    exact of_forall_eq_twsGrowth (hU.shift ih) fun n ↦ by rw [Nat.cast_succ, add_right_comm,
      add_assoc]

/-- A growth class does not distinguish sequences that agree on a tail. -/
theorem TwsGrowthClass.congr_tail {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {g₁ g₂ : ℤ → RatFunc ℚ} (h : U g₁) {n₀ : ℤ} (heq : ∀ n : ℤ, n₀ ≤ n → g₁ n = g₂ n) :
    U g₂ :=
  of_forall_eq_twsGrowth (hU.sub h (hU.zero_tail (g := fun n ↦ g₁ n - g₂ n) (n₀ := n₀)
    fun n hn ↦ by rw [heq n hn, sub_self])) fun n ↦ by rw [sub_sub_cancel]

/-- A growth class is closed under the action of recurrence operators. -/
theorem TwsGrowthClass.opApplyField {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {g : ℤ → RatFunc ℚ} (h : U g) (S : RecOp) : U fun n ↦ opApplyField S g n := by
  induction S using Polynomial.induction_on' with
  | add P Q hP hQ =>
    exact of_forall_eq_twsGrowth (add_twsGrowth hU hP hQ) fun n ↦ by rw [opApplyField_add_left]
  | monomial i c =>
    exact of_forall_eq_twsGrowth (coeff_mul_twsGrowth hU c (iterate_shift_twsGrowth hU h i))
      fun n ↦ by rw [opApplyField_monomial]

/-- The saturation of a growth class is a growth class. -/
theorem TwsGrowthClass.sat {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U) :
    TwsGrowthClass (TwsSat U) where
  zero_tail {g n₀} h := ⟨1, one_ne_zero, hU.zero_tail (n₀ := n₀) fun n hn ↦ by
    rw [h n hn, mul_zero]⟩
  sub {g₁ g₂} h₁ h₂ := by
    obtain ⟨κ₁, hκ₁, h₁⟩ := h₁
    obtain ⟨κ₂, hκ₂, h₂⟩ := h₂
    refine ⟨κ₁ * κ₂, mul_ne_zero hκ₁ hκ₂, of_forall_eq_twsGrowth
      (hU.sub (coeff_mul_twsGrowth hU κ₂ h₁) (coeff_mul_twsGrowth hU κ₁ h₂)) fun n ↦ ?_⟩
    rw [map_mul]
    ring
  monomial {g} i j h := by
    obtain ⟨κ, hκ, h⟩ := h
    exact ⟨κ, hκ, of_forall_eq_twsGrowth (hU.monomial i j h) fun n ↦ by ring⟩
  shift {g} h := by
    obtain ⟨κ, hκ, h⟩ := h
    exact ⟨coeffShift κ, (map_ne_zero_iff _ coeffShift_injective).mpr hκ,
      of_forall_eq_twsGrowth (hU.shift h) fun n ↦ by rw [evalAtField_coeffShift]⟩

set_option linter.unusedVariables false in
/-- The saturation of a growth class is closed under division by nonzero coefficients. -/
theorem TwsSat.of_coeff_mul {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {g : ℤ → RatFunc ℚ} {κ : Coeff} (hκ : κ ≠ 0)
    (h : TwsSat U fun n ↦ evalAtField n κ * g n) : TwsSat U g := by
  obtain ⟨κ', hκ', h⟩ := h
  exact ⟨κ' * κ, mul_ne_zero hκ' hκ, of_forall_eq_twsGrowth h fun n ↦ by rw [map_mul, mul_assoc]⟩

/-- A sequence in the left module generated by sequences of the saturated class belongs to the
saturated class. -/
theorem tws_sat_of_inSpan {U : (ℤ → RatFunc ℚ) → Prop} (hU : TwsGrowthClass U)
    {G : ℤ → ℤ → RatFunc ℚ} (hG : ∀ c : ℤ, TwsSat U (G c)) {g : ℤ → RatFunc ℚ}
    (h : TwsInSpan G g) : TwsSat U g := by
  obtain ⟨δ, hδ, S, D, n₀, heq⟩ := h
  have hsum : TwsSat U fun n ↦ ∑ c ∈ S, opApplyField (D c) (G c) n :=
    sum_twsGrowth hU.sat S fun c _ ↦ hU.sat.opApplyField (hG c) (D c)
  exact TwsSat.of_coeff_mul hU hδ (hU.sat.congr_tail hsum fun n hn ↦ (heq n hn).symm)

end AJConjecture
