open Polynomial
def pairQJetBlocks (m : ℕ) (i : Fin 3) : ℂ[X][X] :=
  pairQJetBlock (![X - 1, extraFactor, twistPoly m] i)
def pairQJetKappa₁ (m : ℕ) : ℂ[X] :=
  ((X ^ 2 - 1) ^ (2 * m + 3) * (X ^ 4 - 1) ^ (2 * m + 3) : ℤ[X]).map (Int.castRingHom ℂ)
def pairQJetKappa₂ (m : ℕ) : ℂ[X] :=
  ((famDet m (1 : ℤ)).comp (X ^ 2) * ((X ^ 2 + 1) ^ 2 * (X ^ 2 - 1)) : ℤ[X]).map
    (Int.castRingHom ℂ)
end

end AJConjecture
