noncomputable section

namespace AJConjecture

section
open Polynomial
def bandWord (i j : ℕ) (b : Bool) : BraidWord :=
  ((List.range (j - 1 - i)).map fun t ↦ (j - 1 - t, true)) ++ [(i, b)] ++
    ((List.range (j - 1 - i)).map fun t ↦ (i + 1 + t, false))
end

end AJConjecture
