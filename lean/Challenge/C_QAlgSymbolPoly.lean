noncomputable section

namespace AJConjecture

section
open Polynomial
def symbolZeta : ℤ[X][X] :=
  C X * X ^ 2 - C (X ^ 2 + 1) * X + C (X ^ 2 + X + 1)
def moebiusSubst (d : ℕ) (p : ℤ[X][X]) : ℤ[X][X] :=
  ∑ k ∈ Finset.range (d + 1), C (p.coeff k) * (C X * X + 1) ^ k * (C X + X) ^ (d - k)
end

end AJConjecture
