noncomputable section

namespace AJConjecture

section
open Polynomial
def ppiInvariants : Subalgebra ℂ PpiTorus :=
  AlgHom.equalizer (ppiSigma : PpiTorus →ₐ[ℂ] PpiTorus) (AlgHom.id ℂ PpiTorus)
def PpiEvenCoeff (P : PpiOp ℂ) : Prop :=
  ∀ (kl : ℤ × ℤ) (j : ℤ), Odd j → (P kl).coeff j = 0
def ppiTranSet (K : BraidKnot) : Set ppiInvariants :=
  {g | ∃ P : PpiOp ℂ, PpiAnnihilates P K ∧ ppiOpSigma P = P ∧ ppiEps P = (g : PpiTorus)}
def ppiSikoraSet (K : BraidKnot) : Set ppiInvariants :=
  {g | ∃ P : PpiOp ℂ, PpiAnnihilates P K ∧ PpiEvenCoeff P ∧ ppiOpSigma P = P ∧
    ppiEps P = (g : PpiTorus)}
def ppiAIdealSet (K : BraidKnot) : Set ppiInvariants :=
  {g | ∀ p ∈ eigenvalueSet K, ppiEval p (g : PpiTorus) = 0}
def PpiTranConjecture (K : BraidKnot) : Prop :=
  ((Ideal.span (ppiTranSet K)).radical : Set ppiInvariants) = ppiAIdealSet K
def PpiSikoraConjecture (K : BraidKnot) : Prop :=
  ((Ideal.span (ppiSikoraSet K)).radical : Set ppiInvariants) = ppiAIdealSet K
end

end AJConjecture
