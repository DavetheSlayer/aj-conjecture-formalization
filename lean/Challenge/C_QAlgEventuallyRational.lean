namespace AJConjecture

section
open Polynomial
def EventuallyRational (g : ℤ → RatFunc ℚ) : Prop :=
  ∃ a b : Coeff, b ≠ 0 ∧ ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n → evalAtField n b * g n = evalAtField n a
end

end AJConjecture
