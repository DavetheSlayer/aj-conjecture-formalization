def GeoChannelActionBranch (S : ℂ × ℂ → ℂ) (Ω : Set (ℂ × ℂ)) : Prop :=
  IsOpen Ω ∧ AnalyticOnNhd ℂ S Ω ∧ ∀ ℓ ∈ Ω,
    Complex.exp (fderiv ℂ S ℓ (1, 0)) =
        geoRatioX 1 (Complex.exp ℓ.1) (-1) (Complex.exp ℓ.2) ∧
