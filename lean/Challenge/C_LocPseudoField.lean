noncomputable section

namespace AJConjecture

section
open Polynomial
def OreIrreducible {K : Type*} [Field K] (τ : K →+* K) (P : K[X]) : Prop :=
  0 < P.natDegree ∧ ∀ S R : K[X], oreMul τ S R = P → R.natDegree = 0 ∨ S.natDegree = 0
end

end AJConjecture
