noncomputable section

namespace AJConjecture

section
def IsTorusPair (r s : ℕ) : Prop :=
  2 ≤ r ∧ r < s ∧ Nat.Coprime r s
def torusPairWord (r s : ℕ) : BraidWord :=
  (List.replicate s ((List.range (r - 1)).map fun i ↦ (i, true))).flatten
end

end AJConjecture
