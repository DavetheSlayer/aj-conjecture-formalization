noncomputable section

namespace AJConjecture

section
open Polynomial
def twP (k : ℤ) : ℤ[X][X] :=
  if 0 ≤ k then twistPoly k.toNat else twistPolyNeg (-k).toNat
def twBound (k₁ k₂ : ℤ) : ℤ[X][X] :=
  (X - 1) * twP k₁ * twP k₂
end

end AJConjecture
