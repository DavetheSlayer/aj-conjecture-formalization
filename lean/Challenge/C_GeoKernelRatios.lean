section
def geoRatioQ (a : ℕ) (s x Q z : ℂ) : ℂ :=
  z / x * (1 - s ^ 2 * Q) / ((1 - z * s ^ 2 * Q) * (1 - z * s ^ 2 * Q / x)) *
    (s ^ 2 * Q) ^ (-(4 * (a : ℤ)))
def geoRatioZ (s x Q z : ℂ) : ℂ :=
  x⁻¹ * Q * (1 - z) * (1 - z / x) / ((1 - z * s ^ 2 * Q) * (1 - z * s ^ 2 * Q / x))
def geoRatioX (s x Q z : ℂ) : ℂ :=
  x ^ 2 * s * z⁻¹ * Q⁻¹ * (1 - z * Q / x) / (1 - z / (s ^ 2 * x))
end

