open Polynomial
def twCramerOp (d : ℕ) (T : ℤ[X][X][X]) : RecOp :=
  ∑ k : Fin (d + 1),
    C ((twCoeff d (X ^ 4 : ℤ[X]) T (Fin.rev k)).comp (C (X ^ (4 * d)) * X ^ 2)) * X ^ (k : ℕ)
end

