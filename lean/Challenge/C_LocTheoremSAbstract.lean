open Polynomial
def diffAct {K E : Type*} [CommRing K] [CommRing E] (ev : K →+* E) (L : E →+* E) (P : K[X])
    (f : E) : E :=
  P.sum fun i a ↦ ev a * L^[i] f
end

end AJConjecture
