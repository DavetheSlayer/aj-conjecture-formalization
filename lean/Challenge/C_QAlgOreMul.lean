noncomputable section

namespace AJConjecture

section
open Polynomial
def oreMul {A : Type*} [Semiring A] (σ : A →+* A) (P Q : A[X]) : A[X] :=
  P.sum fun i a ↦ Q.sum fun k b ↦ monomial (i + k) (a * σ^[i] b)
end

end AJConjecture
