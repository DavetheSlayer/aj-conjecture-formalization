open Filter Topology
def geoNormMap (q : ℂ × ℂ) : ℂ × ℂ :=
  (q.2 / (-(q.1 * (1 + q.1))), ((1 - q.1) / (1 + q.1)) ^ 2)
def GeoPuncturedModel : Set (ℂ × ℂ) :=
  {q | q.2 ^ 2 = q.1 ^ 3 - q.1 ∧ q.2 ≠ 0}
end

