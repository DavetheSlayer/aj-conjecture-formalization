open MeasureTheory
def geoHypMeasure : Measure (ℂ × ℝ) :=
  (volume.restrict {p : ℂ × ℝ | 0 < p.2}).withDensity fun p ↦ ENNReal.ofReal (p.2 ^ (-3 : ℤ))
def geoIdealTetI : Set (ℂ × ℝ) :=
  {p | 0 ≤ p.1.re ∧ 0 ≤ p.1.im ∧ p.1.re + p.1.im ≤ 1 ∧ 0 < p.2 ∧
    1 / 2 ≤ ‖p.1 - (1 + Complex.I) / 2‖ ^ 2 + p.2 ^ 2}
end

end AJConjecture
